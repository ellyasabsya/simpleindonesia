import { Head, Link, router, usePage } from '@inertiajs/react';
import { ArrowLeft, CalendarDays, ChevronLeft, ChevronRight, Search } from 'lucide-react';
import { useEffect, useRef, useState } from 'react';
import { Card, type EventCard } from '@/components/landing/event-section';
import Footer from '@/components/landing/footer';
import PageBackground from '@/components/page-background';

type Paginated = {
    data: EventCard[];
    current_page: number;
    last_page: number;
    total: number;
    from: number | null;
    to: number | null;
};

type Category = { key: string; label: string; count: number };

type Props = {
    events: Paginated;
    categories: Category[];
    total: number;
    filters: { q: string; kategori: string };
};

const chip =
    'inline-flex items-center gap-2.5 rounded-full border border-white/70 bg-white/80 px-5 py-3 text-sm font-bold text-slate-700 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-900/60 dark:text-slate-100';

function visit(params: { q?: string; kategori?: string; page?: number }) {
    const query: Record<string, string | number> = {};
    if (params.q) query.q = params.q;
    if (params.kategori) query.kategori = params.kategori;
    if (params.page && params.page > 1) query.page = params.page;
    router.get('/events', query, { preserveState: true, preserveScroll: true, replace: true });
}

function pageList(current: number, last: number): (number | '…')[] {
    const set = new Set<number>([1, last, current - 1, current, current + 1]);
    const nums = [...set].filter((n) => n >= 1 && n <= last).sort((a, b) => a - b);
    const out: (number | '…')[] = [];
    nums.forEach((n, i) => {
        if (i > 0 && n - nums[i - 1] > 1) out.push('…');
        out.push(n);
    });
    return out;
}

function Pagination({ page, last, onGo }: { page: number; last: number; onGo: (n: number) => void }) {
    if (last <= 1) return null;
    const btn =
        'inline-flex h-10 min-w-10 items-center justify-center rounded-full px-3 text-sm font-bold transition disabled:cursor-not-allowed disabled:opacity-40';
    return (
        <nav aria-label="Paginasi" className="mt-10 flex flex-wrap items-center justify-center gap-2">
            <button
                disabled={page === 1}
                onClick={() => onGo(page - 1)}
                className={`${btn} border border-white/70 bg-white/80 text-slate-700 shadow-sm hover:bg-white dark:border-white/10 dark:bg-slate-900/60 dark:text-slate-100`}
                aria-label="Halaman sebelumnya"
            >
                <ChevronLeft className="h-4 w-4" />
            </button>
            {pageList(page, last).map((n, i) =>
                n === '…' ? (
                    <span key={`gap-${i}`} className="px-1 text-slate-400">…</span>
                ) : (
                    <button
                        key={n}
                        onClick={() => onGo(n)}
                        aria-current={n === page ? 'page' : undefined}
                        className={`${btn} ${
                            n === page
                                ? 'bg-gradient-to-r from-indigo-800 to-violet-600 text-white shadow-lg shadow-indigo-900/30'
                                : 'border border-white/70 bg-white/80 text-slate-700 shadow-sm hover:bg-white dark:border-white/10 dark:bg-slate-900/60 dark:text-slate-100'
                        }`}
                    >
                        {n}
                    </button>
                ),
            )}
            <button
                disabled={page === last}
                onClick={() => onGo(page + 1)}
                className={`${btn} border border-white/70 bg-white/80 text-slate-700 shadow-sm hover:bg-white dark:border-white/10 dark:bg-slate-900/60 dark:text-slate-100`}
                aria-label="Halaman berikutnya"
            >
                <ChevronRight className="h-4 w-4" />
            </button>
        </nav>
    );
}

export default function Events() {
    const { events, categories = [], total = 0, filters } = usePage<Props>().props;
    const [q, setQ] = useState(filters.q ?? '');
    const first = useRef(true);

    // Pencarian diproses di server dengan jeda singkat saat mengetik
    useEffect(() => {
        if (first.current) {
            first.current = false;
            return;
        }
        const t = setTimeout(() => visit({ q, kategori: filters.kategori }), 350);
        return () => clearTimeout(t);
        // eslint-disable-next-line react-hooks/exhaustive-deps
    }, [q]);

    const pill = (active: boolean) =>
        `inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-bold transition ${
            active
                ? 'bg-gradient-to-r from-indigo-800 to-violet-600 text-white shadow-lg shadow-indigo-900/30'
                : 'bg-white/80 text-slate-700 shadow-sm hover:bg-white dark:bg-slate-900/60 dark:text-slate-100'
        }`;
    const count = (active: boolean) =>
        `rounded-full px-2 py-0.5 text-xs ${active ? 'bg-white/25 text-white' : 'bg-slate-100 text-slate-500 dark:bg-white/10 dark:text-slate-300'}`;

    return (
        <>
            <Head title="Semua Event - SIMPLE" />
            <div className="relative min-h-screen text-slate-900 transition-colors dark:text-white">
                <PageBackground />
                <header className="relative z-20 mx-auto flex max-w-7xl items-center justify-between px-6 py-5">
                    <Link href="/" className="flex items-center gap-3">
                        <span className="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-700 to-blue-600 text-lg font-extrabold text-white shadow-md">S</span>
                        <span className="text-2xl font-extrabold tracking-[0.25em] text-indigo-900 dark:text-white">SIMPLE</span>
                    </Link>
                    <Link href="/dashboard" className="rounded-full bg-indigo-900 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-indigo-900/30 transition hover:-translate-y-0.5 hover:bg-indigo-800">
                        Dashboard
                    </Link>
                </header>

                <div className="relative z-10">
                    <main className="mx-auto max-w-7xl px-6 pb-24 pt-4">
                        <Link
                            href="/"
                            className="group inline-flex items-center gap-2 rounded-full border border-white/70 bg-white/80 px-5 py-3 text-sm font-bold text-indigo-800 shadow-sm backdrop-blur transition hover:-translate-y-0.5 hover:shadow-md dark:border-white/10 dark:bg-slate-900/60 dark:text-white"
                        >
                            <ArrowLeft className="h-4 w-4 transition-transform duration-300 group-hover:-translate-x-1" />
                            Kembali
                        </Link>

                        <div className="mt-8">
                            <span className="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.3em] text-indigo-900 shadow-sm dark:bg-white/10 dark:text-white">
                                <span className="h-2 w-2 rounded-full bg-indigo-600 dark:bg-indigo-400" />
                                Jelajahi
                            </span>
                            <h1 className="mt-5 text-5xl font-black tracking-tight md:text-6xl">
                                Semua <span className="title-gradient">Event</span>
                            </h1>
                            <p className="mt-4 max-w-2xl text-base text-slate-600 md:text-lg dark:text-slate-300">
                                Jelajahi kegiatan dan event yang tersedia di SIMPLE.
                            </p>
                            <div className="mt-6 flex flex-wrap gap-3">
                                <span className={chip}>
                                    <CalendarDays className="h-5 w-5 text-orange-500" />
                                    {total} event
                                </span>
                            </div>
                        </div>

                        <div className="mt-8 rounded-3xl border border-white/70 bg-white/60 p-5 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-900/40">
                            <div className="relative">
                                <Search className="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" />
                                <input
                                    type="search"
                                    value={q}
                                    onChange={(e) => setQ(e.target.value)}
                                    placeholder="Cari event atau lokasi..."
                                    className="w-full rounded-xl border border-slate-200 bg-white/90 py-3.5 pl-12 pr-4 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 dark:border-white/10 dark:bg-slate-900/70 dark:text-white"
                                />
                            </div>
                            <div className="mt-4 flex flex-wrap gap-2">
                                <button onClick={() => visit({ q })} className={pill(!filters.kategori)}>
                                    Semua <span className={count(!filters.kategori)}>{total}</span>
                                </button>
                                {categories.map((c) => (
                                    <button key={c.key} onClick={() => visit({ q, kategori: c.key })} className={pill(filters.kategori === c.key)}>
                                        {c.label} <span className={count(filters.kategori === c.key)}>{c.count}</span>
                                    </button>
                                ))}
                            </div>
                        </div>

                        {events.data.length === 0 ? (
                            <p className="mt-10 rounded-2xl border border-dashed border-slate-300 py-14 text-center text-sm text-slate-500 dark:border-white/15 dark:text-slate-400">
                                Tidak ada event yang cocok.
                            </p>
                        ) : (
                            <>
                                <p className="mt-8 text-sm font-semibold text-slate-500 dark:text-slate-400">
                                    Menampilkan {events.from}–{events.to} dari {events.total} event
                                </p>
                                <div className="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                                    {events.data.map((e) => (
                                        <Card key={e.id} event={e} />
                                    ))}
                                </div>
                                <Pagination
                                    page={events.current_page}
                                    last={events.last_page}
                                    onGo={(n) => visit({ q, kategori: filters.kategori, page: n })}
                                />
                            </>
                        )}
                    </main>
                    <Footer />
                </div>
            </div>
        </>
    );
}
