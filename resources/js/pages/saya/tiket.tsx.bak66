import { Link } from '@inertiajs/react';
import { ArrowLeft, CalendarDays, MapPin, Ticket } from 'lucide-react';
import UserLayout from '@/components/user/user-layout';

type Row = { id: number; code: string; quantity: number; total_price: number; status: string; title: string | null; location: string | null; starts_at: string | null; tickets?: { code: string; holder_name: string; checked_in: boolean }[] };

const fmt = (d: string | null) => (d ? new Date(d).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : '-');
const rp = (n: number) => 'Rp ' + new Intl.NumberFormat('id-ID').format(n);

export default function Tiket({ rows = [] }: { rows?: Row[] }) {
    return (
        <UserLayout title="Tiket saya" hasPanel={false}>
            <div className="space-y-6">
                <Link href="/dashboard" className="inline-flex items-center gap-2 text-sm font-bold text-slate-500 hover:text-slate-800 dark:text-slate-300">
                    <ArrowLeft className="h-4 w-4" /> Kembali
                </Link>
                <div>
                    <h1 className="text-3xl font-extrabold">Tiket saya</h1>
                    <p className="mt-1 text-slate-500 dark:text-slate-300">Tiket yang sudah Anda beli.</p>
                </div>

                {rows.length === 0 ? (
                    <div className="rounded-3xl border-2 border-dashed border-slate-200 p-12 text-center dark:border-white/10">
                        <Ticket className="mx-auto h-10 w-10 text-slate-300" />
                        <p className="mt-3 font-bold">Belum ada tiket</p>
                        <p className="text-sm text-slate-500 dark:text-slate-300">Tiket yang Anda beli akan muncul di sini.</p>
                    </div>
                ) : (
                    <div className="grid gap-4 sm:grid-cols-2">
                        {rows.map((r) => (
                            <div key={r.id} className="rounded-3xl bg-white/80 p-5 shadow-sm dark:bg-white/5">
                                <div className="flex items-start gap-3">
                                    <span className="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 text-white shadow-md"><Ticket className="h-6 w-6" /></span>
                                    <div className="min-w-0 flex-1">
                                        <h2 className="truncate font-extrabold">{r.title ?? '(event dihapus)'}</h2>
                                        <p className="flex items-center gap-1.5 text-sm"><CalendarDays className="h-4 w-4" /> {fmt(r.starts_at)}</p>
                                        {r.location && <p className="flex items-center gap-1.5 text-sm"><MapPin className="h-4 w-4" /> {r.location}</p>}
                                    </div>
                                    <span className="shrink-0 rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-bold capitalize text-amber-800 dark:bg-amber-500/15 dark:text-amber-200">{r.status}</span>
                                </div>
                                {r.tickets && r.tickets.length > 0 && (
                                    <div className="mt-4 space-y-2">
                                        {r.tickets.map((t) => (
                                            <a key={t.code} href={`/tiket/${t.code}`} className="flex items-center justify-between gap-3 rounded-xl border border-slate-200 px-3 py-2 text-sm hover:bg-slate-50 dark:border-white/10 dark:hover:bg-white/5">
                                                <span className="truncate font-bold">{t.holder_name}</span>
                                                <span className="shrink-0 text-xs font-bold text-indigo-700 dark:text-indigo-300">{t.checked_in ? 'Sudah check-in' : 'Buka tiket & QR'}</span>
                                            </a>
                                        ))}
                                    </div>
                                )}
                                <div className="mt-4 flex items-center justify-between border-t border-dashed border-slate-200 pt-3 text-sm dark:border-white/10">
                                    <span className="font-mono font-bold tracking-wider">{r.code}</span>
                                    <span>{r.quantity} tiket · {rp(r.total_price)}</span>
                                </div>
                            </div>
                        ))}
                    </div>
                )}
            </div>
        </UserLayout>
    );
}
