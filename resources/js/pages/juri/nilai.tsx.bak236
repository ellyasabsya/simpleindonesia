import { Head, router, usePage } from '@inertiajs/react';
import { useEffect, useState } from 'react';

type Crit = { id: number; name: string; description: string | null; weight: number; max_score: number; group?: string | null };
type Part = { id: number; name: string; school: string | null; code?: string; code_tail?: string };
type Props = {
    token: string;
    judge: { name: string; active: boolean };
    event: { title: string };
    enabled: boolean;
    scale: number;
    criteria: Crit[];
    participants: Part[];
    scores: Record<string, Record<string, number>>;
};

const num = (n: number) => new Intl.NumberFormat('id-ID', { maximumFractionDigits: 2 }).format(n);
const byLevel = (max: number) => [5, 4, 3, 2, 1].map((k) => {
    const lo = (max * (k - 1)) / 5;
    const hi = (max * k) / 5;
    const vals = Array.from(new Set([1, 2, 3].map((n) => Math.round(lo + ((hi - lo) * n) / 3))));
    return { k, vals, range: `${k === 1 ? 1 : Math.round(lo) + 1} - ${Math.round(hi)}` };
});
const codeOf = (p: Part) => p.code || `ID-${p.id}`;
const tailOf = (p: Part) => String(p.code_tail ?? (codeOf(p).match(/(\d+)\s*$/)?.[1] ?? codeOf(p)));

const LV: Record<number, { chip: string; on: string; off: string }> = {
    5: { chip: 'bg-emerald-500', on: 'border-emerald-600 bg-emerald-500 text-white shadow-lg shadow-emerald-200', off: 'border-emerald-200 bg-emerald-50 text-emerald-800 hover:border-emerald-400' },
    4: { chip: 'bg-sky-500', on: 'border-sky-600 bg-sky-500 text-white shadow-lg shadow-sky-200', off: 'border-sky-200 bg-sky-50 text-sky-800 hover:border-sky-400' },
    3: { chip: 'bg-amber-500', on: 'border-amber-600 bg-amber-500 text-white shadow-lg shadow-amber-200', off: 'border-amber-200 bg-amber-50 text-amber-800 hover:border-amber-400' },
    2: { chip: 'bg-orange-500', on: 'border-orange-600 bg-orange-500 text-white shadow-lg shadow-orange-200', off: 'border-orange-200 bg-orange-50 text-orange-800 hover:border-orange-400' },
    1: { chip: 'bg-rose-500', on: 'border-rose-600 bg-rose-500 text-white shadow-lg shadow-rose-200', off: 'border-rose-200 bg-rose-50 text-rose-800 hover:border-rose-400' },
};

export default function JuriNilai({ token, judge, event, enabled, scale, criteria, participants, scores }: Props) {
    const page = usePage().props as any;
    const flash = page.flash ?? {};
    const errors = (page.errors ?? {}) as Record<string, string>;
    const [vals, setVals] = useState<Record<number, Record<number, number | null>>>(() => {
        const o: Record<number, Record<number, number | null>> = {};
        participants.forEach((p) => {
            o[p.id] = {};
            criteria.forEach((c) => { const v = scores?.[p.id]?.[c.id]; o[p.id][c.id] = v === undefined ? null : v; });
        });
        try {
            const raw = typeof window !== 'undefined' ? window.localStorage.getItem('juri-draft-' + token) : null;
            const d = raw ? JSON.parse(raw) : null;
            if (d) {
                participants.forEach((p) => {
                    if (scores?.[p.id]) return;
                    criteria.forEach((c) => { const v = d?.[p.id]?.[c.id]; if (typeof v === 'number') o[p.id][c.id] = v; });
                });
            }
        } catch { /* draf rusak diabaikan */ }
        return o;
    });
    const [saving, setSaving] = useState<number | null>(null);
    const [openId, setOpenId] = useState<number | null>(null);
    const [confirmP, setConfirmP] = useState<Part | null>(null);
    const [codeIn, setCodeIn] = useState('');
    useEffect(() => {
        try { window.localStorage.setItem('juri-draft-' + token, JSON.stringify(vals)); } catch { /* abaikan */ }
    }, [vals, token]);

    const complete = (p: Part) => criteria.length > 0 && criteria.every((c) => vals[p.id]?.[c.id] !== null && vals[p.id]?.[c.id] !== undefined);
    const doneCount = participants.filter((p) => scores?.[p.id] && Object.keys(scores[p.id]).length >= criteria.length && criteria.length > 0).length;
    const pending = participants.length - doneCount;
    const pct = participants.length ? Math.round((doneCount / participants.length) * 100) : 0;
    const sum = (p: Part) => criteria.reduce((a, c) => a + (vals[p.id]?.[c.id] ?? 0), 0);
    const save = (p: Part) => {
        setSaving(p.id);
        router.post(`/juri/${token}`, { registration_id: p.id, scores: vals[p.id], confirm_code: codeIn } as any, { preserveScroll: true, onSuccess: () => { setConfirmP(null); setCodeIn(''); }, onFinish: () => setSaving(null) });
    };

    const blocked = !judge.active ? 'Akses Anda sebagai juri sedang dinonaktifkan oleh panitia.' : !enabled ? 'Penilaian belum dibuka atau sudah ditutup oleh panitia.' : null;
    const grid = { backgroundImage: 'linear-gradient(rgba(99,102,241,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(99,102,241,.08) 1px, transparent 1px)', backgroundSize: '32px 32px' };

    return (
        <div className="min-h-screen bg-gradient-to-br from-sky-100 via-indigo-50 to-violet-100 text-slate-900" style={grid}>
            <Head title={`Penilaian - ${event.title}`} />

            <nav className="sticky top-0 z-40 border-b border-white/70 bg-white/85 shadow-sm backdrop-blur">
                <div className="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-3">
                    <div className="flex items-center gap-2.5">
                        <div className="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-indigo-700 to-blue-500 text-lg font-black text-white shadow-md">S</div>
                        <div className="leading-tight">
                            <div className="text-lg font-black tracking-[0.25em] text-indigo-900">SIMPLE</div>
                            <div className="text-[10px] font-bold uppercase tracking-widest text-slate-500">Penilaian juri</div>
                        </div>
                    </div>
                    <div className="flex items-center gap-2">
                        <span className="hidden max-w-[11rem] truncate rounded-full bg-indigo-100 px-3 py-1.5 text-xs font-extrabold text-indigo-900 sm:inline">{judge.name}</span>
                        <span className="rounded-full bg-emerald-500 px-3 py-1.5 text-xs font-extrabold text-white shadow">{doneCount}/{participants.length} dinilai</span>
                    </div>
                </div>
            </nav>

            <div className="mx-auto max-w-3xl space-y-4 px-4 py-5">
                <header className="rounded-3xl bg-gradient-to-br from-slate-950 via-indigo-950 to-blue-900 p-6 text-white shadow-xl">
                    <div className="text-[11px] font-bold uppercase tracking-[0.25em] text-sky-300">Penilaian berlangsung</div>
                    <h1 className="mt-1 text-2xl font-black sm:text-3xl">{event.title}</h1>
                    <p className="mt-1 text-sm text-blue-100">Halo, {judge.name}. Nilai akhir maksimal {num(scale)}.</p>
                    <div className="mt-4 h-2.5 overflow-hidden rounded-full bg-white/15"><div className="h-full rounded-full bg-emerald-400 transition-all" style={{ width: `${pct}%` }} /></div>
                    <div className="mt-4 grid grid-cols-3 gap-2 text-center">
                        <div className="rounded-2xl bg-white/10 p-2.5"><div className="text-2xl font-black text-emerald-300">{doneCount}</div><div className="text-[10px] font-bold uppercase tracking-wider text-blue-100">Sudah dinilai</div></div>
                        <div className="rounded-2xl bg-white/10 p-2.5"><div className="text-2xl font-black text-amber-300">{pending}</div><div className="text-[10px] font-bold uppercase tracking-wider text-blue-100">Belum dinilai</div></div>
                        <div className="rounded-2xl bg-white/10 p-2.5"><div className="text-2xl font-black text-sky-300">{num(scale)}</div><div className="text-[10px] font-bold uppercase tracking-wider text-blue-100">Nilai maksimal</div></div>
                    </div>
                </header>

                <p className="rounded-2xl bg-white/70 px-4 py-2.5 text-xs font-semibold text-slate-600 ring-1 ring-indigo-100">Pilihan nilai tersimpan otomatis sebagai draf di perangkat ini. Nilai baru terkirim setelah Anda menekan Kirim nilai dan memasukkan kode registrasi.</p>
                {blocked && <p className="rounded-2xl bg-amber-100 p-4 text-sm font-bold text-amber-900 ring-1 ring-amber-300">{blocked}</p>}
                {flash.success && <p className="rounded-2xl bg-emerald-100 p-3 text-sm font-bold text-emerald-900 ring-1 ring-emerald-300">{flash.success}</p>}
                {errors.scores && !confirmP && <p className="rounded-2xl bg-rose-100 p-3 text-sm font-bold text-rose-800 ring-1 ring-rose-300">{errors.scores}</p>}
                {criteria.length === 0 && !blocked && <p className="rounded-2xl bg-amber-100 p-4 text-sm font-bold text-amber-900">Kriteria penilaian belum diatur panitia.</p>}

                {participants.map((p) => {
                    const isDone = !!scores?.[p.id] && Object.keys(scores[p.id]).length >= criteria.length && criteria.length > 0;
                    const open = openId === p.id;
                    const filled = criteria.filter((c) => vals[p.id]?.[c.id] !== null && vals[p.id]?.[c.id] !== undefined).length;
                    return (
                        <section key={p.id} className={`overflow-hidden rounded-3xl border-l-8 bg-white shadow-lg shadow-indigo-100 ${isDone ? 'border-emerald-500' : 'border-amber-400'} ${open ? 'ring-2 ring-indigo-500' : 'ring-1 ring-indigo-100'}`}>
                            <button type="button" onClick={() => setOpenId(open ? null : p.id)} className="flex w-full items-center justify-between gap-3 p-4 text-left sm:p-5">
                                <span className="min-w-0">
                                    <span className="mb-1.5 inline-block rounded-xl bg-gradient-to-r from-indigo-700 to-blue-600 px-3.5 py-1.5 text-xl font-black tracking-wider text-white shadow sm:text-2xl">{codeOf(p)}</span>
                                    <span className="block truncate text-lg font-extrabold">{p.name}</span>
                                    {p.school && <span className="block truncate text-xs font-semibold text-slate-500">{p.school}</span>}
                                </span>
                                <span className="flex shrink-0 flex-col items-end gap-1.5">
                                    <span className={`rounded-full px-3 py-1 text-xs font-extrabold ${isDone ? 'bg-emerald-500 text-white' : 'bg-amber-400 text-amber-950'}`}>{isDone ? 'Sudah dinilai' : 'Belum dinilai'}</span>
                                    <span className="text-[11px] font-bold text-indigo-600">{open ? 'Tutup ▲' : 'Buka ▼'}</span>
                                </span>
                            </button>

                            {open && !blocked && criteria.length > 0 && (
                                <div className="space-y-4 border-t border-indigo-100 bg-indigo-50/40 p-4 sm:p-5">
                                    <div className="rounded-2xl bg-gradient-to-r from-indigo-600 via-blue-600 to-cyan-500 p-4 text-center text-white shadow-lg">
                                        <div className="text-[11px] font-bold uppercase tracking-[0.25em] text-sky-100">Anda sedang menilai</div>
                                        <div className="text-4xl font-black tracking-wider">{codeOf(p)}</div>
                                        <div className="text-sm font-bold">{p.name}</div>
                                    </div>

                                    {criteria.map((c, idx) => {
                                        const cur = vals[p.id]?.[c.id];
                                        return (
                                            <div key={c.id}>
                                                {c.group && c.group !== criteria[idx - 1]?.group && <div className="mb-2 rounded-lg bg-indigo-900 px-3 py-1.5 text-xs font-extrabold uppercase tracking-wider text-white">{c.group}</div>}
                                                <div className="rounded-2xl bg-white p-3 shadow-sm ring-1 ring-slate-200">
                                                    <div className="flex items-start justify-between gap-2">
                                                        <div>
                                                            <div className="text-base font-black text-slate-900">{c.name}</div>
                                                            <div className="mt-1 flex flex-wrap gap-1.5">
                                                                <span className="rounded-full bg-indigo-100 px-2.5 py-0.5 text-[11px] font-extrabold text-indigo-800">Bobot {c.weight}%</span>
                                                                <span className="rounded-full bg-sky-100 px-2.5 py-0.5 text-[11px] font-extrabold text-sky-800">Skala 0 - {num(c.max_score)}</span>
                                                            </div>
                                                        </div>
                                                        <span className={`shrink-0 rounded-xl px-3 py-1.5 text-lg font-black ${cur === null || cur === undefined ? 'bg-slate-100 text-slate-400' : 'bg-emerald-500 text-white'}`}>{cur === null || cur === undefined ? '-' : num(cur)}</span>
                                                    </div>
                                                    {c.description && <p className="mt-1.5 text-xs text-slate-500">{c.description}</p>}
                                                    <div className="mt-3 space-y-2">
                                                        {byLevel(c.max_score).map((lv) => (
                                                            <div key={lv.k} className="flex items-stretch gap-2">
                                                                <div className={`flex w-[4.75rem] shrink-0 flex-col items-center justify-center rounded-xl px-1 py-1 text-center text-[11px] font-black leading-tight text-white ${LV[lv.k].chip}`}>Level {lv.k}<span className="font-semibold opacity-90">{lv.range}</span></div>
                                                                <div className="grid flex-1 grid-cols-3 gap-2">
                                                                    {lv.vals.map((v) => {
                                                                        const on = cur === v;
                                                                        return (
                                                                            <button key={v} type="button" onClick={() => setVals({ ...vals, [p.id]: { ...vals[p.id], [c.id]: v } })} className={`rounded-xl border-2 py-3 text-lg font-black transition active:scale-95 ${on ? LV[lv.k].on : LV[lv.k].off}`}>{num(v)}</button>
                                                                        );
                                                                    })}
                                                                </div>
                                                            </div>
                                                        ))}
                                                    </div>
                                                </div>
                                            </div>
                                        );
                                    })}

                                    <div className="sticky bottom-3 z-30 flex items-center justify-between gap-3 rounded-2xl bg-gradient-to-r from-slate-950 to-indigo-900 p-3 text-white shadow-2xl">
                                        <div className="leading-tight">
                                            <div className="text-[10px] font-bold uppercase tracking-widest text-sky-300">Total nilai · {filled}/{criteria.length} terisi</div>
                                            <div className="text-2xl font-black">{num(sum(p))} <span className="text-sm font-semibold text-blue-200">/ {num(scale)}</span></div>
                                        </div>
                                        <button type="button" disabled={!complete(p) || saving === p.id} onClick={() => { setCodeIn(''); setConfirmP(p); }} className="rounded-xl bg-emerald-400 px-5 py-3 text-sm font-black text-indigo-950 shadow-lg transition hover:bg-emerald-300 disabled:opacity-40">{saving === p.id ? 'Mengirim...' : isDone ? 'Kirim ulang nilai' : 'Kirim nilai'}</button>
                                    </div>
                                </div>
                            )}
                        </section>
                    );
                })}

                {confirmP && (
                    <div className="fixed inset-0 z-50 flex items-end justify-center bg-slate-950/70 p-4 backdrop-blur-sm sm:items-center">
                        <div className="w-full max-w-md overflow-hidden rounded-3xl bg-white shadow-2xl">
                            <div className="bg-gradient-to-r from-indigo-700 via-blue-600 to-cyan-500 p-5 text-center text-white">
                                <div className="text-[11px] font-bold uppercase tracking-[0.25em] text-sky-100">Konfirmasi pengiriman nilai</div>
                                <div className="mt-1 text-4xl font-black tracking-wider">{codeOf(confirmP)}</div>
                                <div className="text-base font-bold">{confirmP.name}</div>
                                {confirmP.school && <div className="text-xs text-sky-100">{confirmP.school}</div>}
                            </div>
                            <div className="space-y-4 p-5">
                                <div className="space-y-1.5 rounded-2xl bg-slate-50 p-3 text-sm ring-1 ring-slate-200">
                                    {criteria.map((c) => (
                                        <div key={c.id} className="flex justify-between"><span className="font-semibold">{c.name}</span><span className="font-black">{num(vals[confirmP.id]?.[c.id] ?? 0)}</span></div>
                                    ))}
                                    <div className="flex justify-between border-t border-slate-200 pt-1.5 text-base font-black text-indigo-900"><span>Total</span><span>{num(sum(confirmP))} / {num(scale)}</span></div>
                                </div>
                                <label className="block text-sm font-extrabold">
                                    Ketik angka terakhir dari kode registrasi di atas untuk mengirim nilai
                                    <input autoFocus inputMode="numeric" value={codeIn} onChange={(e) => setCodeIn(e.target.value)} placeholder="Angka terakhir kode" className="mt-2 w-full rounded-xl border-2 border-indigo-300 px-3 py-3 text-center text-2xl font-black tracking-widest focus:border-indigo-600 focus:outline-none" />
                                </label>
                                {errors.scores && <p className="rounded-xl bg-rose-100 p-2.5 text-sm font-bold text-rose-800">{errors.scores}</p>}
                                <div className="grid grid-cols-2 gap-2">
                                    <button type="button" onClick={() => { setConfirmP(null); setCodeIn(''); }} className="rounded-2xl border-2 border-slate-300 px-4 py-3 text-sm font-extrabold text-slate-700">Batal, periksa lagi</button>
                                    <button type="button" disabled={codeIn.trim().toUpperCase() !== tailOf(confirmP).toUpperCase() || saving === confirmP.id} onClick={() => save(confirmP)} className="rounded-2xl bg-emerald-500 px-4 py-3 text-sm font-black text-white shadow-lg disabled:opacity-40">{saving === confirmP.id ? 'Mengirim...' : 'Kirim final'}</button>
                                </div>
                            </div>
                        </div>
                    </div>
                )}

                {participants.length === 0 && <p className="rounded-2xl bg-white p-4 text-sm text-slate-600">Belum ada peserta terdaftar.</p>}
            </div>
        </div>
    );
}
