import { Head, router, usePage } from '@inertiajs/react';
import { useEffect, useState } from 'react';

type Crit = { id: number; name: string; description: string | null; weight: number; max_score: number; group?: string | null };
type Part = { id: number; name: string; school: string | null; code: string; code_tail: string };
type Props = {
    token: string;
    judge: { name: string; active: boolean };
    event: { title: string };
    enabled: boolean;
    scale: number;
    criteria: Crit[];
    participants: Part[];
    scores: Record<string, Record<string, number>>;
};

const num = (n: number) => new Intl.NumberFormat('id-ID', { maximumFractionDigits: 2 }).format(n);
const byLevel = (max: number) => [5, 4, 3, 2, 1].map((k) => {
    const lo = (max * (k - 1)) / 5;
    const hi = (max * k) / 5;
    const vals = Array.from(new Set([1, 2, 3].map((n) => Math.round(lo + ((hi - lo) * n) / 3))));
    return { k, vals, range: `${k === 1 ? 1 : Math.round(lo) + 1} - ${Math.round(hi)}` };
});

export default function JuriNilai({ token, judge, event, enabled, scale, criteria, participants, scores }: Props) {
    const page = usePage().props as any;
    const flash = page.flash ?? {};
    const errors = (page.errors ?? {}) as Record<string, string>;
    const [vals, setVals] = useState<Record<number, Record<number, number | null>>>(() => {
        const o: Record<number, Record<number, number | null>> = {};
        participants.forEach((p) => {
            o[p.id] = {};
            criteria.forEach((c) => { const v = scores?.[p.id]?.[c.id]; o[p.id][c.id] = v === undefined ? null : v; });
        });
        try {
            const raw = typeof window !== 'undefined' ? window.localStorage.getItem('juri-draft-' + token) : null;
            const d = raw ? JSON.parse(raw) : null;
            if (d) {
                participants.forEach((p) => {
                    if (scores?.[p.id]) return;
                    criteria.forEach((c) => { const v = d?.[p.id]?.[c.id]; if (typeof v === 'number') o[p.id][c.id] = v; });
                });
            }
        } catch { /* draf rusak diabaikan */ }
        return o;
    });
    const [saving, setSaving] = useState<number | null>(null);
    const [openId, setOpenId] = useState<number | null>(null);
    const [confirmP, setConfirmP] = useState<Part | null>(null);
    const [codeIn, setCodeIn] = useState('');
    useEffect(() => {
        try { window.localStorage.setItem('juri-draft-' + token, JSON.stringify(vals)); } catch { /* abaikan */ }
    }, [vals, token]);

    const complete = (p: Part) => criteria.length > 0 && criteria.every((c) => vals[p.id]?.[c.id] !== null && vals[p.id]?.[c.id] !== undefined);
    const doneCount = participants.filter((p) => scores?.[p.id] && Object.keys(scores[p.id]).length >= criteria.length).length;
    const sum = (p: Part) => criteria.reduce((a, c) => a + (vals[p.id]?.[c.id] ?? 0), 0);
    const save = (p: Part) => {
        setSaving(p.id);
        router.post(`/juri/${token}`, { registration_id: p.id, scores: vals[p.id], confirm_code: codeIn } as any, { preserveScroll: true, onSuccess: () => { setConfirmP(null); setCodeIn(''); }, onFinish: () => setSaving(null) });
    };

    const blocked = !judge.active ? 'Akses Anda sebagai juri sedang dinonaktifkan oleh panitia.' : !enabled ? 'Penilaian belum dibuka atau sudah ditutup oleh panitia.' : null;

    return (
        <div className="min-h-screen bg-slate-50 px-4 py-6 text-slate-900">
            <Head title={`Penilaian - ${event.title}`} />
            <div className="mx-auto max-w-2xl space-y-4">
                <header className="rounded-3xl bg-gradient-to-br from-indigo-800 to-violet-600 p-6 text-white shadow-lg">
                    <div className="text-[11px] font-bold uppercase tracking-[0.2em] text-blue-100">Penilaian juri</div>
                    <h1 className="mt-1 text-2xl font-extrabold">{event.title}</h1>
                    <p className="mt-1 text-sm text-blue-50">Halo, {judge.name}. {doneCount} dari {participants.length} peserta sudah Anda nilai. Nilai akhir maksimal {num(scale)}.</p>
                </header>

                {blocked && <p className="rounded-2xl bg-amber-50 p-4 text-sm font-semibold text-amber-800">{blocked}</p>}
                <p className="px-1 text-xs text-slate-500">Pilihan nilai tersimpan otomatis sebagai draf di perangkat ini. Nilai baru terkirim setelah Anda menekan Kirim nilai dan memasukkan kode registrasi.</p>
                {flash.success && <p className="rounded-2xl bg-emerald-50 p-3 text-sm font-semibold text-emerald-800">{flash.success}</p>}
                {errors.scores && <p className="rounded-2xl bg-rose-50 p-3 text-sm font-semibold text-rose-700">{errors.scores}</p>}
                {criteria.length === 0 && !blocked && <p className="rounded-2xl bg-amber-50 p-4 text-sm font-semibold text-amber-800">Kriteria penilaian belum diatur panitia.</p>}

                {participants.map((p) => {
                    const isDone = scores?.[p.id] && Object.keys(scores[p.id]).length >= criteria.length && criteria.length > 0;
                    const open = openId === p.id;
                    return (
                        <section key={p.id} className="rounded-3xl bg-white p-5 shadow-sm">
                            <button type="button" onClick={() => setOpenId(open ? null : p.id)} className="flex w-full items-center justify-between gap-3 text-left">
                                <span>
                                    <span className="mb-1 inline-block rounded-lg bg-indigo-900 px-3 py-1 text-xl font-black tracking-wider text-white">{p.code}</span>
                                    <span className="block text-lg font-extrabold">{p.name}</span>
                                    {p.school && <span className="block text-xs text-slate-500">{p.school}</span>}
                                </span>
                                <span className={`shrink-0 rounded-full px-2.5 py-1 text-xs font-bold ${isDone ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600'}`}>{isDone ? 'Sudah dinilai' : 'Belum dinilai'}</span>
                            </button>
                            {open && !blocked && criteria.length > 0 && (
                                <div className="mt-4 space-y-5">
                                    <div className="rounded-2xl border-2 border-indigo-900 bg-indigo-50 p-3 text-center">
                                        <div className="text-[11px] font-bold uppercase tracking-widest text-indigo-700">Anda sedang menilai</div>
                                        <div className="text-3xl font-black tracking-wider text-indigo-900">{p.code}</div>
                                        <div className="text-sm font-bold">{p.name}</div>
                                    </div>
                                    {criteria.map((c, idx) => (
                                        <div key={c.id}>
                                            {c.group && c.group !== criteria[idx - 1]?.group && <div className="mb-2 mt-1 border-b border-slate-200 pb-1 text-xs font-extrabold uppercase tracking-wider text-indigo-700">{c.group}</div>}
                                            <div className="text-sm font-extrabold">{c.name} <span className="font-normal text-slate-500">(bobot {c.weight}%, skala 0 - {num(c.max_score)})</span></div>
                                            {c.description && <p className="mt-0.5 text-xs text-slate-500">{c.description}</p>}
                                            <div className="mt-2 space-y-2">
                                                {byLevel(c.max_score).map((lv) => (
                                                    <div key={lv.k} className="flex items-center gap-2">
                                                        <div className="w-16 shrink-0 text-[11px] font-bold leading-tight text-slate-500">Level {lv.k}<br />{lv.range}</div>
                                                        <div className="grid flex-1 grid-cols-3 gap-2">
                                                            {lv.vals.map((v) => {
                                                                const on = vals[p.id]?.[c.id] === v;
                                                                return (
                                                                    <button key={v} type="button" onClick={() => setVals({ ...vals, [p.id]: { ...vals[p.id], [c.id]: v } })} className={`rounded-xl border-2 py-2.5 text-base font-extrabold transition ${on ? 'border-indigo-600 bg-indigo-600 text-white' : 'border-slate-200 bg-white text-slate-700 hover:border-indigo-300'}`}>{num(v)}</button>
                                                                );
                                                            })}
                                                        </div>
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    ))}
                                    <div className="flex items-center justify-between rounded-xl bg-indigo-50 px-4 py-2.5 text-sm font-extrabold text-indigo-900"><span>Total nilai</span><span className="text-lg">{num(sum(p))} <span className="font-normal text-indigo-600">/ {num(scale)}</span></span></div>
                                    <button type="button" disabled={!complete(p) || saving === p.id} onClick={() => { setCodeIn(''); setConfirmP(p); }} className="w-full rounded-2xl bg-indigo-900 px-5 py-3 text-sm font-extrabold text-white hover:bg-indigo-800 disabled:opacity-50">{saving === p.id ? 'Mengirim...' : isDone ? 'Kirim ulang nilai' : 'Kirim nilai'}</button>
                                </div>
                            )}
                        </section>
                    );
                })}
                {confirmP && (
                    <div className="fixed inset-0 z-50 flex items-end justify-center bg-slate-900/60 p-4 sm:items-center">
                        <div className="w-full max-w-md space-y-4 rounded-3xl bg-white p-5 shadow-xl">
                            <div className="text-center">
                                <div className="text-[11px] font-bold uppercase tracking-widest text-slate-500">Konfirmasi pengiriman nilai</div>
                                <div className="mt-1 text-4xl font-black tracking-wider text-indigo-900">{confirmP.code}</div>
                                <div className="text-base font-bold">{confirmP.name}</div>
                                {confirmP.school && <div className="text-xs text-slate-500">{confirmP.school}</div>}
                            </div>
                            <div className="space-y-1 rounded-2xl bg-slate-50 p-3 text-sm">
                                {criteria.map((c) => (
                                    <div key={c.id} className="flex justify-between"><span>{c.name}</span><span className="font-extrabold">{num(vals[confirmP.id]?.[c.id] ?? 0)}</span></div>
                                ))}
                                <div className="flex justify-between border-t border-slate-200 pt-1 font-extrabold text-indigo-900"><span>Total</span><span>{num(sum(confirmP))} / {num(scale)}</span></div>
                            </div>
                            <label className="block text-sm font-bold">
                                Ketik angka terakhir dari kode registrasi di atas untuk mengirim nilai
                                <input autoFocus inputMode="numeric" value={codeIn} onChange={(e) => setCodeIn(e.target.value)} placeholder="Angka terakhir kode" className="mt-2 w-full rounded-xl border-2 border-slate-300 px-3 py-3 text-center text-2xl font-black tracking-widest focus:border-indigo-600 focus:outline-none" />
                            </label>
                            {errors.scores && <p className="rounded-xl bg-rose-50 p-2.5 text-sm font-semibold text-rose-700">{errors.scores}</p>}
                            <div className="grid grid-cols-2 gap-2">
                                <button type="button" onClick={() => { setConfirmP(null); setCodeIn(''); }} className="rounded-2xl border-2 border-slate-200 px-4 py-3 text-sm font-extrabold text-slate-700">Batal, periksa lagi</button>
                                <button type="button" disabled={codeIn.trim().toUpperCase() !== String(confirmP.code_tail).toUpperCase() || saving === confirmP.id} onClick={() => save(confirmP)} className="rounded-2xl bg-indigo-900 px-4 py-3 text-sm font-extrabold text-white disabled:opacity-40">{saving === confirmP.id ? 'Mengirim...' : 'Kirim final'}</button>
                            </div>
                        </div>
                    </div>
                )}
                {participants.length === 0 && <p className="rounded-2xl bg-white p-4 text-sm text-slate-600">Belum ada peserta terdaftar.</p>}
            </div>
        </div>
    );
}
