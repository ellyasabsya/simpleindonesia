import { Zap } from 'lucide-react';

type Item = { id: number; title: string; poster: string | null; ends: string };

export default function VotingIndex({ items }: { items: Item[] }) {
    return (
        <div className="min-h-screen bg-gradient-to-br from-[#050816] via-[#0a1030] to-[#1a0b3a] px-4 py-10 text-white">
            <div className="mx-auto max-w-5xl">
                <h1 className="flex items-center gap-3 text-3xl font-black tracking-widest uppercase"><Zap className="h-7 w-7 text-cyan-300" /> Semua Voting</h1>
                {items.length === 0 ? (
                    <p className="mt-10 rounded-3xl border border-white/10 bg-white/5 p-10 text-center text-slate-300">Belum ada voting yang dibuka.</p>
                ) : (
                    <div className="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                        {items.map((i) => (
                            <a key={i.id} href={`/voting/${i.id}`} className="group overflow-hidden rounded-3xl border border-white/10 bg-white/5 transition hover:border-cyan-300/50 hover:bg-white/10">
                                <div className="aspect-[4/3] bg-slate-900">{i.poster && <img src={i.poster} alt={i.title} className="h-full w-full object-cover transition group-hover:scale-105" />}</div>
                                <div className="p-5">
                                    <div className="font-extrabold">{i.title}</div>
                                    <div className="mt-1 text-xs text-slate-400">Berakhir {new Date(i.ends).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</div>
                                    <div className="mt-4 rounded-xl bg-gradient-to-r from-sky-500 to-violet-600 py-2 text-center text-xs font-extrabold tracking-widest uppercase">Masuk arena</div>
                                </div>
                            </a>
                        ))}
                    </div>
                )}
            </div>
        </div>
    );
}
