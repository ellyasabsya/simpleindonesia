import { router, usePage } from '@inertiajs/react';
import { AlertTriangle, CheckCircle2, CreditCard, Landmark, Loader2, PauseCircle, Ticket, Vote, Zap } from 'lucide-react';
import { useState } from 'react';
import AdminLayout from '@/components/admin/admin-layout';

type PaySettings = { pay_midtrans: boolean; pay_manual: boolean };
type Key = keyof PaySettings;

function Toggle({ on, onChange, label, disabled }: { on: boolean; onChange: (v: boolean) => void; label: string; disabled?: boolean }) {
    return (
        <button
            type="button"
            role="switch"
            aria-checked={on}
            aria-label={label}
            disabled={disabled}
            onClick={() => onChange(!on)}
            className={`relative inline-flex h-8 w-14 shrink-0 items-center rounded-full shadow-inner transition-colors duration-200 disabled:cursor-wait disabled:opacity-60 ${
                on ? 'bg-gradient-to-r from-indigo-500 to-violet-600' : 'bg-slate-300 dark:bg-white/20'
            }`}
        >
            <span
                className={`inline-block h-6 w-6 transform rounded-full bg-white shadow-md transition-transform duration-200 ${
                    on ? 'translate-x-7' : 'translate-x-1'
                }`}
            />
        </button>
    );
}

function Stat({ label, value, note, icon: Icon, tone }: { label: string; value: string; note: string; icon: typeof Zap; tone: string }) {
    return (
        <div className="rounded-3xl border border-slate-200 bg-white/80 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-white/5">
            <div className="flex items-start justify-between gap-3">
                <div className="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">{label}</div>
                <div className={`flex h-11 w-11 items-center justify-center rounded-2xl ${tone}`}>
                    <Icon className="h-5 w-5" />
                </div>
            </div>
            <div className="mt-5 text-4xl font-extrabold">{value}</div>
            <div className="mt-1 text-sm text-slate-500 dark:text-slate-400">{note}</div>
        </div>
    );
}

export default function AdminPengaturan({ settings, voting_open }: { settings: PaySettings; voting_open: boolean }) {
    const { errors } = usePage().props as { errors?: Record<string, string> };
    const [saving, setSaving] = useState(false);
    const [saved, setSaved] = useState(false);

    const save = (next: PaySettings) => {
        router.patch('/admin/pengaturan', next, {
            preserveScroll: true,
            onStart: () => {
                setSaving(true);
                setSaved(false);
            },
            onSuccess: () => {
                setSaved(true);
                setTimeout(() => setSaved(false), 2500);
            },
            onFinish: () => setSaving(false),
        });
    };

    const methods = [
        {
            key: 'pay_midtrans' as Key,
            title: 'Midtrans',
            subtitle: 'Pembayaran online',
            desc: 'Pembeli membayar lewat e-wallet, kartu, atau virtual account. Pembayaran terkonfirmasi otomatis.',
            icon: Zap,
            tag: 'Konfirmasi otomatis',
        },
        {
            key: 'pay_manual' as Key,
            title: 'Transfer manual',
            subtitle: 'Transfer ke rekening',
            desc: 'Pembeli transfer ke rekening, lalu admin mengecek dan mengonfirmasi pembayaran secara manual.',
            icon: Landmark,
            tag: 'Konfirmasi oleh admin',
        },
    ];

    const activeCount = Number(settings.pay_midtrans) + Number(settings.pay_manual);

    return (
        <AdminLayout title="Pengaturan">
            <div className="w-full space-y-6">
                {/* Hero */}
                <div className="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-indigo-700 via-blue-600 to-violet-600 p-8 text-white shadow-xl shadow-indigo-500/20">
                    <div className="pointer-events-none absolute -right-16 -top-20 h-72 w-72 rounded-full bg-white/10" />
                    <div className="relative">
                        <span className="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.25em]">
                            <span className="h-2 w-2 rounded-full bg-sky-300" /> Simple Platform Management
                        </span>
                        <h2 className="mt-4 text-4xl font-extrabold">Pengaturan Platform</h2>
                        <p className="mt-2 max-w-3xl text-lg text-white/80">
                            Atur metode pembayaran yang tersedia dan lihat dampaknya ke tiket, paket, dan voting berbayar di SIMPLE.
                        </p>
                    </div>
                </div>

                {/* Stat */}
                <div className="grid gap-4 md:grid-cols-3">
                    <Stat
                        label="Metode aktif"
                        value={`${activeCount} / 2`}
                        note="Metode pembayaran menyala"
                        icon={CreditCard}
                        tone="bg-indigo-100 text-indigo-600 dark:bg-indigo-500/20 dark:text-indigo-300"
                    />
                    <Stat
                        label="Tiket & paket"
                        value="Tersedia"
                        note="Mengikuti metode yang aktif"
                        icon={Ticket}
                        tone="bg-emerald-100 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-300"
                    />
                    <Stat
                        label="Voting berbayar"
                        value={voting_open ? 'Terbuka' : 'Berhenti'}
                        note={voting_open ? 'Konfirmasi otomatis tersedia' : 'Menunggu Midtrans aktif'}
                        icon={voting_open ? Vote : PauseCircle}
                        tone={
                            voting_open
                                ? 'bg-sky-100 text-sky-600 dark:bg-sky-500/20 dark:text-sky-300'
                                : 'bg-amber-100 text-amber-600 dark:bg-amber-500/20 dark:text-amber-300'
                        }
                    />
                </div>

                {/* Kartu utama */}
                <div className="rounded-[2rem] border border-slate-200 bg-white/80 p-8 shadow-sm backdrop-blur dark:border-white/10 dark:bg-white/5">
                    <div className="flex items-start justify-between gap-4">
                        <div>
                            <h3 className="text-2xl font-extrabold">Metode Pembayaran</h3>
                            <p className="mt-1 text-slate-500 dark:text-slate-400">Aktifkan atau nonaktifkan metode yang tersedia untuk pembeli.</p>
                        </div>
                        <div className="flex h-10 items-center justify-end text-sm">
                            {saving && (
                                <span className="inline-flex items-center gap-2 rounded-full bg-slate-100 px-4 py-2 text-slate-600 dark:bg-white/10 dark:text-slate-300">
                                    <Loader2 className="h-4 w-4 animate-spin" /> Menyimpan...
                                </span>
                            )}
                            {!saving && saved && (
                                <span className="inline-flex items-center gap-2 rounded-full bg-emerald-100 px-4 py-2 font-medium text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300">
                                    <CheckCircle2 className="h-4 w-4" /> Tersimpan
                                </span>
                            )}
                        </div>
                    </div>

                    {errors?.pay_midtrans && (
                        <div className="mt-5 flex items-start gap-3 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-700 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-300">
                            <AlertTriangle className="mt-0.5 h-5 w-5 shrink-0" />
                            <div>
                                <div className="font-semibold">Perubahan tidak disimpan</div>
                                <div>{errors.pay_midtrans}</div>
                            </div>
                        </div>
                    )}

                    <div className="mt-6 grid gap-4 md:grid-cols-2">
                        {methods.map((m) => {
                            const on = settings[m.key];
                            const Icon = m.icon;
                            return (
                                <div
                                    key={m.key}
                                    className={`relative overflow-hidden rounded-3xl border p-6 transition-all duration-200 ${
                                        on
                                            ? 'border-indigo-300 bg-indigo-50/60 ring-1 ring-indigo-400/40 dark:border-indigo-400/40 dark:bg-indigo-500/10'
                                            : 'border-slate-200 bg-white/60 dark:border-white/10 dark:bg-white/5'
                                    }`}
                                >
                                    <div className="flex items-start justify-between gap-3">
                                        <div
                                            className={`flex h-12 w-12 items-center justify-center rounded-2xl transition-colors ${
                                                on
                                                    ? 'bg-gradient-to-br from-indigo-500 to-violet-600 text-white shadow-md shadow-indigo-500/30'
                                                    : 'bg-slate-100 text-slate-400 dark:bg-white/10 dark:text-slate-500'
                                            }`}
                                        >
                                            <Icon className="h-6 w-6" />
                                        </div>
                                        <Toggle on={on} label={m.title} disabled={saving} onChange={(v) => save({ ...settings, [m.key]: v })} />
                                    </div>

                                    <div className="mt-4 flex items-center gap-2">
                                        <h4 className="text-xl font-extrabold">{m.title}</h4>
                                        <span
                                            className={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${
                                                on
                                                    ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300'
                                                    : 'bg-slate-100 text-slate-500 dark:bg-white/10 dark:text-slate-400'
                                            }`}
                                        >
                                            {on ? 'Aktif' : 'Nonaktif'}
                                        </span>
                                    </div>
                                    <div className="text-sm font-medium text-indigo-600 dark:text-indigo-300">{m.subtitle}</div>
                                    <p className="mt-2 text-sm leading-relaxed text-slate-500 dark:text-slate-400">{m.desc}</p>
                                    <div className="mt-4 inline-flex rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-600 dark:bg-white/10 dark:text-slate-300">
                                        {m.tag}
                                    </div>
                                </div>
                            );
                        })}
                    </div>

                    <p className="mt-4 text-xs text-slate-500 dark:text-slate-400">Minimal satu metode harus aktif. Saklar terakhir yang menyala tidak bisa dimatikan.</p>

                    <div
                        className={`mt-6 flex items-start gap-3 rounded-2xl border px-5 py-4 text-sm ${
                            voting_open
                                ? 'border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-200'
                                : 'border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200'
                        }`}
                    >
                        {voting_open ? <CheckCircle2 className="mt-0.5 h-5 w-5 shrink-0" /> : <PauseCircle className="mt-0.5 h-5 w-5 shrink-0" />}
                        <div>
                            <div className="font-semibold">Voting berbayar: {voting_open ? 'terbuka' : 'berhenti sementara'}</div>
                            <div>
                                {voting_open
                                    ? 'Pembelian vote berjalan normal karena Midtrans aktif untuk konfirmasi otomatis.'
                                    : 'Hanya transfer manual yang aktif, sedangkan voting butuh konfirmasi otomatis. Pembelian vote ditutup sampai Midtrans diaktifkan kembali.'}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </AdminLayout>
    );
}
