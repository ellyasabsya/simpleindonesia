import { router } from '@inertiajs/react';
import AdminLayout from '@/components/admin/admin-layout';

type Order = {
    id: number; code: string; buyer_name: string; buyer_email: string; buyer_phone: string; quantity: number;
    total: number; status: string; event_title: string; type_name: string; has_proof: boolean; created_at: string;
};

const rp = (n: number) => `Rp${new Intl.NumberFormat('id-ID').format(n)}`;
const tabs = [
    ['menunggu_verifikasi', 'Perlu verifikasi'], ['lunas', 'Lunas'], ['batal', 'Batal'], ['menunggu', 'Belum bayar'], ['all', 'Semua'],
] as const;

export default function PesananTiket({ orders, status }: { orders: Order[]; status: string }) {
    const act = (id: number, a: 'setujui' | 'tolak') => {
        if (a === 'tolak' && !confirm('Tolak pesanan ini? Kuota tiket akan dilepas.')) return;
        router.patch(`/admin/pesanan-tiket/${id}/${a}`, {}, { preserveScroll: true });
    };
    return (
        <AdminLayout title="Pesanan Tiket">
            <div className="space-y-4">
                <div className="flex flex-wrap gap-2">
                    {tabs.map(([k, l]) => (
                        <button key={k} onClick={() => router.get('/admin/pesanan-tiket', { status: k }, { preserveState: true })}
                            className={`rounded-full px-4 py-1.5 text-sm font-semibold ${status === k ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600 dark:bg-white/10 dark:text-slate-300'}`}>{l}</button>
                    ))}
                </div>
                {orders.length === 0 && <p className="rounded-2xl border border-dashed p-10 text-center text-sm text-slate-500">Tidak ada pesanan.</p>}
                {orders.map((o) => (
                    <div key={o.id} className="rounded-2xl border border-slate-200 bg-white/80 p-5 dark:border-white/10 dark:bg-white/5">
                        <div className="flex flex-wrap items-start justify-between gap-3">
                            <div>
                                <p className="text-xs font-bold text-slate-500">{o.code} · {o.created_at}</p>
                                <p className="text-lg font-extrabold">{o.event_title}</p>
                                <p className="text-sm text-slate-600 dark:text-slate-300">{o.type_name} × {o.quantity} · {rp(o.total)}</p>
                                <p className="text-sm">{o.buyer_name} · {o.buyer_email} · {o.buyer_phone}</p>
                            </div>
                            <span className="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold dark:bg-white/10">{o.status}</span>
                        </div>
                        <div className="mt-3 flex flex-wrap items-center gap-3">
                            {o.has_proof && <a href={`/admin/pesanan-tiket/${o.id}/bukti`} target="_blank" rel="noreferrer" className="text-sm font-bold text-indigo-600 underline">Lihat bukti transfer</a>}
                            {o.status === 'menunggu_verifikasi' && (
                                <>
                                    <button onClick={() => act(o.id, 'setujui')} className="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-bold text-white">Setujui (lunas)</button>
                                    <button onClick={() => act(o.id, 'tolak')} className="rounded-xl border border-red-300 px-4 py-2 text-sm font-bold text-red-600">Tolak</button>
                                </>
                            )}
                        </div>
                    </div>
                ))}
            </div>
        </AdminLayout>
    );
}
