import { router, usePage } from '@inertiajs/react';
import AdminLayout from '@/components/admin/admin-layout';

type Settings = { pay_midtrans: boolean; pay_manual: boolean };

function Toggle({ on, onChange, label }: { on: boolean; onChange: (v: boolean) => void; label: string }) {
    return (
        <button
            type="button"
            role="switch"
            aria-checked={on}
            aria-label={label}
            onClick={() => onChange(!on)}
            className={`relative inline-flex h-7 w-12 shrink-0 items-center rounded-full transition-colors ${
                on ? 'bg-emerald-500' : 'bg-slate-300 dark:bg-white/20'
            }`}
        >
            <span
                className={`inline-block h-5 w-5 transform rounded-full bg-white shadow transition-transform ${
                    on ? 'translate-x-6' : 'translate-x-1'
                }`}
            />
        </button>
    );
}

export default function AdminPengaturan({ settings, voting_open }: { settings: Settings; voting_open: boolean }) {
    const { errors } = usePage().props as { errors?: Record<string, string> };

    const save = (next: Settings) => {
        router.patch('/admin/pengaturan', next, { preserveScroll: true });
    };

    const rows = [
        {
            key: 'pay_midtrans' as const,
            title: 'Midtrans (pembayaran online)',
            desc: 'Konfirmasi otomatis. Dibutuhkan untuk voting berbayar.',
        },
        {
            key: 'pay_manual' as const,
            title: 'Transfer manual',
            desc: 'Pembeli transfer ke rekening dan dikonfirmasi manual oleh admin.',
        },
    ];

    return (
        <AdminLayout title="Pengaturan">
            <div className="max-w-2xl space-y-6">
                <div className="rounded-3xl border border-slate-200 bg-white/70 p-6 backdrop-blur dark:border-white/10 dark:bg-white/5">
                    <h2 className="text-xl font-extrabold">Metode Pembayaran</h2>
                    <p className="mt-1 text-sm text-slate-500 dark:text-slate-400">
                        Minimal satu metode harus aktif.
                    </p>

                    <div className="mt-5 divide-y divide-slate-200 dark:divide-white/10">
                        {rows.map((r) => (
                            <div key={r.key} className="flex items-center justify-between gap-4 py-4">
                                <div>
                                    <div className="font-semibold">{r.title}</div>
                                    <div className="text-sm text-slate-500 dark:text-slate-400">{r.desc}</div>
                                </div>
                                <Toggle
                                    on={settings[r.key]}
                                    label={r.title}
                                    onChange={(v) => save({ ...settings, [r.key]: v })}
                                />
                            </div>
                        ))}
                    </div>

                    {errors?.pay_midtrans && (
                        <p className="mt-3 rounded-xl bg-red-50 px-4 py-2 text-sm text-red-600 dark:bg-red-500/10 dark:text-red-400">
                            {errors.pay_midtrans}
                        </p>
                    )}
                </div>

                <div
                    className={`rounded-3xl border p-5 text-sm ${
                        voting_open
                            ? 'border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-300'
                            : 'border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300'
                    }`}
                >
                    {voting_open
                        ? 'Voting berbayar: terbuka.'
                        : 'Voting berbayar: berhenti. Hanya transfer manual yang aktif, sedangkan voting butuh konfirmasi otomatis.'}
                </div>
            </div>
        </AdminLayout>
    );
}
