import { router, usePage } from '@inertiajs/react';
import { AlertTriangle, CheckCircle2, CreditCard, Landmark, Loader2, PauseCircle, Settings, Ticket, Vote, Zap } from 'lucide-react';
import { useState } from 'react';
import AdminLayout from '@/components/admin/admin-layout';

type Settings = { pay_midtrans: boolean; pay_manual: boolean };
type Key = keyof Settings;

function Toggle({ on, onChange, label, disabled }: { on: boolean; onChange: (v: boolean) => void; label: string; disabled?: boolean }) {
    return (
        <button
            type="button"
            role="switch"
            aria-checked={on}
            aria-label={label}
            disabled={disabled}
            onClick={() => onChange(!on)}
            className={`relative inline-flex h-8 w-14 shrink-0 items-center rounded-full shadow-inner transition-colors duration-200 disabled:cursor-wait disabled:opacity-60 ${
                on ? 'bg-gradient-to-r from-indigo-500 to-violet-600' : 'bg-slate-300 dark:bg-white/20'
            }`}
        >
            <span
                className={`inline-block h-6 w-6 transform rounded-full bg-white shadow-md transition-transform duration-200 ${
                    on ? 'translate-x-7' : 'translate-x-1'
                }`}
            />
        </button>
    );
}

export default function AdminPengaturan({ settings, voting_open }: { settings: Settings; voting_open: boolean }) {
    const { errors } = usePage().props as { errors?: Record<string, string> };
    const [saving, setSaving] = useState(false);
    const [saved, setSaved] = useState(false);

    const save = (next: Settings) => {
        router.patch('/admin/pengaturan', next, {
            preserveScroll: true,
            onStart: () => {
                setSaving(true);
                setSaved(false);
            },
            onSuccess: () => {
                setSaved(true);
                setTimeout(() => setSaved(false), 2500);
            },
            onFinish: () => setSaving(false),
        });
    };

    const methods = [
        {
            key: 'pay_midtrans' as Key,
            title: 'Midtrans',
            subtitle: 'Pembayaran online',
            desc: 'Pembeli membayar lewat e-wallet, kartu, atau virtual account. Pembayaran terkonfirmasi otomatis.',
            icon: Zap,
            tag: 'Konfirmasi otomatis',
        },
        {
            key: 'pay_manual' as Key,
            title: 'Transfer manual',
            subtitle: 'Transfer ke rekening',
            desc: 'Pembeli transfer ke rekening, lalu admin mengecek dan mengonfirmasi pembayaran secara manual.',
            icon: Landmark,
            tag: 'Konfirmasi oleh admin',
        },
    ];

    const activeCount = Number(settings.pay_midtrans) + Number(settings.pay_manual);

    return (
        <AdminLayout title="Pengaturan">
            <div className="max-w-4xl space-y-6">
                {/* Header */}
                <div className="flex items-center justify-between gap-4">
                    <div className="flex items-center gap-4">
                        <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-600 text-white shadow-lg shadow-indigo-500/30">
                            <Settings className="h-7 w-7" />
                        </div>
                        <div>
                            <h2 className="title-gradient text-3xl font-extrabold">Pengaturan</h2>
                            <p className="text-sm text-slate-500 dark:text-slate-400">Atur metode pembayaran yang tersedia di platform.</p>
                        </div>
                    </div>
                    <div className="h-9 text-sm">
                        {saving && (
                            <span className="inline-flex items-center gap-2 rounded-full bg-slate-100 px-4 py-2 text-slate-600 dark:bg-white/10 dark:text-slate-300">
                                <Loader2 className="h-4 w-4 animate-spin" /> Menyimpan...
                            </span>
                        )}
                        {!saving && saved && (
                            <span className="inline-flex items-center gap-2 rounded-full bg-emerald-100 px-4 py-2 font-medium text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300">
                                <CheckCircle2 className="h-4 w-4" /> Tersimpan
                            </span>
                        )}
                    </div>
                </div>

                {/* Error */}
                {errors?.pay_midtrans && (
                    <div className="flex items-start gap-3 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-700 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-300">
                        <AlertTriangle className="mt-0.5 h-5 w-5 shrink-0" />
                        <div>
                            <div className="font-semibold">Perubahan tidak disimpan</div>
                            <div>{errors.pay_midtrans}</div>
                        </div>
                    </div>
                )}

                {/* Metode pembayaran */}
                <section>
                    <div className="mb-3 flex items-center gap-2">
                        <CreditCard className="h-5 w-5 text-indigo-500" />
                        <h3 className="text-lg font-bold">Metode Pembayaran</h3>
                        <span className="ml-auto rounded-full bg-indigo-100 px-3 py-1 text-xs font-semibold text-indigo-700 dark:bg-indigo-500/20 dark:text-indigo-300">
                            {activeCount} dari 2 aktif
                        </span>
                    </div>

                    <div className="grid gap-4 md:grid-cols-2">
                        {methods.map((m) => {
                            const on = settings[m.key];
                            const Icon = m.icon;
                            return (
                                <div
                                    key={m.key}
                                    className={`relative overflow-hidden rounded-3xl border p-6 backdrop-blur transition-all duration-200 ${
                                        on
                                            ? 'border-indigo-300 bg-white/90 shadow-lg shadow-indigo-500/10 ring-1 ring-indigo-400/40 dark:border-indigo-400/40 dark:bg-white/10'
                                            : 'border-slate-200 bg-white/60 dark:border-white/10 dark:bg-white/5'
                                    }`}
                                >
                                    {on && <div className="pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full bg-indigo-400/20 blur-2xl" />}

                                    <div className="relative flex items-start justify-between gap-3">
                                        <div
                                            className={`flex h-12 w-12 items-center justify-center rounded-2xl transition-colors ${
                                                on
                                                    ? 'bg-gradient-to-br from-indigo-500 to-violet-600 text-white shadow-md shadow-indigo-500/30'
                                                    : 'bg-slate-100 text-slate-400 dark:bg-white/10 dark:text-slate-500'
                                            }`}
                                        >
                                            <Icon className="h-6 w-6" />
                                        </div>
                                        <Toggle
                                            on={on}
                                            label={m.title}
                                            disabled={saving}
                                            onChange={(v) => save({ ...settings, [m.key]: v })}
                                        />
                                    </div>

                                    <div className="relative mt-4">
                                        <div className="flex items-center gap-2">
                                            <h4 className="text-xl font-extrabold">{m.title}</h4>
                                            <span
                                                className={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${
                                                    on
                                                        ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300'
                                                        : 'bg-slate-100 text-slate-500 dark:bg-white/10 dark:text-slate-400'
                                                }`}
                                            >
                                                {on ? 'Aktif' : 'Nonaktif'}
                                            </span>
                                        </div>
                                        <div className="text-sm font-medium text-indigo-600 dark:text-indigo-300">{m.subtitle}</div>
                                        <p className="mt-2 text-sm leading-relaxed text-slate-500 dark:text-slate-400">{m.desc}</p>
                                        <div className="mt-4 inline-flex rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-600 dark:bg-white/10 dark:text-slate-300">
                                            {m.tag}
                                        </div>
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                    <p className="mt-3 text-xs text-slate-500 dark:text-slate-400">Minimal satu metode harus aktif. Saklar terakhir yang menyala tidak bisa dimatikan.</p>
                </section>

                {/* Dampak */}
                <section>
                    <div className="mb-3 flex items-center gap-2">
                        <Vote className="h-5 w-5 text-indigo-500" />
                        <h3 className="text-lg font-bold">Dampak ke Layanan</h3>
                    </div>

                    <div className="grid gap-4 md:grid-cols-2">
                        <div className="rounded-3xl border border-slate-200 bg-white/70 p-6 backdrop-blur dark:border-white/10 dark:bg-white/5">
                            <div className="flex items-center gap-3">
                                <div className="flex h-11 w-11 items-center justify-center rounded-2xl bg-sky-100 text-sky-600 dark:bg-sky-500/15 dark:text-sky-300">
                                    <Ticket className="h-5 w-5" />
                                </div>
                                <div>
                                    <div className="font-bold">Tiket & Paket</div>
                                    <div className="text-xs font-semibold text-emerald-600 dark:text-emerald-400">Selalu tersedia</div>
                                </div>
                            </div>
                            <p className="mt-3 text-sm text-slate-500 dark:text-slate-400">
                                Mengikuti metode pembayaran yang aktif. Pembeli melihat pilihan sesuai pengaturan di atas.
                            </p>
                        </div>

                        <div
                            className={`rounded-3xl border p-6 backdrop-blur transition-colors ${
                                voting_open
                                    ? 'border-emerald-200 bg-emerald-50/80 dark:border-emerald-500/30 dark:bg-emerald-500/10'
                                    : 'border-amber-200 bg-amber-50/80 dark:border-amber-500/30 dark:bg-amber-500/10'
                            }`}
                        >
                            <div className="flex items-center gap-3">
                                <div
                                    className={`flex h-11 w-11 items-center justify-center rounded-2xl ${
                                        voting_open
                                            ? 'bg-emerald-100 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-300'
                                            : 'bg-amber-100 text-amber-600 dark:bg-amber-500/20 dark:text-amber-300'
                                    }`}
                                >
                                    {voting_open ? <CheckCircle2 className="h-5 w-5" /> : <PauseCircle className="h-5 w-5" />}
                                </div>
                                <div>
                                    <div className="font-bold">Voting Berbayar</div>
                                    <div
                                        className={`text-xs font-semibold ${
                                            voting_open ? 'text-emerald-600 dark:text-emerald-400' : 'text-amber-600 dark:text-amber-400'
                                        }`}
                                    >
                                        {voting_open ? 'Terbuka' : 'Berhenti sementara'}
                                    </div>
                                </div>
                            </div>
                            <p
                                className={`mt-3 text-sm ${
                                    voting_open ? 'text-emerald-800/80 dark:text-emerald-200/80' : 'text-amber-800/80 dark:text-amber-200/80'
                                }`}
                            >
                                {voting_open
                                    ? 'Pembelian vote berjalan normal karena Midtrans aktif untuk konfirmasi otomatis.'
                                    : 'Hanya transfer manual yang aktif, sedangkan voting butuh konfirmasi otomatis. Pembelian vote ditutup sampai Midtrans diaktifkan kembali.'}
                            </p>
                        </div>
                    </div>
                </section>
            </div>
        </AdminLayout>
    );
}
