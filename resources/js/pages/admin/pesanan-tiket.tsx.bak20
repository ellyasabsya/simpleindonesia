import { router } from '@inertiajs/react';
import { CheckCircle2, ChevronLeft, ChevronRight, Clock, FileText, Search, Ticket, X, XCircle } from 'lucide-react';
import { useState } from 'react';
import AdminLayout from '@/components/admin/admin-layout';

type Order = {
    id: number; code: string; buyer_name: string; buyer_email: string; buyer_phone: string; quantity: number;
    subtotal: number; fee: number; total: number; status: string; event_title: string; type_name: string;
    proof: { url: string; is_pdf: boolean } | null; created_at: string;
};
type Counts = { menunggu_verifikasi: number; lunas: number; batal: number; menunggu: number };
type Pg = { current: number; last: number; total: number; from: number | null; to: number | null };

const rp = (n: number) => `Rp${new Intl.NumberFormat('id-ID').format(n)}`;

const STATUS: Record<string, { label: string; style: string }> = {
    menunggu_verifikasi: { label: 'Perlu verifikasi', style: 'bg-amber-100 text-amber-800 dark:bg-amber-500/15 dark:text-amber-200' },
    lunas: { label: 'Lunas', style: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-500/15 dark:text-emerald-200' },
    batal: { label: 'Dibatalkan', style: 'bg-rose-100 text-rose-800 dark:bg-rose-500/15 dark:text-rose-200' },
    menunggu: { label: 'Belum bayar', style: 'bg-slate-100 text-slate-600 dark:bg-white/10 dark:text-slate-300' },
};

export default function PesananTiket({ orders, status, q, counts, pg }: { orders: Order[]; status: string; q: string; counts: Counts; pg: Pg }) {
    const [search, setSearch] = useState(q);
    const [busy, setBusy] = useState<number | null>(null);
    const [zoom, setZoom] = useState<string | null>(null);
    const pageNumbers = Array.from({ length: pg.last }, (_, i) => i + 1)
        .filter((n) => n === 1 || n === pg.last || Math.abs(n - pg.current) <= 1)
        .reduce<(number | '…')[]>((acc, n, i, arr) => {
            if (i > 0 && n - (arr[i - 1] as number) > 1) acc.push('…');
            acc.push(n);
            return acc;
        }, []);

    const go = (params: Record<string, string>) =>
        router.get('/admin/pesanan-tiket', { status, q: search, ...params }, { preserveState: true, replace: true });

    const act = (o: Order, a: 'setujui' | 'tolak') => {
        if (a === 'tolak' && !confirm(`Tolak pesanan ${o.code}? Kuota tiket akan dilepas.`)) return;
        router.patch(`/admin/pesanan-tiket/${o.id}/${a}`, {}, {
            preserveScroll: true,
            onStart: () => setBusy(o.id),
            onFinish: () => setBusy(null),
        });
    };

    const cards = [
        { key: 'menunggu_verifikasi', label: 'Perlu verifikasi', n: counts.menunggu_verifikasi, color: 'text-amber-600', icon: Clock },
        { key: 'lunas', label: 'Lunas', n: counts.lunas, color: 'text-emerald-600', icon: CheckCircle2 },
        { key: 'batal', label: 'Dibatalkan', n: counts.batal, color: 'text-rose-600', icon: XCircle },
        { key: 'menunggu', label: 'Belum bayar', n: counts.menunggu, color: 'text-slate-500', icon: Ticket },
    ] as const;

    return (
        <AdminLayout title="Verifikasi Tiket">
            <div className="w-full space-y-5">
                <div className="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-700 via-blue-600 to-violet-600 px-7 py-6 text-white shadow-lg shadow-indigo-500/20">
                    <div className="pointer-events-none absolute -right-12 -top-16 h-52 w-52 rounded-full bg-white/10" />
                    <div className="relative">
                        <span className="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.25em]">
                            <span className="h-1.5 w-1.5 rounded-full bg-sky-300" /> Admin Workspace
                        </span>
                        <h2 className="mt-3 text-2xl font-extrabold">Verifikasi Tiket</h2>
                        <p className="mt-1 max-w-2xl text-sm text-white/80">
                            Cek bukti transfer pembeli, lalu setujui. Tiket dengan QR code otomatis dikirim ke email pembeli setelah disetujui.
                        </p>
                    </div>
                </div>

                <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                    {cards.map(({ key, label, n, color, icon: Icon }) => (
                        <button
                            key={key}
                            type="button"
                            onClick={() => go({ status: key })}
                            className={`rounded-2xl border bg-white/80 p-5 text-left shadow-sm transition hover:-translate-y-0.5 dark:bg-white/5 ${
                                status === key ? 'border-indigo-400 ring-2 ring-indigo-400/30' : 'border-slate-200 dark:border-white/10'
                            }`}
                        >
                            <div className="flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-slate-500">
                                {label} <Icon className={`h-4 w-4 ${color}`} />
                            </div>
                            <div className={`mt-2 text-3xl font-extrabold ${color}`}>{n}</div>
                        </button>
                    ))}
                </div>

                <form
                    onSubmit={(e) => { e.preventDefault(); go({ q: search }); }}
                    className="flex flex-wrap items-center gap-3"
                >
                    <div className="relative min-w-[240px] flex-1">
                        <Search className="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
                        <input
                            value={search}
                            onChange={(e) => setSearch(e.target.value)}
                            placeholder="Cari kode, nama, email, atau event"
                            className="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-10 pr-3 text-sm outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30 dark:border-white/10 dark:bg-white/5"
                        />
                    </div>
                    <button type="button" onClick={() => go({ status: 'all' })}
                        className={`shrink-0 rounded-xl border px-4 py-2.5 text-sm font-semibold ${status === 'all' ? 'border-indigo-600 bg-indigo-600 text-white' : 'border-slate-300 bg-white text-slate-700 hover:bg-slate-50 dark:border-white/20 dark:bg-white/5 dark:text-slate-200'}`}>
                        Tampilkan semua
                    </button>
                </form>

                {orders.length === 0 ? (
                    <div className="rounded-3xl border-2 border-dashed border-slate-300 bg-white/60 p-12 text-center dark:border-white/15 dark:bg-white/5">
                        <CheckCircle2 className="mx-auto h-8 w-8 text-emerald-500" />
                        <p className="mt-3 text-lg font-extrabold">Tidak ada pesanan di sini</p>
                        <p className="mt-1 text-sm text-slate-500">Pesanan yang butuh verifikasi akan muncul otomatis.</p>
                    </div>
                ) : (
                    <div className="space-y-4">
                        {orders.map((o) => {
                            const st = STATUS[o.status] ?? STATUS.menunggu;
                            return (
                                <div key={o.id} className="grid gap-5 rounded-3xl border border-slate-200 bg-white/80 p-5 shadow-sm backdrop-blur dark:border-white/10 dark:bg-white/5 md:grid-cols-[200px_1fr]">
                                    <div>
                                        {o.proof ? (
                                            o.proof.is_pdf ? (
                                                <a href={o.proof.url} target="_blank" rel="noreferrer"
                                                    className="flex h-52 w-full flex-col items-center justify-center gap-1 rounded-2xl border border-slate-200 bg-slate-50 text-xs font-bold text-indigo-600 dark:border-white/10 dark:bg-white/5">
                                                    <FileText className="h-7 w-7" /> Buka PDF
                                                </a>
                                            ) : (
                                                <button type="button" onClick={() => setZoom(o.proof!.url)} className="group relative block h-52 w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 dark:border-white/10 dark:bg-slate-800">
                                                    <img src={o.proof.url} alt="Bukti transfer" className="h-full w-full object-contain" />
                                                    <span className="absolute inset-x-0 bottom-0 bg-black/55 py-1 text-center text-[11px] font-bold text-white">Perbesar</span>
                                                </button>
                                            )
                                        ) : (
                                            <div className="flex h-52 items-center justify-center rounded-2xl border border-dashed border-slate-300 text-center text-xs text-slate-400 dark:border-white/15">Tanpa bukti</div>
                                        )}
                                    </div>

                                    <div className="flex min-w-0 flex-col gap-4">
                                      <div className="min-w-0">
                                        <div className="flex flex-wrap items-center gap-2">
                                            <span className={`rounded-full px-3 py-1 text-xs font-bold ${st.style}`}>{st.label}</span>
                                            <span className="text-xs text-slate-500">{o.code} · {o.created_at}</span>
                                        </div>
                                        <h3 className="mt-2 text-lg font-extrabold leading-tight">{o.event_title}</h3>
                                        <p className="text-sm text-slate-600 dark:text-slate-300">{o.type_name} × {o.quantity}</p>
                                        <p className="mt-2 text-sm font-semibold">{o.buyer_name}</p>
                                        <p className="break-all text-sm text-slate-500">{o.buyer_email} · {o.buyer_phone}</p>
                                      </div>

                                      <div className="flex flex-wrap items-end justify-between gap-4 rounded-2xl bg-slate-50 p-4 dark:bg-white/5">
                                        <div>
                                            <p className="text-[11px] font-bold uppercase tracking-wider text-slate-500">Cocokkan dengan transfer</p>
                                            <p className="text-2xl font-extrabold text-indigo-700 dark:text-indigo-300">{rp(o.total)}</p>
                                            <p className="text-[11px] text-slate-500">Tiket {rp(o.subtotal)} + layanan {rp(o.fee)}</p>
                                        </div>
                                        {o.status === 'menunggu_verifikasi' && (
                                            <div className="flex gap-2">
                                                <button type="button" disabled={busy === o.id} onClick={() => act(o, 'setujui')}
                                                    className="rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-emerald-500/20 disabled:opacity-60">
                                                    {busy === o.id ? 'Memproses...' : 'Setujui'}
                                                </button>
                                                <button type="button" disabled={busy === o.id} onClick={() => act(o, 'tolak')}
                                                    className="rounded-xl border border-rose-300 px-4 py-2.5 text-sm font-bold text-rose-600 disabled:opacity-60">
                                                    Tolak
                                                </button>
                                            </div>
                                        )}
                                      </div>
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                )}
                {pg.last > 1 && (
                    <div className="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 text-sm dark:border-white/10 dark:bg-white/5">
                        <span className="text-slate-500">
                            {pg.from && pg.to ? `${pg.from}–${pg.to} dari ${pg.total} pesanan` : `${pg.total} pesanan`}
                        </span>
                        <div className="flex items-center gap-1.5">
                            <button type="button" disabled={pg.current <= 1} onClick={() => go({ page: String(pg.current - 1) })}
                                className="inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-1.5 font-semibold disabled:opacity-40 dark:border-white/10">
                                <ChevronLeft className="h-4 w-4" /> Sebelumnya
                            </button>
                            {pageNumbers.map((n, i) =>
                                n === '…' ? (
                                    <span key={`e${i}`} className="px-1 text-slate-400">…</span>
                                ) : (
                                    <button key={n} type="button" onClick={() => go({ page: String(n) })}
                                        className={`h-8 min-w-8 rounded-lg px-2 font-semibold ${n === pg.current ? 'bg-indigo-600 text-white' : 'border border-slate-200 dark:border-white/10'}`}>
                                        {n}
                                    </button>
                                ),
                            )}
                            <button type="button" disabled={pg.current >= pg.last} onClick={() => go({ page: String(pg.current + 1) })}
                                className="inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-1.5 font-semibold disabled:opacity-40 dark:border-white/10">
                                Berikutnya <ChevronRight className="h-4 w-4" />
                            </button>
                        </div>
                    </div>
                )}
            </div>

            {zoom && (
                <div className="fixed inset-0 z-[9999] flex items-center justify-center bg-slate-900/80 p-4" onClick={() => setZoom(null)}>
                    <button type="button" aria-label="Tutup" className="absolute right-5 top-5 rounded-full bg-white/90 p-2 text-slate-700"><X className="h-5 w-5" /></button>
                    <img src={zoom} alt="Bukti transfer" className="max-h-[90vh] max-w-full rounded-2xl bg-white object-contain shadow-2xl" onClick={(e) => e.stopPropagation()} />
                </div>
            )}
        </AdminLayout>
    );
}
