import { router } from '@inertiajs/react';
import { ChevronLeft, ChevronRight, Inbox, Receipt, Ticket, TrendingUp, Wallet } from 'lucide-react';
import AdminLayout from '@/components/admin/admin-layout';

type Entry = { key: string; date: string; source: 'paket' | 'layanan'; title: string; institution: string; detail: string; amount: number };
type Summary = { total: number; this_month: number; paket: number; layanan: number };
type Bar = { label: string; paket: number; layanan: number };
type Counts = { all: number; paket: number; layanan: number };
type Pg = { current: number; last: number; total: number; from: number | null; to: number | null };

const rp = (n: number) => `Rp${new Intl.NumberFormat('id-ID').format(n)}`;

const PERIODS = [
    { key: 'bulan_ini', label: 'Bulan ini' },
    { key: '3_bulan', label: '3 bulan' },
    { key: 'tahun_ini', label: 'Tahun ini' },
    { key: 'semua', label: 'Semua' },
];

const SOURCE: Record<string, { label: string; style: string }> = {
    paket: { label: 'Paket', style: 'bg-indigo-100 text-indigo-800 dark:bg-indigo-500/15 dark:text-indigo-200' },
    layanan: { label: 'Biaya layanan', style: 'bg-sky-100 text-sky-800 dark:bg-sky-500/15 dark:text-sky-200' },
};

export default function Pendapatan({ entries, summary, chart, periode, sumber, counts, pg }: {
    entries: Entry[]; summary: Summary; chart: Bar[]; periode: string; sumber: string; counts: Counts; pg: Pg;
}) {
    const go = (params: Record<string, string>) =>
        router.get('/admin/pendapatan', { periode, sumber, ...params }, { preserveState: true, replace: true });

    const periodLabel = PERIODS.find((p) => p.key === periode)?.label ?? 'Tahun ini';
    const max = Math.max(1, ...chart.map((c) => c.paket + c.layanan));

    const cards = [
        { label: `Total (${periodLabel.toLowerCase()})`, value: summary.total, color: 'text-indigo-700 dark:text-indigo-300', icon: Wallet },
        { label: 'Bulan ini', value: summary.this_month, color: 'text-emerald-600', icon: TrendingUp },
        { label: 'Dari paket', value: summary.paket, color: 'text-violet-600', icon: Receipt },
        { label: 'Dari biaya layanan tiket', value: summary.layanan, color: 'text-sky-600', icon: Ticket },
    ];

    const tabs = [
        { key: 'all', label: 'Semua', n: counts.all },
        { key: 'paket', label: 'Paket', n: counts.paket },
        { key: 'layanan', label: 'Biaya layanan', n: counts.layanan },
    ];

    const pageNumbers = Array.from({ length: pg.last }, (_, i) => i + 1)
        .filter((n) => n === 1 || n === pg.last || Math.abs(n - pg.current) <= 1)
        .reduce<(number | '…')[]>((acc, n, i, arr) => {
            if (i > 0 && n - (arr[i - 1] as number) > 1) acc.push('…');
            acc.push(n);
            return acc;
        }, []);

    const th = 'px-4 py-3 text-left text-xs font-semibold text-slate-500';
    const td = 'px-4 py-3.5 align-middle';

    return (
        <AdminLayout title="Pendapatan">
            <div className="w-full space-y-5">
                <div className="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-700 via-blue-600 to-violet-600 px-7 py-6 text-white shadow-lg shadow-indigo-500/20">
                    <div className="pointer-events-none absolute -right-12 -top-16 h-52 w-52 rounded-full bg-white/10" />
                    <div className="relative">
                        <span className="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.25em]">
                            <span className="h-1.5 w-1.5 rounded-full bg-sky-300" /> Admin Workspace
                        </span>
                        <h2 className="mt-3 text-2xl font-extrabold">Pendapatan</h2>
                        <p className="mt-1 max-w-2xl text-sm text-white/80">
                            Pemasukan platform dari pembayaran paket yang sudah lunas dan biaya layanan penjualan tiket. Harga tiket itu sendiri milik lembaga, jadi tidak dihitung.
                        </p>
                    </div>
                </div>

                <div className="flex flex-wrap items-center gap-2 rounded-2xl border border-slate-200 bg-white/80 p-2 dark:border-white/10 dark:bg-white/5">
                    <span className="px-3 text-xs font-bold uppercase tracking-wider text-slate-500">Periode</span>
                    {PERIODS.map((p) => (
                        <button key={p.key} type="button" onClick={() => go({ periode: p.key })}
                            className={`rounded-xl px-4 py-2 text-sm font-semibold transition ${periode === p.key ? 'bg-indigo-600 text-white shadow' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-white/10'}`}>
                            {p.label}
                        </button>
                    ))}
                </div>

                <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                    {cards.map(({ label, value, color, icon: Icon }) => (
                        <div key={label} className="rounded-2xl border border-slate-200 bg-white/80 p-5 shadow-sm dark:border-white/10 dark:bg-white/5">
                            <div className="flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-slate-500">
                                {label} <Icon className={`h-4 w-4 ${color}`} />
                            </div>
                            <div className={`mt-2 text-2xl font-extrabold ${color}`}>{rp(value)}</div>
                        </div>
                    ))}
                </div>

                <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-white/10 dark:bg-slate-900/60">
                    <div className="flex flex-wrap items-center justify-between gap-3">
                        <h3 className="font-bold">Pendapatan 12 bulan terakhir</h3>
                        <div className="flex items-center gap-4 text-xs text-slate-500">
                            <span className="inline-flex items-center gap-1.5"><span className="h-2.5 w-2.5 rounded-sm bg-indigo-600" /> Paket</span>
                            <span className="inline-flex items-center gap-1.5"><span className="h-2.5 w-2.5 rounded-sm bg-sky-400" /> Biaya layanan</span>
                        </div>
                    </div>
                    <div className="mt-5 flex items-end gap-2">
                        {chart.map((c) => {
                            const total = c.paket + c.layanan;
                            return (
                                <div key={c.label} className="flex flex-1 flex-col items-center gap-2"
                                    title={`${c.label}: ${rp(total)} (paket ${rp(c.paket)}, layanan ${rp(c.layanan)})`}>
                                    <div className="flex h-44 w-full items-end justify-center border-b border-slate-200 dark:border-white/10">
                                        <div className="flex w-full max-w-[36px] flex-col justify-end overflow-hidden rounded-t-md" style={{ height: `${(total / max) * 100}%` }}>
                                            <div className="bg-sky-400" style={{ height: `${total ? (c.layanan / total) * 100 : 0}%` }} />
                                            <div className="bg-indigo-600" style={{ height: `${total ? (c.paket / total) * 100 : 0}%` }} />
                                        </div>
                                    </div>
                                    <span className="text-[11px] text-slate-500">{c.label}</span>
                                </div>
                            );
                        })}
                    </div>
                </div>

                <div className="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-white/10 dark:bg-slate-900/60">
                    <div className="flex flex-wrap items-center gap-1.5 border-b border-slate-200 px-4 py-3 dark:border-white/10">
                        {tabs.map((t) => {
                            const active = sumber === t.key;
                            return (
                                <button key={t.key} type="button" onClick={() => go({ sumber: t.key })}
                                    className={`inline-flex items-center gap-2 rounded-lg px-3.5 py-2 text-sm font-semibold transition ${active ? 'bg-indigo-600 text-white' : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-white/10'}`}>
                                    {t.label}
                                    <span className={`rounded-full px-2 py-0.5 text-xs font-bold ${active ? 'bg-white/25 text-white' : 'bg-slate-100 text-slate-600 dark:bg-white/10 dark:text-slate-300'}`}>{t.n}</span>
                                </button>
                            );
                        })}
                    </div>

                    {entries.length === 0 ? (
                        <div className="flex flex-col items-center px-4 py-16 text-center">
                            <div className="flex h-14 w-14 items-center justify-center rounded-full bg-slate-100 text-slate-400 dark:bg-white/10">
                                <Inbox className="h-7 w-7" />
                            </div>
                            <p className="mt-4 font-semibold text-slate-700 dark:text-slate-200">Belum ada pendapatan pada periode ini.</p>
                            <p className="mt-1 max-w-md text-sm text-slate-500">
                                Pendapatan muncul setelah pembayaran paket disetujui di Verifikasi Paket atau pesanan tiket berstatus Lunas.
                            </p>
                            {periode !== 'semua' && (
                                <button type="button" onClick={() => go({ periode: 'semua', sumber: 'all' })}
                                    className="mt-4 rounded-lg bg-indigo-600 px-5 py-2 text-sm font-semibold text-white hover:bg-indigo-700">
                                    Lihat semua periode
                                </button>
                            )}
                        </div>
                    ) : (
                        <div className="overflow-x-auto">
                            <table className="w-full min-w-[820px] text-sm">
                                <thead className="bg-slate-50 dark:bg-white/5">
                                    <tr>
                                        <th className={th}>Tanggal</th>
                                        <th className={th}>Sumber</th>
                                        <th className={th}>Event</th>
                                        <th className={th}>Lembaga</th>
                                        <th className={`${th} text-right`}>Nominal</th>
                                    </tr>
                                </thead>
                                <tbody className="divide-y divide-slate-100 dark:divide-white/10">
                                    {entries.map((e) => {
                                        const src = SOURCE[e.source];
                                        return (
                                            <tr key={e.key} className="hover:bg-slate-50/70 dark:hover:bg-white/5">
                                                <td className={`${td} whitespace-nowrap text-xs text-slate-500`}>{e.date}</td>
                                                <td className={td}>
                                                    <span className={`whitespace-nowrap rounded-full px-3 py-1 text-xs font-bold ${src.style}`}>{src.label}</span>
                                                </td>
                                                <td className={td}>
                                                    <div className="font-semibold">{e.title}</div>
                                                    <div className="text-xs text-slate-500">{e.detail}</div>
                                                </td>
                                                <td className={td}>{e.institution}</td>
                                                <td className={`${td} text-right font-bold text-emerald-600`}>{rp(e.amount)}</td>
                                            </tr>
                                        );
                                    })}
                                </tbody>
                            </table>
                        </div>
                    )}

                    {pg.last > 1 && (
                        <div className="flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 px-4 py-3 text-sm dark:border-white/10">
                            <span className="text-slate-500">{pg.from && pg.to ? `${pg.from}–${pg.to} dari ${pg.total} transaksi` : `${pg.total} transaksi`}</span>
                            <div className="flex items-center gap-1.5">
                                <button type="button" disabled={pg.current <= 1} onClick={() => go({ page: String(pg.current - 1) })}
                                    className="inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-1.5 font-semibold disabled:opacity-40 dark:border-white/10">
                                    <ChevronLeft className="h-4 w-4" /> Sebelumnya
                                </button>
                                {pageNumbers.map((n, i) =>
                                    n === '…' ? (
                                        <span key={`e${i}`} className="px-1 text-slate-400">…</span>
                                    ) : (
                                        <button key={n} type="button" onClick={() => go({ page: String(n) })}
                                            className={`h-8 min-w-8 rounded-lg px-2 font-semibold ${n === pg.current ? 'bg-indigo-600 text-white' : 'border border-slate-200 dark:border-white/10'}`}>
                                            {n}
                                        </button>
                                    ),
                                )}
                                <button type="button" disabled={pg.current >= pg.last} onClick={() => go({ page: String(pg.current + 1) })}
                                    className="inline-flex items-center gap-1 rounded-lg border border-slate-200 px-3 py-1.5 font-semibold disabled:opacity-40 dark:border-white/10">
                                    Berikutnya <ChevronRight className="h-4 w-4" />
                                </button>
                            </div>
                        </div>
                    )}
                </div>
            </div>
        </AdminLayout>
    );
}
