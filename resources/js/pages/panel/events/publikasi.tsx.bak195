import { router, usePage } from '@inertiajs/react';
import { Check, Clock, Eye, Loader2, Megaphone, MessageSquareWarning, Users } from 'lucide-react';
import { useState } from 'react';

type Rules = {
    method: string; combine: string; scale: string; rounding: string; ranking: string; deduction: string;
    criteria: { name: string; weight: number }[];
    penalty_types: string[];
};
type Appeal = { id: number; participant: string; reason: string; status: string; created_at: string };
type Vis = 'hidden' | 'own' | 'all';
type Publication = {
    rules: Rules; latest_version: number | null; up_to_date: boolean;
    visibility: Vis; appeals_open: boolean; appeals_deadline: string | null; appeals: Appeal[];
};

const solid = 'rounded-3xl bg-white shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-white/10';
const h = 'text-lg font-black text-slate-900 dark:text-white';
const sub = 'mt-0.5 text-sm text-slate-600 dark:text-slate-300';
const label = 'text-xs font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400';
const field = 'h-12 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-900 placeholder:font-medium placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/15 dark:border-white/15 dark:bg-slate-950 dark:text-white';

function Row({ k, v }: { k: string; v: string }) {
    return (
        <div className="flex items-baseline justify-between gap-4 border-b border-slate-100 py-3 dark:border-white/10">
            <span className="text-sm text-slate-500 dark:text-slate-400">{k}</span>
            <span className="text-right text-sm font-extrabold text-slate-900 dark:text-white">{v}</span>
        </div>
    );
}

function Switch({ on, busy, onClick }: { on: boolean; busy?: boolean; onClick: () => void }) {
    return (
        <button type="button" role="switch" aria-checked={on} disabled={busy} onClick={onClick} className={`relative h-8 w-14 shrink-0 rounded-full transition disabled:opacity-60 ${on ? 'bg-indigo-600' : 'bg-slate-300'}`}>
            <span className={`absolute top-1 flex h-6 w-6 items-center justify-center rounded-full bg-white shadow transition-all ${on ? 'left-[30px]' : 'left-1'}`}>
                {busy && <Loader2 className="h-3.5 w-3.5 animate-spin text-indigo-600" />}
            </span>
        </button>
    );
}

export default function Publikasi(_props: { btn?: string }) {
    const page = usePage().props as any;
    const base: string = page.inviteBase;
    const categoryId: number = page.category?.id ?? 0;
    const pub: Publication | null = page.publication ?? null;

    const [choice, setChoice] = useState<'own' | 'all'>(pub && pub.visibility === 'all' ? 'all' : 'own');
    const [note, setNote] = useState('');
    const [busy, setBusy] = useState(false);
    const [open, setOpen] = useState(pub?.appeals_open ?? false);
    const [deadline, setDeadline] = useState(pub?.appeals_deadline ?? '');

    if (!pub) {
        return (
            <div className={`${solid} p-8 text-center`}>
                <Megaphone className="mx-auto h-8 w-8 text-indigo-600" />
                <p className="mt-3 font-extrabold text-slate-900 dark:text-white">Data publikasi belum tersedia</p>
            </div>
        );
    }

    const r = pub.rules;
    const shown = pub.visibility !== 'hidden';

    const send = (visibility: Vis, o: boolean, d: string, publish: boolean) => {
        router.put(`${base}/publikasi/pengaturan`, { category_id: categoryId, visibility, appeals_open: o, appeals_deadline: d || null, publish, note }, {
            preserveScroll: true,
            onSuccess: () => setNote(''),
            onFinish: () => setBusy(false),
        });
    };
    const toggleShow = () => { setBusy(true); send(shown ? 'hidden' : choice, open, deadline, true); };
    const pickChoice = (k: 'own' | 'all') => { setChoice(k); if (shown) { setBusy(true); send(k, open, deadline, true); } };
    const toggleAppeals = () => { const v = !open; setOpen(v); send(pub.visibility, v, deadline, false); };
    const saveDeadline = () => send(pub.visibility, open, deadline, false);

    const visOptions: { k: 'own' | 'all'; t: string; d: string; i: typeof Eye }[] = [
        { k: 'own', t: 'Nilai peserta sendiri', d: 'Tiap peserta hanya melihat nilai timnya sendiri.', i: Eye },
        { k: 'all', t: 'Nilai semua peserta', d: 'Semua peserta melihat peringkat dan nilai akhir.', i: Users },
    ];

    return (
        <div className="space-y-5">
            <div className={`${solid} p-5 sm:p-6`}>
                <h3 className={h}>Pengaturan publikasi</h3>
                <p className={sub}>Aturan penilaian yang akan dilihat peserta dan siapa yang boleh melihat hasil.</p>

                <p className={`${label} mt-6`}>Aturan penilaian</p>
                <div className="mt-1 grid gap-x-10 md:grid-cols-2">
                    <div><Row k="Metode" v={r.method} /><Row k="Batas nilai" v={r.scale} /><Row k="Urutan peringkat" v={r.ranking} /></div>
                    <div><Row k="Penggabungan nilai juri" v={r.combine} /><Row k="Pembulatan" v={r.rounding} /><Row k="Pengurangan nilai" v={r.deduction} /></div>
                </div>

                <ul className="mt-4 space-y-3">
                    {r.criteria.map((c) => (
                        <li key={c.name} className="flex items-center gap-4">
                            <span className="w-40 shrink-0 truncate text-sm font-bold text-slate-800 dark:text-slate-100">{c.name}</span>
                            <span className="h-2.5 flex-1 overflow-hidden rounded-full bg-slate-200 dark:bg-white/10"><span className="block h-full rounded-full bg-gradient-to-r from-blue-600 to-violet-600" style={{ width: `${c.weight}%` }} /></span>
                            <span className="w-12 text-right text-sm font-extrabold text-slate-900 dark:text-white">{c.weight}%</span>
                        </li>
                    ))}
                </ul>

                {r.penalty_types.length > 0 && (
                    <div className="mt-4 flex flex-wrap gap-2">
                        {r.penalty_types.map((p) => <span key={p} className="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-800 dark:bg-white/10 dark:text-slate-100">{p}</span>)}
                    </div>
                )}

                <div className="mt-8 flex items-center justify-between gap-4 rounded-2xl bg-slate-50 px-4 py-4 dark:bg-white/5">
                    <div className="min-w-0">
                        <div className="font-extrabold text-slate-900 dark:text-white">Tampilkan hasil ke peserta</div>
                        <div className="mt-0.5 text-xs text-slate-600 dark:text-slate-300">Hasil tampil sebagai "sementara" sampai tahap Tetapkan Hasil. Nama juri dan nilai per juri tidak pernah ditampilkan.</div>
                        <span className={`mt-2 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-extrabold ${shown && pub.up_to_date ? 'bg-emerald-100 text-emerald-900' : 'bg-amber-100 text-amber-900'}`}>
                            {shown && pub.up_to_date ? <Check className="h-3.5 w-3.5" /> : <Clock className="h-3.5 w-3.5" />}
                            {!shown ? 'Tersembunyi' : pub.up_to_date ? `Aktif · versi ${pub.latest_version}` : 'Aktif · ada perubahan belum diterbitkan'}
                        </span>
                    </div>
                    <Switch on={shown} busy={busy} onClick={toggleShow} />
                </div>

                {shown && (
                    <div className="mt-3 space-y-3">
                        <div className="grid gap-3 md:grid-cols-2">
                            {visOptions.map(({ k, t, d, i: Icon }) => (
                                <button key={k} type="button" onClick={() => pickChoice(k)} className={`rounded-2xl border-2 p-4 text-left transition ${pub.visibility === k ? 'border-indigo-600 bg-indigo-50 dark:bg-indigo-500/10' : 'border-slate-200 hover:border-slate-300 dark:border-white/10'}`}>
                                    <Icon className={`h-5 w-5 ${pub.visibility === k ? 'text-indigo-700' : 'text-slate-400'}`} />
                                    <div className="mt-2 font-extrabold text-slate-900 dark:text-white">{t}</div>
                                    <div className="mt-0.5 text-xs text-slate-600 dark:text-slate-300">{d}</div>
                                </button>
                            ))}
                        </div>
                        {!pub.up_to_date && (
                            <div className="flex flex-col gap-3 sm:flex-row">
                                <input value={note} onChange={(e) => setNote(e.target.value)} placeholder="Catatan perubahan untuk peserta (opsional)" className={`${field} flex-1`} />
                                <button type="button" disabled={busy} onClick={() => { setBusy(true); send(pub.visibility, open, deadline, true); }} className="h-12 rounded-2xl bg-indigo-600 px-6 text-sm font-extrabold text-white hover:bg-indigo-700 disabled:opacity-60">Terbitkan perubahan</button>
                            </div>
                        )}
                    </div>
                )}
            </div>

            <div className={`${solid} p-5 sm:p-6`}>
                <h3 className={h}>Keberatan peserta</h3>
                <p className={sub}>Atur pengajuan keberatan dan proses keberatan yang masuk. Perubahan tersimpan otomatis.</p>

                <div className="mt-4 grid gap-3 md:grid-cols-2">
                    <div className="flex items-center justify-between gap-3 rounded-2xl bg-slate-50 px-4 py-3 dark:bg-white/5">
                        <span>
                            <span className="block font-extrabold text-slate-900 dark:text-white">Buka pengajuan keberatan</span>
                            <span className="block text-xs text-slate-600 dark:text-slate-300">Peserta bisa mengajukan keberatan.</span>
                        </span>
                        <Switch on={open} onClick={toggleAppeals} />
                    </div>
                    <label className="block">
                        <span className="text-[11px] font-extrabold uppercase tracking-wider text-slate-600 dark:text-slate-300">Batas waktu keberatan (opsional)</span>
                        <input type="datetime-local" value={deadline} onChange={(e) => setDeadline(e.target.value)} onBlur={saveDeadline} className={`${field} mt-1`} />
                    </label>
                </div>

                {pub.appeals.length === 0 ? (
                    <div className="mt-4 flex flex-col items-center rounded-2xl border-2 border-dashed border-slate-200 px-4 py-8 text-center dark:border-white/10">
                        <MessageSquareWarning className="h-7 w-7 text-slate-400" />
                        <p className="mt-2 font-extrabold text-slate-900 dark:text-white">Belum ada keberatan</p>
                    </div>
                ) : (
                    <ul className="mt-4 space-y-2">
                        {pub.appeals.map((a) => (
                            <li key={a.id} className="rounded-2xl border border-slate-200 px-4 py-3 dark:border-white/10">
                                <div className="flex items-center justify-between gap-3">
                                    <span className="font-extrabold text-slate-900 dark:text-white">{a.participant}</span>
                                    <span className={`rounded-full px-2.5 py-1 text-[11px] font-extrabold ${a.status === 'baru' ? 'bg-amber-100 text-amber-900' : 'bg-emerald-100 text-emerald-900'}`}>{a.status === 'baru' ? 'Perlu diproses' : 'Selesai'}</span>
                                </div>
                                <p className="mt-1 text-sm text-slate-700 dark:text-slate-200">{a.reason}</p>
                                <p className="mt-1 text-xs text-slate-500">{a.created_at}</p>
                            </li>
                        ))}
                    </ul>
                )}
                <p className="mt-4 text-xs text-slate-600 dark:text-slate-300">Keberatan yang diterima tidak mengubah nilai otomatis. Koreksi lewat Rekap Nilai (buka kembali, pengurangan) atau menu Penalti.</p>
            </div>
        </div>
    );
}
