import PanelLayout from '@/components/panel/panel-layout';
import { router } from '@inertiajs/react';
import { ArrowDown, ArrowUp, Check, Copy, Download, ExternalLink, Plus, Search, Trash2 } from 'lucide-react';
import { useMemo, useState } from 'react';

type FieldType = 'text' | 'textarea' | 'number' | 'select' | 'checkbox' | 'date';
type Field = { key: string; label: string; type: FieldType; required: boolean; options: string[]; archived?: boolean };
type Item = { key?: string; label: string; type: FieldType; required: boolean; optionsText: string };
type Row = { id: number; name: string; email: string; whatsapp: string | null; at: string; answers: Record<string, unknown> };
type Props = { eventId: number; fields: Field[]; message: string; quota: number | null; rows: Row[]; link: string; published: boolean };

const TYPES: { value: FieldType; label: string }[] = [
    { value: 'text', label: 'Teks pendek' },
    { value: 'textarea', label: 'Teks panjang' },
    { value: 'number', label: 'Angka' },
    { value: 'select', label: 'Pilihan (dropdown)' },
    { value: 'checkbox', label: 'Pilihan ganda (centang)' },
    { value: 'date', label: 'Tanggal' },
];
const needsOptions = (t: FieldType) => t === 'select' || t === 'checkbox';
const toItems = (fs: Field[]): Item[] =>
    fs.filter((f) => !f.archived).map((f) => ({ key: f.key, label: f.label, type: f.type, required: f.required, optionsText: (f.options ?? []).join('\n') }));

const card = 'rounded-3xl border border-white/70 bg-white/80 shadow-sm backdrop-blur dark:border-white/10 dark:bg-white/5';
const field = 'rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30 dark:border-white/10 dark:bg-white/5';
const iconBtn = 'rounded-lg p-2 text-slate-500 hover:bg-slate-100 disabled:opacity-30 dark:hover:bg-white/10';

export default function RegistrasiForm({ eventId, fields, message, quota, rows, link, published }: Props) {
    const [tab, setTab] = useState<'form' | 'data'>('form');
    const [items, setItems] = useState<Item[]>(() => toItems(fields));
    const [msg, setMsg] = useState(message);
    const [errors, setErrors] = useState<string[]>([]);
    const [saving, setSaving] = useState(false);
    const [saved, setSaved] = useState(false);
    const [copied, setCopied] = useState(false);
    const [q, setQ] = useState('');

    const patch = (i: number, p: Partial<Item>) => { setSaved(false); setItems((a) => a.map((x, j) => (j === i ? { ...x, ...p } : x))); };
    const move = (i: number, d: number) => { setSaved(false); setItems((a) => { const j = i + d; if (j < 0 || j >= a.length) return a; const c = [...a]; [c[i], c[j]] = [c[j], c[i]]; return c; }); };
    const add = () => { setSaved(false); setItems((a) => [...a, { label: '', type: 'text', required: false, optionsText: '' }]); };
    const remove = (i: number) => { setSaved(false); setItems((a) => a.filter((_, j) => j !== i)); };

    const save = () => {
        setErrors([]);
        setSaved(false);
        router.put(
            `/panel/event/${eventId}/registrasi/form`,
            {
                fields: items.map((f) => ({
                    key: f.key ?? null,
                    label: f.label.trim(),
                    type: f.type,
                    required: f.required,
                    options: needsOptions(f.type) ? f.optionsText.split('\n').map((s) => s.trim()).filter(Boolean) : [],
                })),
                message: msg,
            },
            {
                preserveScroll: true,
                onStart: () => setSaving(true),
                onFinish: () => setSaving(false),
                onSuccess: (page) => { setItems(toItems((page.props as unknown as Props).fields)); setSaved(true); },
                onError: (e) => setErrors(Object.values(e)),
            },
        );
    };

    const copy = async () => {
        try { await navigator.clipboard.writeText(link); setCopied(true); setTimeout(() => setCopied(false), 2000); } catch { /* abaikan */ }
    };

    const list = useMemo(() => {
        const k = q.trim().toLowerCase();
        return rows.filter((r) => !k || [r.name, r.email, r.whatsapp ?? ''].some((v) => v.toLowerCase().includes(k)));
    }, [rows, q]);

    const cell = (v: unknown) => (Array.isArray(v) ? v.join(', ') : v == null ? '' : String(v));

    return (
        <PanelLayout title="Registrasi">
            <div className="space-y-5">
                <div className={`${card} flex flex-wrap items-center justify-between gap-4 p-6`}>
                    <div>
                        <h2 className="text-xl font-extrabold">Form pendaftaran</h2>
                        <p className="mt-1 text-sm text-slate-500">
                            {rows.length} pendaftar{quota ? ` dari kuota ${quota}` : ', tanpa batas kuota'}. Anda menentukan sendiri data yang diminta.
                        </p>
                        {!published && <p className="mt-2 text-xs font-semibold text-amber-700">Event belum terbit, jadi form publik belum bisa dibuka.</p>}
                    </div>
                    <div className="flex flex-wrap gap-2">
                        <button type="button" onClick={copy} className="inline-flex items-center gap-2 rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold hover:bg-slate-50 dark:border-white/10 dark:hover:bg-white/5">
                            {copied ? <Check className="h-4 w-4" /> : <Copy className="h-4 w-4" />} {copied ? 'Tersalin' : 'Salin tautan'}
                        </button>
                        <a href={link} target="_blank" rel="noreferrer" className="inline-flex items-center gap-2 rounded-xl bg-indigo-900 px-4 py-2.5 text-sm font-bold text-white hover:bg-indigo-800">
                            <ExternalLink className="h-4 w-4" /> Buka form publik
                        </a>
                    </div>
                </div>

                <div className="flex gap-2">
                    {([['form', 'Susun form'], ['data', `Pendaftar (${rows.length})`]] as const).map(([k, t]) => (
                        <button key={k} type="button" onClick={() => setTab(k)} className={`rounded-xl px-4 py-2 text-sm font-bold ${tab === k ? 'bg-indigo-900 text-white' : 'border border-slate-200 hover:bg-slate-50 dark:border-white/10 dark:hover:bg-white/5'}`}>{t}</button>
                    ))}
                </div>

                {tab === 'form' && (
                    <div className="space-y-4">
                        <div className={`${card} p-5`}>
                            <div className="text-xs font-extrabold uppercase tracking-wider text-slate-500">Kolom bawaan (selalu ada)</div>
                            <p className="mt-2 text-sm">Nama (wajib), Email (wajib), dan Nomor WhatsApp (opsional). Email dipakai untuk mencegah pendaftar ganda.</p>
                        </div>

                        {items.map((f, i) => (
                            <div key={f.key ?? `new-${i}`} className={`${card} space-y-3 p-5`}>
                                <div className="flex flex-wrap items-center gap-2">
                                    <input value={f.label} onChange={(e) => patch(i, { label: e.target.value })} placeholder="Label kolom, misalnya Nama sekolah" maxLength={120} className={`${field} min-w-0 flex-1`} />
                                    <select value={f.type} onChange={(e) => patch(i, { type: e.target.value as FieldType })} className={field}>
                                        {TYPES.map((t) => <option key={t.value} value={t.value}>{t.label}</option>)}
                                    </select>
                                    <label className="flex items-center gap-2 text-sm font-semibold">
                                        <input type="checkbox" checked={f.required} onChange={(e) => patch(i, { required: e.target.checked })} /> Wajib
                                    </label>
                                    <button type="button" className={iconBtn} disabled={i === 0} onClick={() => move(i, -1)} aria-label="Naik"><ArrowUp className="h-4 w-4" /></button>
                                    <button type="button" className={iconBtn} disabled={i === items.length - 1} onClick={() => move(i, 1)} aria-label="Turun"><ArrowDown className="h-4 w-4" /></button>
                                    <button type="button" className={`${iconBtn} text-rose-600`} onClick={() => remove(i)} aria-label="Hapus"><Trash2 className="h-4 w-4" /></button>
                                </div>
                                {needsOptions(f.type) && (
                                    <textarea value={f.optionsText} onChange={(e) => patch(i, { optionsText: e.target.value })} rows={3} placeholder={'Satu pilihan per baris\nContoh:\nSD\nSMP\nSMA'} className={`${field} w-full`} />
                                )}
                            </div>
                        ))}

                        <button type="button" onClick={add} className="inline-flex items-center gap-2 rounded-xl border-2 border-dashed border-indigo-300 px-4 py-3 text-sm font-bold text-indigo-700 hover:bg-indigo-50 dark:border-indigo-400/40 dark:text-indigo-300 dark:hover:bg-white/5">
                            <Plus className="h-4 w-4" /> Tambah kolom
                        </button>

                        <div className={`${card} p-5`}>
                            <label className="text-sm font-bold">Pesan setelah daftar</label>
                            <textarea value={msg} onChange={(e) => { setSaved(false); setMsg(e.target.value); }} rows={3} maxLength={2000} placeholder="Contoh: Terima kasih sudah mendaftar. Informasi selanjutnya kami kirim lewat email." className={`${field} mt-2 w-full`} />
                            <p className="mt-3 text-xs text-slate-500">
                                Anda bertanggung jawab atas data pribadi yang diminta (UU PDP). Hindari data sensitif seperti NIK kalau tidak benar-benar perlu. Form publik menampilkan persetujuan penggunaan data.
                            </p>
                        </div>

                        {errors.length > 0 && (
                            <div className="rounded-2xl border border-rose-300 bg-rose-50 p-4 text-sm font-semibold text-rose-800">
                                {errors.map((e, i) => <div key={i}>{e}</div>)}
                            </div>
                        )}

                        <div className="flex items-center gap-3">
                            <button type="button" onClick={save} disabled={saving} className="rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-2.5 text-sm font-bold text-white shadow hover:opacity-90 disabled:opacity-60">{saving ? 'Menyimpan...' : 'Simpan form'}</button>
                            {saved && <span className="inline-flex items-center gap-1 text-sm font-semibold text-emerald-700"><Check className="h-4 w-4" /> Tersimpan</span>}
                        </div>
                    </div>
                )}

                {tab === 'data' && (
                    <div className={`${card} p-5`}>
                        <div className="flex flex-wrap items-center gap-2">
                            <div className="relative flex-1">
                                <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
                                <input value={q} onChange={(e) => setQ(e.target.value)} placeholder="Cari nama, email, atau WhatsApp" className={`${field} w-full pl-9`} />
                            </div>
                            <a href={`/panel/event/${eventId}/registrasi/export`} className="inline-flex items-center gap-2 rounded-xl bg-indigo-900 px-4 py-2.5 text-sm font-bold text-white hover:bg-indigo-800"><Download className="h-4 w-4" /> Ekspor CSV</a>
                        </div>
                        <div className="mt-4 overflow-x-auto">
                            <table className="w-full text-left text-sm">
                                <thead>
                                    <tr className="border-b border-slate-200 text-xs uppercase tracking-wider text-slate-500 dark:border-white/10">
                                        <th className="py-2 pr-4">Nama</th><th className="py-2 pr-4">Email</th><th className="py-2 pr-4">WhatsApp</th><th className="py-2 pr-4">Waktu</th>
                                        {fields.map((f) => <th key={f.key} className="py-2 pr-4">{f.label}{f.archived ? ' (arsip)' : ''}</th>)}
                                        <th />
                                    </tr>
                                </thead>
                                <tbody>
                                    {list.map((r) => (
                                        <tr key={r.id} className="border-b border-slate-100 align-top dark:border-white/5">
                                            <td className="py-2 pr-4 font-semibold">{r.name}</td>
                                            <td className="py-2 pr-4">{r.email}</td>
                                            <td className="py-2 pr-4">{r.whatsapp ?? ''}</td>
                                            <td className="whitespace-nowrap py-2 pr-4">{r.at}</td>
                                            {fields.map((f) => <td key={f.key} className="py-2 pr-4">{cell(r.answers[f.key])}</td>)}
                                            <td className="py-2">
                                                <button type="button" className={`${iconBtn} text-rose-600`} aria-label="Hapus pendaftar" onClick={() => { if (confirm(`Hapus pendaftar ${r.name}?`)) router.delete(`/panel/event/${eventId}/registrasi/pendaftar/${r.id}`, { preserveScroll: true }); }}><Trash2 className="h-4 w-4" /></button>
                                            </td>
                                        </tr>
                                    ))}
                                    {list.length === 0 && <tr><td colSpan={5 + fields.length} className="py-8 text-center text-slate-500">Belum ada pendaftar.</td></tr>}
                                </tbody>
                            </table>
                        </div>
                    </div>
                )}
            </div>
        </PanelLayout>
    );
}
