import PanelLayout from '@/components/panel/panel-layout';
import { Link } from '@inertiajs/react';
import { ChevronLeft, ChevronRight, ClipboardList, Layers, Search, Ticket } from 'lucide-react';
import { useMemo, useState } from 'react';

type Sub = { id: number; title: string; method: string | null; fee: number; published: boolean; count: number };
type Row = { sub_id: number; sub: string; reg_id: string | null; name: string; kind: string; status: string };

const PER_PAGE = 25;
const rp = (n: number) => 'Rp' + n.toLocaleString('id-ID');
const box = 'rounded-3xl border border-white/70 bg-white/80 shadow-sm backdrop-blur dark:border-white/10 dark:bg-white/5';
const field = 'rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30 dark:border-white/10 dark:bg-white/5';

const STATUS: Record<string, { label: string; style: string }> = {
    lunas: { label: 'Terdaftar', style: 'bg-emerald-100 text-emerald-800' },
    menunggu: { label: 'Menunggu verifikasi', style: 'bg-amber-100 text-amber-800' },
    menunggu_verifikasi: { label: 'Menunggu verifikasi', style: 'bg-amber-100 text-amber-800' },
    batal: { label: 'Dibatalkan', style: 'bg-slate-200 text-slate-700' },
    dibatalkan: { label: 'Dibatalkan', style: 'bg-slate-200 text-slate-700' },
    kedaluwarsa: { label: 'Kedaluwarsa', style: 'bg-slate-200 text-slate-700' },
    ditolak: { label: 'Ditolak', style: 'bg-rose-100 text-rose-800' },
};

export default function RegistrasiInduk({ subs, rows }: { subs: Sub[]; rows: Row[] }) {
    const [q, setQ] = useState('');
    const [sub, setSub] = useState('');
    const [status, setStatus] = useState('');
    const [page, setPage] = useState(1);

    const statuses = useMemo(() => Array.from(new Set(rows.map((r) => r.status))), [rows]);
    const list = useMemo(() => {
        const k = q.trim().toLowerCase();
        return rows.filter((r) =>
            (!sub || String(r.sub_id) === sub) &&
            (!status || r.status === status) &&
            (!k || [r.reg_id ?? '', r.name, r.sub, r.kind].some((v) => v.toLowerCase().includes(k))),
        );
    }, [rows, q, sub, status]);

    const pages = Math.max(1, Math.ceil(list.length / PER_PAGE));
    const cur = Math.min(page, pages);
    const view = list.slice((cur - 1) * PER_PAGE, cur * PER_PAGE);
    const from = list.length === 0 ? 0 : (cur - 1) * PER_PAGE + 1;
    const to = Math.min(cur * PER_PAGE, list.length);

    return (
        <PanelLayout title="Registrasi">
            <div className="space-y-5">
                <div className={`${box} flex items-start gap-5 p-6`}>
                    <div className="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-violet-600 to-indigo-600 text-white shadow-lg shadow-violet-500/30">
                        <Layers className="size-6" strokeWidth={2} />
                    </div>
                    <div>
                        <h2 className="text-xl font-extrabold">Pendaftaran per sub-event</h2>
                        <p className="mt-1 text-sm text-slate-500">Setiap sub-event punya pendaftarannya sendiri. Pilih salah satu untuk mengelolanya. Tabel di bawah menggabungkan semua peserta.</p>
                    </div>
                </div>

                <div className="grid gap-3">
                    {subs.map((c) => {
                        const ticket = c.method === 'ticket';
                        const Icon = ticket ? Ticket : ClipboardList;
                        return (
                            <Link key={c.id} href={`/panel/event/${c.id}/registrasi`} className={`${box} flex items-center gap-4 p-4 transition hover:-translate-y-0.5 hover:shadow-md`}>
                                <div className="flex size-10 shrink-0 items-center justify-center rounded-xl bg-indigo-100 text-indigo-600"><Icon className="size-5" /></div>
                                <div className="min-w-0 flex-1">
                                    <b className="block truncate">{c.title}</b>
                                    <span className="text-xs text-slate-500">{ticket ? 'Lewat tiket' : 'Lewat formulir'} · {c.fee > 0 ? rp(c.fee) : 'Gratis'}{!c.published && ' · belum terbit'}</span>
                                </div>
                                <div className="text-right">
                                    <div className="text-lg font-extrabold">{c.count}</div>
                                    <div className="text-[11px] font-semibold uppercase tracking-wider text-slate-500">peserta</div>
                                </div>
                                <ChevronRight className="size-5 text-slate-400" />
                            </Link>
                        );
                    })}
                </div>

                <div className={`${box} overflow-hidden`}>
                    <div className="flex flex-wrap items-center gap-3 p-5">
                        <h3 className="mr-auto text-lg font-extrabold">Daftar peserta gabungan <span className="text-sm font-semibold text-slate-500">({list.length})</span></h3>
                        <div className="relative">
                            <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
                            <input value={q} onChange={(e) => { setQ(e.target.value); setPage(1); }} placeholder="Cari ID, nama, sub-event" className={`${field} w-64 pl-9`} />
                        </div>
                        <select value={sub} onChange={(e) => { setSub(e.target.value); setPage(1); }} className={field}>
                            <option value="">Semua sub-event</option>
                            {subs.map((c) => <option key={c.id} value={String(c.id)}>{c.title}</option>)}
                        </select>
                        <select value={status} onChange={(e) => { setStatus(e.target.value); setPage(1); }} className={field}>
                            <option value="">Semua status</option>
                            {statuses.map((s) => <option key={s} value={s}>{STATUS[s]?.label ?? s}</option>)}
                        </select>
                    </div>

                    {view.length === 0 ? (
                        <p className="border-t border-slate-200 px-5 py-12 text-center text-sm font-semibold text-slate-500 dark:border-white/10">{rows.length === 0 ? 'Belum ada pendaftar di sub-event mana pun.' : 'Tidak ada data yang cocok.'}</p>
                    ) : (
                        <div className="overflow-x-auto border-t border-slate-200 dark:border-white/10">
                            <table className="w-full min-w-[820px] text-sm">
                                <thead className="bg-slate-50 dark:bg-white/5">
                                    <tr className="text-left text-xs font-extrabold uppercase tracking-wider text-slate-500">
                                        <th className="w-[210px] px-5 py-3">ID registrasi</th>
                                        <th className="px-3 py-3">Peserta</th>
                                        <th className="px-3 py-3">Sub-event</th>
                                        <th className="px-3 py-3">Jenis / kategori</th>
                                        <th className="w-[190px] px-3 py-3">Status</th>
                                    </tr>
                                </thead>
                                <tbody className="divide-y divide-slate-100 dark:divide-white/10">
                                    {view.map((r, i) => {
                                        const st = STATUS[r.status] ?? { label: r.status || '-', style: 'bg-slate-200 text-slate-700' };
                                        return (
                                            <tr key={`${r.sub_id}-${r.reg_id ?? 'x'}-${i}`} className="align-middle">
                                                <td className="px-5 py-3 font-mono text-[13px] font-bold text-indigo-700 dark:text-indigo-300">{r.reg_id ?? <span className="font-sans font-semibold text-slate-400">-</span>}</td>
                                                <td className="px-3 py-3 font-extrabold">{r.name}</td>
                                                <td className="px-3 py-3 font-semibold">{r.sub}</td>
                                                <td className="px-3 py-3"><span className="whitespace-nowrap rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-bold text-indigo-700 dark:bg-white/10 dark:text-indigo-200">{r.kind}</span></td>
                                                <td className="px-3 py-3"><span className={`whitespace-nowrap rounded-full px-3 py-1 text-xs font-bold ${st.style}`}>{st.label}</span></td>
                                            </tr>
                                        );
                                    })}
                                </tbody>
                            </table>
                        </div>
                    )}

                    {list.length > PER_PAGE && (
                        <div className="flex items-center justify-between gap-3 border-t border-slate-200 px-5 py-3 text-xs font-semibold text-slate-500 dark:border-white/10">
                            <span>{from}-{to} dari {list.length}</span>
                            <div className="flex items-center gap-2">
                                <button type="button" disabled={cur <= 1} onClick={() => setPage(cur - 1)} className="rounded-lg border border-slate-200 p-1.5 hover:bg-slate-50 disabled:opacity-40 dark:border-white/10 dark:hover:bg-white/5"><ChevronLeft className="h-4 w-4" /></button>
                                <span>Halaman {cur} / {pages}</span>
                                <button type="button" disabled={cur >= pages} onClick={() => setPage(cur + 1)} className="rounded-lg border border-slate-200 p-1.5 hover:bg-slate-50 disabled:opacity-40 dark:border-white/10 dark:hover:bg-white/5"><ChevronRight className="h-4 w-4" /></button>
                            </div>
                        </div>
                    )}
                </div>
            </div>
        </PanelLayout>
    );
}
