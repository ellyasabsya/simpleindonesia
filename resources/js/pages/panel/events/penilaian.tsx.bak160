import PanelLayout from '@/components/panel/panel-layout';
import { Link, router, usePage } from '@inertiajs/react';
import { ClipboardList, Copy, Check, Plus, RefreshCw, Trash2, Trophy, Users } from 'lucide-react';
import { useState } from 'react';

type Crit = { id: number | null; name: string; weight: number | string; max_score: number | string };
type Judge = { id: number; name: string; contact: string | null; active: boolean; url: string; done: number };
type Rank = { id: number; name: string; judges: number; final: number | null };
type Sub = { id: number; title: string; criteria: number; weight: number; judges: number; participants: number; enabled: boolean };
type Props = {
    event: { id: number };
    isParent: boolean;
    subs?: Sub[];
    settings?: { enabled: boolean };
    criteria?: Crit[];
    judges?: Judge[];
    participants?: number;
    ranking?: Rank[];
};

const card = 'rounded-3xl border border-white/70 bg-white/80 shadow-sm backdrop-blur dark:border-white/10 dark:bg-white/5';
const lbl = 'text-xs font-extrabold uppercase tracking-wider text-slate-600 dark:text-slate-300';
const inp = 'w-full rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30 dark:border-white/10 dark:bg-white/5';
const btn = 'rounded-2xl bg-indigo-900 px-5 py-3 text-sm font-extrabold text-white transition hover:bg-indigo-800 disabled:cursor-not-allowed disabled:opacity-50';

export default function Penilaian({ event, isParent, subs = [], settings = { enabled: false }, criteria = [], judges = [], participants = 0, ranking = [] }: Props) {
    const flash = (usePage().props as any).flash ?? {};
    const base = `/panel/event/${event.id}/penilaian`;
    const [tab, setTab] = useState<'nilai' | 'juri'>('nilai');
    const [rows, setRows] = useState<Crit[]>(criteria.length ? criteria : [{ id: null, name: '', weight: 100, max_score: 100 }]);
    const [err, setErr] = useState('');
    const [jName, setJName] = useState('');
    const [jContact, setJContact] = useState('');
    const [jErr, setJErr] = useState('');
    const [copied, setCopied] = useState('');

    const total = rows.reduce((a, r) => a + (Number(r.weight) || 0), 0);
    const valid = total === 100 && rows.every((r) => r.name.trim() !== '' && Number(r.max_score) >= 1 && Number(r.weight) >= 1);
    const setRow = (i: number, patch: Partial<Crit>) => setRows(rows.map((r, k) => (k === i ? { ...r, ...patch } : r)));
    const saveCriteria = () => {
        setErr('');
        router.put(`${base}/kriteria`, { criteria: rows.map((r) => ({ ...r, weight: Number(r.weight), max_score: Number(r.max_score) })) } as any, {
            preserveScroll: true,
            onError: (e) => setErr(String(Object.values(e)[0] ?? 'Gagal menyimpan.')),
        });
    };
    const toggle = () => router.post(`${base}/aktif`, { open: !settings.enabled }, { preserveScroll: true });
    const addJudge = () => {
        if (jName.trim() === '') return;
        router.post(`${base}/juri`, { name: jName, contact: jContact }, {
            preserveScroll: true,
            onSuccess: () => { setJName(''); setJContact(''); setJErr(''); },
            onError: (e) => setJErr(String(Object.values(e)[0] ?? 'Gagal menambah juri.')),
        });
    };
    const copy = (text: string, key: string) => { navigator.clipboard?.writeText(text).then(() => { setCopied(key); setTimeout(() => setCopied(''), 1600); }); };
    const resetLink = (j: Judge) => { if (confirm(`Buat link baru untuk "${j.name}"? Link lama tidak akan berlaku lagi.`)) router.post(`${base}/juri/${j.id}/link`, {}, { preserveScroll: true }); };
    const toggleJudge = (j: Judge) => router.put(`${base}/juri/${j.id}`, { name: j.name, contact: j.contact ?? '', active: !j.active }, { preserveScroll: true });
    const delJudge = (j: Judge) => { if (confirm(`Hapus juri "${j.name}"? Semua nilainya ikut terhapus.`)) router.delete(`${base}/juri/${j.id}`, { preserveScroll: true }); };

    const flashBox = (
        <>
            {flash.success && <p className="rounded-2xl bg-emerald-50 p-3 text-sm font-semibold text-emerald-800">{flash.success}</p>}
            {flash.error && <p className="rounded-2xl bg-rose-50 p-3 text-sm font-semibold text-rose-700">{flash.error}</p>}
        </>
    );

    if (isParent) {
        return (
            <PanelLayout title="Penilaian">
                <div className="space-y-5">
                    {flashBox}
                    <div className={`${card} p-6`}>
                        <h2 className="text-xl font-extrabold">Penilaian per sub-event</h2>
                        <p className="mt-1 text-sm text-slate-600 dark:text-slate-300">Kriteria dan juri diatur di tiap sub-event, karena peserta ada di sana. Halaman ini hanya ringkasan.</p>
                    </div>
                    <div className="grid gap-4 lg:grid-cols-2">
                        {subs.map((s) => (
                            <div key={s.id} className={`${card} flex flex-col gap-3 p-6`}>
                                <div className="flex items-start justify-between gap-3">
                                    <h3 className="text-lg font-extrabold">{s.title}</h3>
                                    <span className={`rounded-full px-2.5 py-1 text-xs font-bold ${s.enabled ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-200 text-slate-700'}`}>{s.enabled ? 'Dibuka' : 'Ditutup'}</span>
                                </div>
                                <div className="grid grid-cols-3 gap-2 text-center">
                                    <div className="rounded-xl bg-slate-50 py-2.5 dark:bg-white/5"><div className="text-xl font-extrabold">{s.criteria}</div><div className="text-[10px] font-bold uppercase tracking-wider text-slate-500">Kriteria</div></div>
                                    <div className="rounded-xl bg-slate-50 py-2.5 dark:bg-white/5"><div className="text-xl font-extrabold">{s.judges}</div><div className="text-[10px] font-bold uppercase tracking-wider text-slate-500">Juri</div></div>
                                    <div className="rounded-xl bg-slate-50 py-2.5 dark:bg-white/5"><div className="text-xl font-extrabold">{s.participants}</div><div className="text-[10px] font-bold uppercase tracking-wider text-slate-500">Peserta</div></div>
                                </div>
                                {s.criteria > 0 && s.weight !== 100 && <p className="text-xs font-bold text-amber-700">Total bobot {s.weight}%, belum 100%.</p>}
                                <Link href={`/panel/event/${s.id}/penilaian`} className="mt-auto inline-flex items-center justify-center rounded-xl bg-indigo-900 px-4 py-2.5 text-sm font-extrabold text-white hover:bg-indigo-800">Kelola</Link>
                            </div>
                        ))}
                    </div>
                </div>
            </PanelLayout>
        );
    }

    const activeJudges = judges.filter((j) => j.active).length;
    const tabs = [{ k: 'nilai', t: 'Pengaturan nilai', i: ClipboardList }, { k: 'juri', t: 'Juri', i: Users }] as const;

    return (
        <PanelLayout title="Penilaian">
            <div className="space-y-5">
                {flashBox}

                <div className={`${card} flex flex-wrap items-center justify-between gap-4 p-6`}>
                    <div>
                        <h2 className="text-xl font-extrabold">Penilaian {settings.enabled ? <span className="ml-2 rounded-full bg-emerald-100 px-2.5 py-1 align-middle text-xs font-bold text-emerald-800">Dibuka</span> : <span className="ml-2 rounded-full bg-slate-200 px-2.5 py-1 align-middle text-xs font-bold text-slate-700">Ditutup</span>}</h2>
                        <p className="mt-1 max-w-2xl text-sm text-slate-600 dark:text-slate-300">{settings.enabled ? 'Juri bisa mengisi nilai lewat link pribadinya. Tutup kapan saja untuk menghentikan input nilai.' : 'Juri belum bisa mengisi nilai. Lengkapi kriteria dan juri, lalu buka penilaian.'}</p>
                        <div className="mt-3 flex flex-wrap gap-2 text-xs font-bold">
                            <span className={`rounded-full px-2.5 py-1 ${criteria.length > 0 && criteria.reduce((a, c) => a + Number(c.weight), 0) === 100 ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}`}>{criteria.length > 0 && criteria.reduce((a, c) => a + Number(c.weight), 0) === 100 ? '✓ Bobot kriteria 100%' : '• Bobot kriteria belum 100%'}</span>
                            <span className={`rounded-full px-2.5 py-1 ${activeJudges > 0 ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}`}>{activeJudges > 0 ? `✓ ${activeJudges} juri aktif` : '• Belum ada juri aktif'}</span>
                            <span className={`rounded-full px-2.5 py-1 ${participants > 0 ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}`}>{participants > 0 ? `✓ ${participants} peserta dinilai` : '• Belum ada peserta terdaftar'}</span>
                        </div>
                    </div>
                    <button type="button" role="switch" aria-checked={settings.enabled} onClick={toggle} className={`relative h-8 w-14 rounded-full transition ${settings.enabled ? 'bg-emerald-500' : 'bg-slate-300 dark:bg-white/20'}`}>
                        <span className={`absolute top-1 h-6 w-6 rounded-full bg-white shadow transition-all ${settings.enabled ? 'left-7' : 'left-1'}`} />
                    </button>
                </div>

                <div className="flex flex-wrap gap-2">
                    {tabs.map(({ k, t, i: Icon }) => (
                        <button key={k} type="button" onClick={() => setTab(k)} className={`inline-flex items-center gap-2 rounded-2xl px-4 py-2.5 text-sm font-extrabold transition ${tab === k ? 'bg-indigo-900 text-white shadow' : 'border border-slate-200 bg-white/80 text-slate-700 hover:bg-white dark:border-white/10 dark:bg-white/5 dark:text-slate-200'}`}><Icon className="h-4 w-4" /> {t}</button>
                    ))}
                </div>

                {tab === 'nilai' && (
                    <>
                        <div className={`${card} space-y-4 p-6`}>
                            <div className="flex flex-wrap items-center justify-between gap-3">
                                <h3 className="flex items-center gap-2 text-xl font-extrabold"><ClipboardList className="h-5 w-5 text-indigo-600" /> Kriteria penilaian</h3>
                                <span className={`rounded-full px-3 py-1 text-xs font-extrabold ${total === 100 ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}`}>Total bobot {total}% {total === 100 ? '✓' : '(harus 100%)'}</span>
                            </div>
                            <p className="text-sm text-slate-600 dark:text-slate-300">Nilai akhir peserta = rata-rata semua juri. Skor tiap kriteria dihitung terhadap skor maksimumnya, lalu dikalikan bobot.</p>
                            <div className="hidden gap-3 sm:grid sm:grid-cols-[1fr_110px_130px_44px]"><span className={lbl}>Nama kriteria</span><span className={lbl}>Bobot (%)</span><span className={lbl}>Skor maksimum</span><span /></div>
                            {rows.map((r, i) => (
                                <div key={i} className="grid gap-3 sm:grid-cols-[1fr_110px_130px_44px]">
                                    <input className={inp} placeholder="Contoh: Vokal" maxLength={60} value={r.name} onChange={(e) => setRow(i, { name: e.target.value })} />
                                    <input className={inp} type="number" min={1} max={100} value={r.weight} onChange={(e) => setRow(i, { weight: e.target.value })} />
                                    <input className={inp} type="number" min={1} max={1000} value={r.max_score} onChange={(e) => setRow(i, { max_score: e.target.value })} />
                                    <button type="button" disabled={rows.length === 1} onClick={() => setRows(rows.filter((_, k) => k !== i))} className="flex h-[42px] w-11 items-center justify-center rounded-2xl text-rose-600 hover:bg-rose-50 disabled:opacity-30" aria-label="Hapus kriteria"><Trash2 className="h-4 w-4" /></button>
                                </div>
                            ))}
                            {err && <p className="text-sm font-semibold text-rose-700">{err}</p>}
                            <div className="flex flex-wrap gap-3">
                                <button type="button" disabled={rows.length >= 15} onClick={() => setRows([...rows, { id: null, name: '', weight: 0, max_score: 100 }])} className="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 text-sm font-extrabold text-slate-700 hover:bg-white disabled:opacity-50 dark:border-white/10 dark:bg-white/5 dark:text-slate-200"><Plus className="h-4 w-4" /> Tambah kriteria</button>
                                <button type="button" disabled={!valid} onClick={saveCriteria} className={btn}>Simpan kriteria</button>
                            </div>
                        </div>

                        <div className={`${card} p-6`}>
                            <h3 className="flex items-center gap-2 text-xl font-extrabold"><Trophy className="h-5 w-5 text-amber-500" /> Hasil sementara</h3>
                            {ranking.length === 0 ? (
                                <p className="mt-3 text-sm text-slate-600 dark:text-slate-300">Belum ada peserta terdaftar.</p>
                            ) : (
                                <div className="mt-4 overflow-x-auto">
                                    <table className="w-full text-left text-sm">
                                        <thead><tr className={lbl}><th className="py-2 pr-3">#</th><th className="py-2 pr-3">Peserta</th><th className="py-2 pr-3">Juri menilai</th><th className="py-2 text-right">Nilai akhir</th></tr></thead>
                                        <tbody>
                                            {ranking.map((r, i) => (
                                                <tr key={r.id} className="border-t border-slate-100 dark:border-white/10">
                                                    <td className="py-2.5 pr-3 font-extrabold">{r.final !== null ? i + 1 : '-'}</td>
                                                    <td className="py-2.5 pr-3 font-semibold">{r.name}</td>
                                                    <td className="py-2.5 pr-3">{r.judges} dari {activeJudges}</td>
                                                    <td className="py-2.5 text-right text-lg font-extrabold text-indigo-700">{r.final !== null ? r.final.toFixed(2) : '-'}</td>
                                                </tr>
                                            ))}
                                        </tbody>
                                    </table>
                                </div>
                            )}
                            <p className="mt-3 text-xs text-slate-500">Hanya nilai dari juri aktif yang sudah mengisi semua kriteria yang dihitung.</p>
                        </div>
                    </>
                )}

                {tab === 'juri' && (
                    <>
                        <div className={`${card} p-6`}>
                            <h3 className="flex items-center gap-2 text-xl font-extrabold"><Users className="h-5 w-5 text-indigo-600" /> Tambah juri</h3>
                            <div className="mt-4 grid gap-3 sm:grid-cols-[1fr_1fr_auto]">
                                <input className={inp} placeholder="Nama juri" maxLength={80} value={jName} onChange={(e) => setJName(e.target.value)} />
                                <input className={inp} placeholder="Kontak (opsional)" maxLength={80} value={jContact} onChange={(e) => setJContact(e.target.value)} />
                                <button type="button" disabled={jName.trim() === ''} onClick={addJudge} className={btn}>Tambah</button>
                            </div>
                            {jErr && <p className="mt-2 text-sm font-semibold text-rose-700">{jErr}</p>}
                        </div>

                        <div className={`${card} p-6`}>
                            <h3 className="text-xl font-extrabold">Daftar juri ({judges.length})</h3>
                            {judges.length === 0 ? (
                                <p className="mt-3 text-sm text-slate-600 dark:text-slate-300">Belum ada juri. Tambahkan juri di atas, lalu kirim link pribadinya.</p>
                            ) : (
                                <ul className="mt-4 space-y-3">
                                    {judges.map((j) => {
                                        const pct = participants ? Math.round((j.done / participants) * 100) : 0;
                                        return (
                                            <li key={j.id} className={`rounded-2xl border border-slate-100 p-4 dark:border-white/10 ${j.active ? '' : 'opacity-60'}`}>
                                                <div className="flex flex-wrap items-center justify-between gap-3">
                                                    <div className="min-w-0">
                                                        <div className="font-extrabold">{j.name} {!j.active && <span className="ml-1 rounded-full bg-slate-200 px-2 py-0.5 text-[11px] font-bold text-slate-700">Nonaktif</span>}</div>
                                                        {j.contact && <div className="text-xs text-slate-500">{j.contact}</div>}
                                                    </div>
                                                    <div className="flex flex-wrap gap-2">
                                                        <button type="button" onClick={() => copy(j.url, `j${j.id}`)} className="inline-flex items-center gap-1.5 rounded-xl bg-indigo-50 px-3 py-2 text-xs font-extrabold text-indigo-800 hover:bg-indigo-100">{copied === `j${j.id}` ? <Check className="h-3.5 w-3.5" /> : <Copy className="h-3.5 w-3.5" />} {copied === `j${j.id}` ? 'Tersalin' : 'Salin link'}</button>
                                                        <button type="button" onClick={() => resetLink(j)} className="inline-flex items-center gap-1.5 rounded-xl bg-slate-100 px-3 py-2 text-xs font-extrabold text-slate-700 hover:bg-slate-200"><RefreshCw className="h-3.5 w-3.5" /> Reset link</button>
                                                        <button type="button" onClick={() => toggleJudge(j)} className="rounded-xl bg-slate-100 px-3 py-2 text-xs font-extrabold text-slate-700 hover:bg-slate-200">{j.active ? 'Nonaktifkan' : 'Aktifkan'}</button>
                                                        <button type="button" onClick={() => delJudge(j)} className="rounded-xl p-2 text-rose-600 hover:bg-rose-50" aria-label="Hapus juri"><Trash2 className="h-4 w-4" /></button>
                                                    </div>
                                                </div>
                                                <div className="mt-3 flex items-center gap-3">
                                                    <div className="h-1.5 flex-1 overflow-hidden rounded-full bg-slate-200 dark:bg-white/10"><div className={`h-full rounded-full ${pct === 100 ? 'bg-emerald-500' : 'bg-gradient-to-r from-blue-600 to-violet-600'}`} style={{ width: `${pct}%` }} /></div>
                                                    <span className="text-xs font-bold text-slate-600 dark:text-slate-300">{j.done} dari {participants} peserta dinilai</span>
                                                </div>
                                            </li>
                                        );
                                    })}
                                </ul>
                            )}
                        </div>
                    </>
                )}
            </div>
        </PanelLayout>
    );
}
