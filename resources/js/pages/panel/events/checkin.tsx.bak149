import PanelLayout from '@/components/panel/panel-layout';
import TicketScanner, { type Result } from '@/components/panel/ticket-scanner';
import { UserCheck } from 'lucide-react';
import { useCallback, useState } from 'react';

type Item = { code: string; reg_id: string | null; name: string; type: string | null; buyer: string | null; at: string };
type Props = {
    eventId: number;
    summary: { total: number; checked_in: number };
    recent: Item[];
};

const card = 'rounded-3xl border border-white/70 bg-white/80 shadow-sm backdrop-blur dark:border-white/10 dark:bg-white/5';

export default function Checkin({ eventId, summary, recent: initial }: Props) {
    const [count, setCount] = useState(summary.checked_in);
    const [recent, setRecent] = useState<Item[]>(initial);

    const onIn = useCallback((r: Result) => {
        setCount((c) => c + 1);
        const item: Item = { code: r.code ?? '', reg_id: r.reg_id ?? null, name: r.name ?? '', type: r.type ?? null, buyer: r.buyer ?? null, at: r.at ?? '' };
        setRecent((l) => [item, ...l.filter((x) => x.code !== item.code)].slice(0, 30));
    }, []);

    const pct = summary.total > 0 ? Math.round((count / summary.total) * 100) : 0;

    return (
        <PanelLayout title="Check-in">
            <div className="space-y-5">
                <div className={`${card} p-6`}>
                    <div className="flex flex-wrap items-center gap-4">
                        <span className="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-600 to-violet-600 text-white"><UserCheck className="h-6 w-6" /></span>
                        <div className="mr-auto">
                            <div className="text-xs font-extrabold uppercase tracking-wider text-slate-500">Sudah hadir</div>
                            <div className="text-3xl font-extrabold">{count} <span className="text-lg font-semibold text-slate-500">/ {summary.total} tiket</span></div>
                        </div>
                        <div className="text-2xl font-extrabold text-indigo-700 dark:text-indigo-300">{pct}%</div>
                    </div>
                    <div className="mt-4 h-2.5 overflow-hidden rounded-full bg-slate-200 dark:bg-white/10">
                        <div className="h-full rounded-full bg-gradient-to-r from-indigo-600 to-violet-600 transition-all" style={{ width: `${pct}%` }} />
                    </div>
                </div>

                <div className="grid gap-5 lg:grid-cols-2">
                    <div className={`${card} p-5`}>
                        <TicketScanner eventId={eventId} inline onCheckedIn={onIn} />
                    </div>

                    <div className={`${card} overflow-hidden`}>
                        <h3 className="p-5 text-lg font-extrabold">Check-in terbaru <span className="text-sm font-semibold text-slate-500">({recent.length})</span></h3>
                        {recent.length === 0 ? (
                            <p className="border-t border-slate-200 px-5 py-12 text-center text-sm font-semibold text-slate-500 dark:border-white/10">Belum ada peserta yang check-in.</p>
                        ) : (
                            <ul className="divide-y divide-slate-100 border-t border-slate-200 dark:divide-white/10 dark:border-white/10">
                                {recent.map((r) => (
                                    <li key={r.code} className="flex items-start justify-between gap-3 px-5 py-3.5">
                                        <div className="min-w-0">
                                            <div className="truncate font-extrabold">{r.name}</div>
                                            <div className="font-mono text-xs font-bold text-indigo-700 dark:text-indigo-300">{r.reg_id ?? r.code}</div>
                                            {r.buyer && <div className="truncate text-xs text-slate-500">Pembeli: {r.buyer}</div>}
                                        </div>
                                        <div className="shrink-0 text-right">
                                            {r.type && <span className="whitespace-nowrap rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-bold text-indigo-700 dark:bg-white/10 dark:text-indigo-200">{r.type}</span>}
                                            <div className="mt-1 text-xs text-slate-500">{r.at}</div>
                                        </div>
                                    </li>
                                ))}
                            </ul>
                        )}
                    </div>
                </div>
            </div>
        </PanelLayout>
    );
}
