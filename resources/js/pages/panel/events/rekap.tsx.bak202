import { router, usePage } from '@inertiajs/react';
import { BarChart3, ChevronLeft, ChevronRight, Download, FileSpreadsheet, Loader2, Plus, X } from 'lucide-react';
import { useState } from 'react';

type Row = {
    rank: number | null; code: string; order?: number | null; judges_done: number;
    base: number | null; deduction: number; penalty: number; final: number | null;
    status: 'belum' | 'sebagian' | 'selesai';
};
type Penalty = { id: number; team: string; type: string; points: number; reason: string; status: string; created_at: string };
type Recap = {
    category: { id: number; name: string }; enabled: boolean; judge_need: number; scale: number; info: string;
    rows: Row[]; penalties: Penalty[];
};

const solid = 'rounded-3xl bg-white shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-white/10';
const h = 'text-lg font-black text-slate-900 dark:text-white';
const field = 'h-11 w-full rounded-2xl border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-900 placeholder:font-medium placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/15 dark:border-white/15 dark:bg-slate-950 dark:text-white';
const num = (v: number | null) => (v === null || v === undefined ? '-' : new Intl.NumberFormat('id-ID', { maximumFractionDigits: 4 }).format(v));
const TYPES = ['Teguran', 'Peringatan resmi', 'Pengurangan nilai', 'Konsekuensi khusus', 'Pembatalan hasil', 'Diskualifikasi'];

const statusStyle: Record<Row['status'], string> = {
    belum: 'bg-slate-100 text-slate-700 dark:bg-white/10 dark:text-slate-200',
    sebagian: 'bg-amber-100 text-amber-900',
    selesai: 'bg-emerald-100 text-emerald-900',
};
const statusText: Record<Row['status'], string> = { belum: 'Belum dinilai', sebagian: 'Sedang dinilai', selesai: 'Selesai' };

function RankBadge({ rank }: { rank: number | null }) {
    const tone = rank === 1 ? 'bg-amber-400 text-white' : rank === 2 ? 'bg-slate-400 text-white' : rank === 3 ? 'bg-orange-400 text-white' : 'bg-slate-100 text-slate-600 dark:bg-white/10 dark:text-slate-300';
    return <span className={`flex h-9 w-9 items-center justify-center rounded-full text-sm font-black ${tone}`}>{rank ?? '-'}</span>;
}

function PenaltyCard({ rec, base }: { rec: Recap; base: string }) {
    const [open, setOpen] = useState(false);
    const [busy, setBusy] = useState(false);
    const [team, setTeam] = useState('');
    const [type, setType] = useState(TYPES[0]);
    const [points, setPoints] = useState('');
    const [reason, setReason] = useState('');
    const [err, setErr] = useState<string | null>(null);

    const submit = () => {
        if (!team) return setErr('Pilih tim terlebih dulu.');
        if (reason.trim().length < 5) return setErr('Alasan wajib diisi dengan jelas.');
        setErr(null);
        setBusy(true);
        router.post(`${base}/penalti`, { category_id: rec.category.id, team, type, points: type === 'Pengurangan nilai' ? Number(points || 0) : 0, reason }, {
            preserveScroll: true,
            onSuccess: () => { setOpen(false); setTeam(''); setPoints(''); setReason(''); },
            onError: (e) => setErr((Object.values(e)[0] as string) || 'Gagal menyimpan penalti.'),
            onFinish: () => setBusy(false),
        });
    };

    return (
        <div className={`${solid} p-5 sm:p-6`}>
            <div className="flex flex-wrap items-start justify-between gap-4">
                <div className="min-w-0 max-w-2xl">
                    <h3 className={h}>Penalti</h3>
                    <p className="mt-0.5 text-sm text-slate-600 dark:text-slate-300">Dicatat panitia, diperiksa, lalu diputuskan lewat musyawarah panitia sebelum hasil ditetapkan. Setiap catatan wajib disertai alasan yang jelas.</p>
                </div>
                <button type="button" onClick={() => setOpen(!open)} className="inline-flex h-11 items-center gap-2 rounded-2xl bg-gradient-to-r from-blue-600 to-violet-600 px-5 text-sm font-extrabold text-white shadow-lg shadow-indigo-500/25 hover:opacity-95">
                    {open ? <X className="h-4 w-4" /> : <Plus className="h-4 w-4" />} {open ? 'Batal' : 'Catat penalti'}
                </button>
            </div>

            {open && (
                <div className="mt-4 space-y-3 rounded-2xl bg-slate-50 p-4 dark:bg-white/5">
                    <div className="grid gap-3 md:grid-cols-3">
                        <select value={team} onChange={(e) => setTeam(e.target.value)} className={field}>
                            <option value="">Pilih tim</option>
                            {rec.rows.map((r) => <option key={r.code} value={r.code}>{r.code}</option>)}
                        </select>
                        <select value={type} onChange={(e) => setType(e.target.value)} className={field}>
                            {TYPES.map((t) => <option key={t}>{t}</option>)}
                        </select>
                        {type === 'Pengurangan nilai' && <input type="number" min={0} value={points} onChange={(e) => setPoints(e.target.value)} placeholder="Poin pengurangan" className={field} />}
                    </div>
                    <textarea value={reason} onChange={(e) => setReason(e.target.value)} rows={3} placeholder="Alasan (wajib)" className="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm font-semibold text-slate-900 placeholder:font-medium placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/15 dark:border-white/15 dark:bg-slate-950 dark:text-white" />
                    {err && <p className="rounded-xl bg-rose-50 px-3 py-2 text-sm font-bold text-rose-800">{err}</p>}
                    <button type="button" disabled={busy} onClick={submit} className="inline-flex h-11 items-center gap-2 rounded-2xl bg-indigo-600 px-6 text-sm font-extrabold text-white hover:bg-indigo-700 disabled:opacity-60">
                        {busy && <Loader2 className="h-4 w-4 animate-spin" />} Simpan penalti
                    </button>
                </div>
            )}

            {rec.penalties.length === 0 ? (
                <p className="mt-4 text-sm text-slate-600 dark:text-slate-300">Belum ada penalti pada lomba ini.</p>
            ) : (
                <ul className="mt-4 space-y-2">
                    {rec.penalties.map((p) => (
                        <li key={p.id} className="rounded-2xl border border-slate-200 px-4 py-3 dark:border-white/10">
                            <div className="flex flex-wrap items-center justify-between gap-2">
                                <span className="font-extrabold text-slate-900 dark:text-white"><span className="font-mono text-sm text-indigo-700 dark:text-indigo-300">{p.team}</span> · {p.type}{p.points > 0 ? ` (−${num(p.points)})` : ''}</span>
                                <span className="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-extrabold text-slate-700 dark:bg-white/10 dark:text-slate-200">{p.status}</span>
                            </div>
                            <p className="mt-1 text-sm text-slate-700 dark:text-slate-200">{p.reason}</p>
                            <p className="mt-1 text-xs text-slate-500">{p.created_at}</p>
                        </li>
                    ))}
                </ul>
            )}
        </div>
    );
}

export default function Rekap() {
    const page = usePage().props as any;
    const base: string = page.inviteBase;
    const recaps: Recap[] = page.recap ?? [];
    const [idx, setIdx] = useState(Math.max(0, recaps.findIndex((r) => r.category.id === page.category?.id)));

    if (recaps.length === 0) {
        return (
            <div className={`${solid} p-8 text-center`}>
                <BarChart3 className="mx-auto h-8 w-8 text-indigo-600" />
                <p className="mt-3 font-extrabold text-slate-900 dark:text-white">Data rekap belum tersedia</p>
            </div>
        );
    }

    const i = Math.min(idx, recaps.length - 1);
    const rec = recaps[i];
    const approved = recaps.filter((r) => r.enabled).length;
    const pct = Math.round((approved / recaps.length) * 100);
    const q = `?kategori=${rec.category.id}`;
    const go = (n: number) => setIdx((n + recaps.length) % recaps.length);

    return (
        <div className="space-y-5">
            <div className={`${solid} p-5 sm:p-6`}>
                <div className="flex flex-wrap items-start justify-between gap-4">
                    <div className="min-w-[14rem]">
                        <h3 className={h}>Rekap nilai per lomba</h3>
                        <div className="mt-2 flex items-center gap-3">
                            <span className="h-2.5 w-40 overflow-hidden rounded-full bg-slate-200 dark:bg-white/10"><span className="block h-full rounded-full bg-gradient-to-r from-emerald-400 to-emerald-600" style={{ width: `${pct}%` }} /></span>
                            <span className="text-sm font-extrabold text-slate-600 dark:text-slate-300">{approved}/{recaps.length} disahkan</span>
                        </div>
                    </div>
                    <div className="flex flex-wrap gap-2">
                        <a href={`${base}/rekap/lembar${q}`} className="inline-flex h-11 items-center gap-2 rounded-2xl bg-gradient-to-r from-blue-600 to-violet-600 px-5 text-sm font-extrabold text-white shadow-lg shadow-indigo-500/25"><Download className="h-4 w-4" /> Unduh lembar manual</a>
                        <a href={`${base}/rekap/excel${q}`} className="inline-flex h-11 items-center gap-2 rounded-2xl border border-slate-200 bg-white px-5 text-sm font-extrabold text-slate-800 hover:bg-slate-50 dark:border-white/10 dark:bg-white/5 dark:text-slate-100"><FileSpreadsheet className="h-4 w-4" /> Unduh Excel hitung nilai</a>
                    </div>
                </div>

                <div className="mt-5 flex items-center gap-2 border-b border-slate-100 pb-5 dark:border-white/10">
                    <button type="button" onClick={() => go(i - 1)} disabled={recaps.length < 2} aria-label="Sebelumnya" className="flex h-11 w-11 items-center justify-center rounded-2xl border border-slate-200 text-slate-600 hover:bg-slate-50 disabled:opacity-40 dark:border-white/10"><ChevronLeft className="h-4 w-4" /></button>
                    <select value={i} onChange={(e) => setIdx(Number(e.target.value))} className={`${field} flex-1 !h-11 font-extrabold`}>
                        {recaps.map((r, k) => <option key={r.category.id} value={k}>{r.enabled ? '● ' : '○ '}{r.category.name} ({r.enabled ? 'disahkan' : 'belum disahkan'})</option>)}
                    </select>
                    <button type="button" onClick={() => go(i + 1)} disabled={recaps.length < 2} aria-label="Berikutnya" className="flex h-11 w-11 items-center justify-center rounded-2xl border border-slate-200 text-slate-600 hover:bg-slate-50 disabled:opacity-40 dark:border-white/10"><ChevronRight className="h-4 w-4" /></button>
                    <span className="w-12 text-right text-sm font-extrabold text-slate-500">{i + 1}/{recaps.length}</span>
                </div>

                {!rec.enabled && <p className="mt-4 rounded-2xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm font-bold text-amber-900 dark:bg-amber-400/10 dark:text-amber-200">Penilaian kategori {rec.category.name} belum disahkan. Nilai di bawah masih bersifat sementara.</p>}

                <p className="mt-4 rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-700 dark:bg-white/5 dark:text-slate-200">{rec.info}</p>

                <div className="mt-4 overflow-x-auto">
                    <table className="w-full min-w-[760px] text-left text-sm">
                        <thead>
                            <tr className="border-b border-slate-200 text-[11px] font-extrabold uppercase tracking-wider text-slate-500 dark:border-white/10 dark:text-slate-400">
                                <th className="py-3 pr-3">#</th><th className="py-3 pr-3">Tim</th><th className="py-3 pr-3">Juri</th>
                                <th className="py-3 pr-3 text-right">Nilai dasar</th><th className="py-3 pr-3 text-right">Pengurangan</th>
                                <th className="py-3 pr-3 text-right">Penalti</th><th className="py-3 pr-3 text-right">Nilai akhir</th><th className="py-3">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {rec.rows.length === 0 && <tr><td colSpan={8} className="py-8 text-center text-slate-600 dark:text-slate-300">Belum ada peserta terdaftar.</td></tr>}
                            {rec.rows.map((r, k) => (
                                <tr key={r.code} className={k % 2 ? 'bg-slate-50/70 dark:bg-white/[0.03]' : ''}>
                                    <td className="py-3 pr-3 pl-1"><RankBadge rank={r.rank} /></td>
                                    <td className="py-3 pr-3">
                                        <span className="rounded-lg bg-indigo-50 px-2 py-1 font-mono text-xs font-bold text-indigo-800 dark:bg-indigo-500/15 dark:text-indigo-200">{r.code}</span>
                                        {r.order != null && <span className="ml-2 font-black text-slate-900 dark:text-white">#{r.order}</span>}
                                    </td>
                                    <td className="py-3 pr-3">
                                        <div className="flex items-center gap-2">
                                            <span className="h-1.5 w-24 overflow-hidden rounded-full bg-slate-200 dark:bg-white/10"><span className="block h-full rounded-full bg-indigo-500" style={{ width: `${rec.judge_need ? Math.min(100, (r.judges_done / rec.judge_need) * 100) : 0}%` }} /></span>
                                            <span className="text-xs font-bold text-slate-600 dark:text-slate-300">{r.judges_done}/{rec.judge_need}</span>
                                        </div>
                                    </td>
                                    <td className="py-3 pr-3 text-right font-semibold text-slate-800 dark:text-slate-100">{num(r.base)}</td>
                                    <td className="py-3 pr-3 text-right font-semibold text-slate-800 dark:text-slate-100">{num(r.deduction)}</td>
                                    <td className="py-3 pr-3 text-right font-semibold text-slate-800 dark:text-slate-100">{num(r.penalty)}</td>
                                    <td className="py-3 pr-3 text-right text-base font-black text-slate-900 dark:text-white">{num(r.final)}</td>
                                    <td className="py-3"><span className={`rounded-full px-3 py-1 text-xs font-extrabold ${statusStyle[r.status]}`}>{statusText[r.status]}</span></td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>

            <PenaltyCard key={rec.category.id} rec={rec} base={base} />
        </div>
    );
}
