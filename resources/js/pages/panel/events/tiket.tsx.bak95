import PanelLayout from '@/components/panel/panel-layout';
import { router, useForm, usePage } from '@inertiajs/react';
import { Lock, Pencil, Plus, Trash2 } from 'lucide-react';
import { useState } from 'react';

type T = {
    id: number; name: string; price: number; quota: number; valid_from: string; valid_until: string; max_per_order: number;
    sold: number; remaining: number; revenue: number; locked: boolean;
};
type Props = { eventId: number; salesOpen: boolean; feePercent: number; types: T[] };

const rp = (n: number) => `Rp${new Intl.NumberFormat('id-ID').format(n)}`;
const card = 'rounded-3xl border border-white/70 bg-white/80 shadow-sm backdrop-blur dark:border-white/10 dark:bg-white/5';
const lbl = 'text-xs font-extrabold uppercase tracking-wider text-slate-600 dark:text-slate-300';
const inp = 'mt-1.5 w-full rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30 disabled:bg-slate-100 disabled:text-slate-500 dark:border-white/10 dark:bg-white/5';
const btn = 'rounded-2xl bg-indigo-900 px-5 py-3 text-sm font-extrabold text-white transition hover:bg-indigo-800 disabled:cursor-not-allowed disabled:opacity-60';

export default function Tiket({ eventId, salesOpen, feePercent, types }: Props) {
    const pg = usePage().props as any;
    const flash = pg.flash ?? {};
    const evEnd: string = pg.event?.ends_at ?? '';
    const today = new Date().toISOString().slice(0, 10);

    const [editing, setEditing] = useState<T | 'new' | null>(null);
    const form = useForm({ name: '', price: '', quota: '', valid_from: today, valid_until: evEnd || today, max_per_order: '10' });

    const base = `/panel/event/${eventId}/tiket`;
    const locked = editing !== null && editing !== 'new' && editing.locked;

    const openNew = () => { form.clearErrors(); form.setData({ name: '', price: '', quota: '', valid_from: today, valid_until: evEnd || today, max_per_order: '10' }); setEditing('new'); };
    const openEdit = (t: T) => {
        form.clearErrors();
        form.setData({ name: t.name, price: String(t.price), quota: String(t.quota), valid_from: t.valid_from, valid_until: t.valid_until, max_per_order: String(t.max_per_order) });
        setEditing(t);
    };
    const close = () => { setEditing(null); form.clearErrors(); };

    const submit = (e: React.FormEvent) => {
        e.preventDefault();
        const opts = { preserveScroll: true, onSuccess: close };
        if (editing === 'new') form.post(`${base}/jenis`, opts);
        else if (editing) form.put(`${base}/jenis/${editing.id}`, opts);
    };

    const toggle = () => router.post(`${base}/jual`, { open: !salesOpen }, { preserveScroll: true });
    const remove = (t: T) => { if (confirm(`Hapus jenis tiket "${t.name}"?`)) router.delete(`${base}/jenis/${t.id}`, { preserveScroll: true }); };

    const err = (k: keyof typeof form.data) => form.errors[k] && <p className="mt-1 text-xs text-rose-600">{form.errors[k]}</p>;
    const totalSold = types.reduce((a, t) => a + t.sold, 0);
    const totalRevenue = types.reduce((a, t) => a + t.revenue, 0);

    return (
        <PanelLayout title="Tiket">
            <div className="space-y-5">
                {flash.success && <p className="rounded-2xl bg-emerald-50 p-3 text-sm font-semibold text-emerald-800">{flash.success}</p>}
                {flash.error && <p className="rounded-2xl bg-rose-50 p-3 text-sm font-semibold text-rose-700">{flash.error}</p>}

                <div className={`${card} flex flex-wrap items-center justify-between gap-4 p-6`}>
                    <div>
                        <h2 className="text-xl font-extrabold">Penjualan tiket {salesOpen ? <span className="ml-2 rounded-full bg-emerald-100 px-2.5 py-1 align-middle text-xs font-bold text-emerald-800">Dibuka</span> : <span className="ml-2 rounded-full bg-slate-200 px-2.5 py-1 align-middle text-xs font-bold text-slate-700">Ditutup</span>}</h2>
                        <p className="mt-1 max-w-2xl text-sm text-slate-600 dark:text-slate-300">{salesOpen ? 'Pengunjung bisa membeli tiket sekarang. Tutup penjualan kalau kuota habis atau acara sudah dekat.' : 'Pengunjung tidak bisa membeli tiket. Buka kembali kapan saja.'}</p>
                    </div>
                    <button type="button" role="switch" aria-checked={salesOpen} onClick={toggle} className={`relative h-8 w-14 rounded-full transition ${salesOpen ? 'bg-emerald-500' : 'bg-slate-300 dark:bg-white/20'}`}>
                        <span className={`absolute top-1 h-6 w-6 rounded-full bg-white shadow transition-all ${salesOpen ? 'left-7' : 'left-1'}`} />
                    </button>
                </div>

                <div className="grid gap-4 sm:grid-cols-3">
                    <div className={`${card} p-5`}><div className={lbl}>Jenis tiket</div><div className="mt-2 text-3xl font-extrabold">{types.length}</div></div>
                    <div className={`${card} p-5`}><div className={lbl}>Tiket terpakai</div><div className="mt-2 text-3xl font-extrabold">{totalSold}</div></div>
                    <div className={`${card} p-5`}><div className={lbl}>Penjualan lunas</div><div className="mt-2 text-3xl font-extrabold text-indigo-700">{rp(totalRevenue)}</div></div>
                </div>

                <div className={`${card} p-6`}>
                    <div className="flex flex-wrap items-center justify-between gap-3">
                        <h3 className="text-xl font-extrabold">Jenis tiket</h3>
                        <button type="button" onClick={openNew} className={`${btn} inline-flex items-center gap-2 !py-2.5`}><Plus className="h-4 w-4" /> Tambah jenis</button>
                    </div>
                    <div className="mt-4 grid gap-4 md:grid-cols-2">
                        {types.map((t) => {
                            const pct = t.quota > 0 ? Math.min(100, Math.round((t.sold / t.quota) * 100)) : 0;
                            return (
                                <div key={t.id} className="rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-white/5">
                                    <div className="flex items-start justify-between gap-3">
                                        <div>
                                            <div className="text-lg font-extrabold">{t.name}</div>
                                            <div className="text-2xl font-extrabold text-indigo-600 dark:text-indigo-300">{rp(t.price)}</div>
                                        </div>
                                        <div className="flex gap-1">
                                            <button type="button" aria-label="Ubah" onClick={() => openEdit(t)} className="flex h-9 w-9 items-center justify-center rounded-xl text-slate-500 hover:bg-slate-100 dark:hover:bg-white/10"><Pencil className="h-4 w-4" /></button>
                                            <button type="button" aria-label="Hapus" disabled={t.locked} title={t.locked ? 'Sudah ada pesanan' : 'Hapus'} onClick={() => remove(t)} className="flex h-9 w-9 items-center justify-center rounded-xl text-rose-500 hover:bg-rose-50 disabled:cursor-not-allowed disabled:opacity-30 dark:hover:bg-rose-500/10"><Trash2 className="h-4 w-4" /></button>
                                        </div>
                                    </div>
                                    <div className="mt-3 h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-white/10"><div className="h-full rounded-full bg-indigo-500" style={{ width: `${pct}%` }} /></div>
                                    <div className="mt-2 flex justify-between text-xs text-slate-600 dark:text-slate-300"><span>Terpakai {t.sold} dari {t.quota}</span><span>Sisa {t.remaining}</span></div>
                                    <dl className="mt-3 space-y-1 text-xs text-slate-500">
                                        <div className="flex justify-between"><dt>Berlaku</dt><dd className="font-semibold text-slate-700 dark:text-slate-200">{t.valid_from} s/d {t.valid_until}</dd></div>
                                        <div className="flex justify-between"><dt>Maks. per pesanan</dt><dd className="font-semibold text-slate-700 dark:text-slate-200">{t.max_per_order} tiket</dd></div>
                                        <div className="flex justify-between"><dt>Penjualan lunas</dt><dd className="font-semibold text-slate-700 dark:text-slate-200">{rp(t.revenue)}</dd></div>
                                    </dl>
                                    {t.locked && <p className="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500"><Lock className="h-3.5 w-3.5" /> Harga terkunci karena sudah ada pesanan</p>}
                                </div>
                            );
                        })}
                    </div>
                </div>

                <p className="rounded-2xl bg-sky-50 p-4 text-xs text-sky-900 dark:bg-sky-500/10 dark:text-sky-200">Biaya layanan {feePercent}% dibayar pembeli di atas harga tiket dan tidak mengurangi hak lembaga. Bagi hasil platform dihitung dari penjualan tiket.</p>
            </div>

            {editing && (
                <div className="fixed inset-0 z-[9999] flex items-center justify-center bg-slate-900/70 p-4" onClick={close}>
                    <form onSubmit={submit} className="max-h-[92vh] w-full max-w-lg overflow-y-auto rounded-3xl bg-white p-6 shadow-2xl dark:bg-slate-900" onClick={(e) => e.stopPropagation()}>
                        <h3 className="text-lg font-extrabold">{editing === 'new' ? 'Tambah jenis tiket' : `Ubah ${editing.name}`}</h3>
                        <label className="mt-4 block"><span className={lbl}>Nama jenis</span>
                            <input value={form.data.name} onChange={(e) => form.setData('name', e.target.value)} placeholder="Contoh: Reguler, VIP" className={inp} />{err('name')}
                        </label>
                        <div className="mt-4 grid gap-4 sm:grid-cols-2">
                            <label className="block"><span className={lbl}>Harga (Rp)</span>
                                <input type="number" inputMode="numeric" min={1000} disabled={locked} value={form.data.price} onChange={(e) => form.setData('price', e.target.value)} className={inp} />
                                {locked && <span className="mt-1 block text-xs text-slate-500">Terkunci, sudah ada pesanan.</span>}{err('price')}
                            </label>
                            <label className="block"><span className={lbl}>Kuota</span>
                                <input type="number" inputMode="numeric" min={1} value={form.data.quota} onChange={(e) => form.setData('quota', e.target.value)} className={inp} />{err('quota')}
                            </label>
                            <label className="block"><span className={lbl}>Berlaku dari</span>
                                <input type="date" value={form.data.valid_from} onChange={(e) => form.setData('valid_from', e.target.value)} className={inp} />{err('valid_from')}
                            </label>
                            <label className="block"><span className={lbl}>Berlaku sampai</span>
                                <input type="date" value={form.data.valid_until} onChange={(e) => form.setData('valid_until', e.target.value)} className={inp} />{err('valid_until')}
                            </label>
                        </div>
                        <label className="mt-4 block"><span className={lbl}>Maksimal tiket per pesanan (1-10)</span>
                            <input type="number" inputMode="numeric" min={1} max={10} value={form.data.max_per_order} onChange={(e) => form.setData('max_per_order', e.target.value)} className={inp} />{err('max_per_order')}
                        </label>
                        <div className="mt-6 flex justify-end gap-2">
                            <button type="button" onClick={close} className="rounded-2xl border border-slate-200 px-5 py-3 text-sm font-bold dark:border-white/10">Batal</button>
                            <button type="submit" disabled={form.processing} className={btn}>{form.processing ? 'Menyimpan…' : 'Simpan'}</button>
                        </div>
                    </form>
                </div>
            )}
        </PanelLayout>
    );
}
