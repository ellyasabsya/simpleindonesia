import { Link, usePage } from '@inertiajs/react';
import { CalendarDays, Gavel, History, Trophy, type LucideIcon } from 'lucide-react';
import { useState } from 'react';
import UserLayout from '@/components/user/user-layout';

type Role = 'peserta' | 'penyelenggara' | 'juri';
type Item = { id: number | string; role: Role; title: string; subtitle?: string | null; date: string; status?: string | null; href?: string };
type Props = { history?: Item[] };

const roles: Record<Role, { label: string; verb: string; icon: LucideIcon; grad: string; soft: string; text: string }> = {
    peserta: { label: 'Peserta', verb: 'Event yang diikuti', icon: Trophy, grad: 'from-pink-500 to-rose-500', soft: 'bg-rose-50 dark:bg-rose-500/15', text: 'text-rose-600 dark:text-rose-300' },
    penyelenggara: { label: 'Penyelenggara', verb: 'Event yang diselenggarakan', icon: CalendarDays, grad: 'from-blue-600 to-violet-600', soft: 'bg-indigo-50 dark:bg-indigo-500/15', text: 'text-indigo-700 dark:text-indigo-300' },
    juri: { label: 'Juri', verb: 'Event yang dinilai', icon: Gavel, grad: 'from-amber-400 to-orange-500', soft: 'bg-amber-50 dark:bg-amber-500/15', text: 'text-amber-700 dark:text-amber-300' },
};

const demo: Item[] = [
    { id: 1, role: 'peserta', title: 'Batam Bernyanyi 2026', subtitle: 'Lomba vokal · Ballroom Hotel Pacific', date: '2026-11-17', status: 'Juara 2' },
    { id: 2, role: 'penyelenggara', title: 'Festival Kuliner Kepri', subtitle: 'Lembaga Seni Batam', date: '2026-09-05', status: 'Tayang' },
    { id: 3, role: 'juri', title: 'Kontes Fotografi Kota', subtitle: 'Menilai 24 peserta', date: '2026-03-20', status: 'Selesai' },
    { id: 4, role: 'peserta', title: 'Lomba Desain Poster', subtitle: 'Kategori umum', date: '2025-10-12', status: 'Finalis' },
];

const fmt = (d: string) => new Date(d).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
const card = 'rounded-3xl border border-white/70 bg-white/80 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-900/60';

export default function Dashboard({ history = [] }: Props) {
    const user = (usePage().props as any).auth?.user ?? {};
    const name: string = user.name ?? '';
    const initials = name.split(' ').map((w: string) => w[0]).slice(0, 2).join('').toUpperCase() || '?';
    const joined = user.created_at ? new Date(user.created_at).toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }) : null;
    const [filter, setFilter] = useState<Role | 'semua'>('semua');
    const useDemo = typeof window !== 'undefined' && history.length === 0 && new URLSearchParams(window.location.search).has('demo');
    const all = [...(useDemo ? demo : history)].sort((a, b) => b.date.localeCompare(a.date));
    const shown = filter === 'semua' ? all : all.filter((i) => i.role === filter);
    const count = (r: Role) => all.filter((i) => i.role === r).length;
    const years = [...new Set(shown.map((i) => i.date.slice(0, 4)))];

    return (
        <UserLayout title="Dashboard" hasPanel>
            <section className={`${card} overflow-hidden`}>
                <div className="relative h-32 overflow-hidden bg-gradient-to-r from-indigo-800 via-blue-600 to-fuchsia-500 sm:h-40">
                    <span className="absolute -right-10 -top-16 h-56 w-56 rounded-full bg-white/15 blur-2xl" />
                    <span className="absolute bottom-[-4rem] left-1/3 h-48 w-48 rounded-full bg-pink-300/30 blur-3xl" />
                </div>
                <div className="px-6 pb-6 sm:px-8">
                    <div className="-mt-12 flex flex-wrap items-end justify-between gap-4">
                        {user.avatar ? (
                            <img src={user.avatar} alt={name} className="h-24 w-24 rounded-3xl object-cover shadow-xl ring-4 ring-white dark:ring-slate-900" />
                        ) : (
                            <span className="flex h-24 w-24 items-center justify-center rounded-3xl bg-gradient-to-br from-blue-600 to-violet-600 text-3xl font-extrabold text-white shadow-xl ring-4 ring-white dark:ring-slate-900">{initials}</span>
                        )}
                        <div className="flex gap-2">
                            <Link href="/panel" className="rounded-xl bg-slate-100 px-5 py-2.5 text-sm font-bold hover:bg-slate-200 dark:bg-white/10 dark:hover:bg-white/20">Panel lembaga</Link>
                            <Link href="/settings/profile" className="rounded-xl bg-gradient-to-r from-indigo-800 via-blue-600 to-violet-600 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-indigo-600/25">Edit profil</Link>
                        </div>
                    </div>
                    <h1 className="mt-4 text-3xl font-extrabold"><span className="title-gradient">{name}</span></h1>
                    <div className="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-500 dark:text-slate-400">
                        {user.email && <span>{user.email}</span>}
                        {joined && <span>Bergabung sejak {joined}</span>}
                    </div>

                    <div className="mt-6 grid divide-y divide-slate-200/70 overflow-hidden rounded-2xl border border-slate-200 bg-white/60 dark:divide-white/10 dark:border-white/10 dark:bg-white/5 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
                        {(Object.keys(roles) as Role[]).map((r) => {
                            const c = roles[r]; const Icon = c.icon; const on = filter === r;
                            return (
                                <button key={r} onClick={() => setFilter(on ? 'semua' : r)} className={`flex items-center gap-4 p-4 text-left transition hover:bg-white dark:hover:bg-white/10 ${on ? 'bg-white dark:bg-white/10' : ''}`}>
                                    <span className={`flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br ${c.grad} text-white shadow-md`}><Icon className="h-5 w-5" /></span>
                                    <span>
                                        <span className="block text-2xl font-extrabold leading-none">{count(r)}</span>
                                        <span className="mt-1 block text-sm font-bold">{c.label}</span>
                                        <span className="block text-xs text-slate-500 dark:text-slate-400">{c.verb}</span>
                                    </span>
                                </button>
                            );
                        })}
                    </div>
                </div>
            </section>

            <section className={`${card} p-6`}>
                <div className="mb-6 flex flex-wrap items-center justify-between gap-3">
                    <h2 className="flex items-center gap-2 text-2xl font-extrabold"><History className="h-6 w-6 text-indigo-600" /> Riwayat</h2>
                    <div className="flex gap-1 rounded-2xl bg-slate-100 p-1 dark:bg-white/10">
                        {(['semua', 'peserta', 'penyelenggara', 'juri'] as const).map((f) => (
                            <button key={f} onClick={() => setFilter(f)} className={`rounded-xl px-4 py-2 text-sm font-bold capitalize transition ${filter === f ? 'bg-white text-indigo-700 shadow-sm dark:bg-slate-800 dark:text-white' : 'text-slate-500'}`}>
                                {f === 'semua' ? 'Semua' : roles[f].label}
                            </button>
                        ))}
                    </div>
                </div>

                {shown.length === 0 ? (
                    <div className="flex flex-col items-center gap-3 rounded-2xl border border-dashed border-slate-300 py-14 text-center dark:border-white/15">
                        <span className="flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 dark:bg-white/10"><History className="h-6 w-6 text-indigo-500" /></span>
                        <p className="text-lg font-extrabold">Belum ada riwayat</p>
                        <p className="max-w-sm text-sm text-slate-500 dark:text-slate-400">Event yang Anda ikuti, selenggarakan, atau nilai akan muncul di sini.</p>
                        <Link href="/panel/ajukan" className="mt-2 rounded-xl bg-gradient-to-r from-indigo-800 via-blue-600 to-violet-600 px-6 py-3 text-sm font-bold text-white shadow-md">Ajukan event</Link>
                    </div>
                ) : (
                    years.map((y) => (
                        <div key={y} className="mb-6 last:mb-0">
                            <p className="mb-3 text-sm font-extrabold tracking-widest text-slate-400">{y}</p>
                            <ol className="relative ml-5 space-y-4 border-l-2 border-slate-200 pl-8 dark:border-white/10">
                                {shown.filter((i) => i.date.startsWith(y)).map((i) => {
                                    const c = roles[i.role]; const Icon = c.icon;
                                    const body = (
                                        <>
                                            <span className={`absolute -left-[3.2rem] flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br ${c.grad} text-white shadow-md ring-4 ring-white dark:ring-slate-900`}><Icon className="h-5 w-5" /></span>
                                            <div className="flex flex-wrap items-center justify-between gap-3">
                                                <div className="min-w-0">
                                                    <span className={`inline-block rounded-lg px-2.5 py-0.5 text-xs font-extrabold ${c.soft} ${c.text}`}>{c.label}</span>
                                                    <p className="mt-1.5 truncate text-lg font-extrabold">{i.title}</p>
                                                    {i.subtitle && <p className="text-sm text-slate-500 dark:text-slate-400">{i.subtitle}</p>}
                                                </div>
                                                <div className="text-right">
                                                    <p className="text-sm font-semibold text-slate-500 dark:text-slate-400">{fmt(i.date)}</p>
                                                    {i.status && <span className="mt-1 inline-block rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300">{i.status}</span>}
                                                </div>
                                            </div>
                                        </>
                                    );
                                    const cls = 'relative block rounded-2xl border border-slate-200 bg-white/70 p-4 transition hover:border-indigo-200 hover:shadow-sm dark:border-white/10 dark:bg-white/5';
                                    return <li key={`${i.role}-${i.id}`}>{i.href ? <Link href={i.href} className={cls}>{body}</Link> : <div className={cls}>{body}</div>}</li>;
                                })}
                            </ol>
                        </div>
                    ))
                )}
            </section>
        </UserLayout>
    );
}
