import { Head, Link, usePage } from '@inertiajs/react';
import { ArrowLeft, ArrowRight, Check, Crown, Megaphone, Package as PackageIcon, Percent, Rocket, ThumbsUp, Ticket } from 'lucide-react';
import type { ComponentType } from 'react';
import Footer from '@/components/landing/footer';
import Navbar from '@/components/landing/navbar';
import PageBackground from '@/components/page-background';

type PackageCard = {
    id: number;
    name: string;
    slug: string;
    tagline: string | null;
    price: { main: string; note: string };
    specs: [string, string][];
    extends: string | null;
    features: string[];
    featured: boolean;
    join_url: string;
};

type Theme = {
    icon: ComponentType<{ className?: string }>;
    badge: string;
    desc: string;
    card: string;
    iconBox: string;
    pill: string;
    eyebrow: string;
    bar: string;
    check: string;
    btn: string;
};

const themes: Record<string, Theme> = {
    iklan: {
        icon: Megaphone,
        badge: 'Iklan',
        desc: 'Tampilkan event Anda di halaman utama dan kelola pendaftarannya.',
        card: 'border-emerald-200/80 from-emerald-50/80 dark:border-emerald-400/20 dark:from-emerald-500/10',
        iconBox: 'bg-emerald-100 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-300',
        pill: 'bg-emerald-50 text-emerald-700 ring-emerald-200 dark:bg-emerald-500/15 dark:text-emerald-200 dark:ring-emerald-400/20',
        eyebrow: 'text-emerald-600 dark:text-emerald-300',
        bar: 'bg-emerald-400',
        check: 'bg-emerald-500',
        btn: 'bg-emerald-600 hover:bg-emerald-500 hover:shadow-emerald-400/40',
    },
    starter: {
        icon: Rocket,
        badge: 'Starter',
        desc: 'Untuk program kecil yang butuh check-in QR dan laporan gabungan.',
        card: 'border-sky-200/80 from-sky-50/80 dark:border-sky-400/20 dark:from-sky-500/10',
        iconBox: 'bg-sky-100 text-sky-600 dark:bg-sky-500/20 dark:text-sky-300',
        pill: 'bg-sky-50 text-sky-700 ring-sky-200 dark:bg-sky-500/15 dark:text-sky-200 dark:ring-sky-400/20',
        eyebrow: 'text-sky-600 dark:text-sky-300',
        bar: 'bg-sky-400',
        check: 'bg-sky-500',
        btn: 'bg-sky-600 hover:bg-sky-500 hover:shadow-sky-400/40',
    },
    professional: {
        icon: Crown,
        badge: 'Professional',
        desc: 'Operasional lengkap untuk series kegiatan, dari tiket sampai penilaian juri.',
        card: 'border-amber-300/80 from-amber-50/90 dark:border-amber-400/30 dark:from-amber-500/10',
        iconBox: 'bg-amber-100 text-amber-600 dark:bg-amber-500/20 dark:text-amber-300',
        pill: 'bg-amber-50 text-amber-700 ring-amber-200 dark:bg-amber-500/15 dark:text-amber-200 dark:ring-amber-400/20',
        eyebrow: 'text-amber-600 dark:text-amber-300',
        bar: 'bg-amber-400',
        check: 'bg-amber-500',
        btn: 'bg-amber-600 hover:bg-amber-500 hover:shadow-amber-400/40',
    },
    ticketing: {
        icon: Ticket,
        badge: 'Ticketing',
        desc: 'Jual tiket online tanpa biaya di muka, bayar lewat bagi hasil.',
        card: 'border-indigo-200/80 from-indigo-50/80 dark:border-indigo-400/20 dark:from-indigo-500/10',
        iconBox: 'bg-indigo-100 text-indigo-600 dark:bg-indigo-500/20 dark:text-indigo-300',
        pill: 'bg-indigo-50 text-indigo-700 ring-indigo-200 dark:bg-indigo-500/15 dark:text-indigo-200 dark:ring-indigo-400/20',
        eyebrow: 'text-indigo-600 dark:text-indigo-300',
        bar: 'bg-indigo-400',
        check: 'bg-indigo-500',
        btn: 'bg-indigo-600 hover:bg-indigo-500 hover:shadow-indigo-400/40',
    },
    'ticketing-voting': {
        icon: ThumbsUp,
        badge: 'Ticketing + Voting',
        desc: 'Tiket dan voting penonton dalam satu paket, bayar lewat bagi hasil.',
        card: 'border-violet-200/80 from-violet-50/80 dark:border-violet-400/20 dark:from-violet-500/10',
        iconBox: 'bg-violet-100 text-violet-600 dark:bg-violet-500/20 dark:text-violet-300',
        pill: 'bg-violet-50 text-violet-700 ring-violet-200 dark:bg-violet-500/15 dark:text-violet-200 dark:ring-violet-400/20',
        eyebrow: 'text-violet-600 dark:text-violet-300',
        bar: 'bg-violet-400',
        check: 'bg-violet-500',
        btn: 'bg-violet-600 hover:bg-violet-500 hover:shadow-violet-400/40',
    },
};

const css = `
@keyframes sp-rise{from{opacity:0;transform:translateY(26px) scale(.97)}to{opacity:1;transform:none}}
.sp-rise{animation:sp-rise .7s cubic-bezier(.2,.8,.2,1) both}
@media (prefers-reduced-motion:reduce){.sp-rise{animation:none!important}}
`;

const chip =
    'inline-flex items-center gap-2.5 rounded-full border border-white/70 bg-white/80 px-5 py-3 text-sm font-bold text-slate-700 shadow-sm backdrop-blur dark:border-white/10 dark:bg-slate-900/60 dark:text-slate-100';

export default function Paket() {
    const { packages = [] } = usePage<{ packages?: PackageCard[] }>().props;
    const hasShare = packages.some((p) => p.price.note === 'bagi hasil');

    return (
        <>
            <Head title="Semua Paket - SIMPLE" />
            <div className="relative min-h-screen text-slate-900 transition-colors dark:text-white">
                <PageBackground />
                <Navbar />
                <div className="relative z-10">
                    <style>{css}</style>
                    <main className="mx-auto max-w-7xl px-6 pb-24 pt-10">
                        {/* Kepala halaman */}
                        <div className="relative">
                            <Link
                                href="/"
                                className="group inline-flex items-center gap-2 rounded-full border border-white/70 bg-white/80 px-5 py-3 text-sm font-bold text-indigo-800 shadow-sm backdrop-blur transition hover:-translate-y-0.5 hover:shadow-md dark:border-white/10 dark:bg-slate-900/60 dark:text-white"
                            >
                                <ArrowLeft className="h-4 w-4 transition-transform duration-300 group-hover:-translate-x-1" />
                                Kembali
                            </Link>

                            <div className="mx-auto mt-2 max-w-3xl text-center lg:-mt-6">
                                <p className="text-xs font-bold uppercase tracking-[0.5em] text-pink-500">Paket SIMPLE</p>
                                <h1 className="title-gradient mt-4 text-5xl font-extrabold tracking-tight md:text-7xl">Semua Paket</h1>
                                <p className="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-slate-600 md:text-lg dark:text-slate-300">
                                    Bandingkan seluruh pilihan paket untuk event Anda, mulai dari tampil di beranda, ticketing, voting, sampai operasional lengkap.
                                </p>
                            </div>

                            <div className="mt-6 flex flex-wrap justify-center gap-3 lg:absolute lg:right-0 lg:top-0 lg:mt-0 lg:flex-col lg:items-stretch">
                                <span className={chip}>
                                    <PackageIcon className="h-5 w-5 text-orange-500" />
                                    {packages.length} paket
                                </span>
                                {hasShare && (
                                    <span className={chip}>
                                        <Percent className="h-5 w-5 text-orange-500" />
                                        Bagi hasil tersedia
                                    </span>
                                )}
                            </div>
                        </div>

                        {/* Kartu */}
                        {packages.length === 0 ? (
                            <p className="mt-16 rounded-2xl border border-dashed border-slate-300 py-12 text-center text-sm text-slate-500 dark:border-white/15 dark:text-slate-400">
                                Paket belum tersedia.
                            </p>
                        ) : (
                            <div className="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                                {packages.map((p, i) => {
                                    const t = themes[p.slug] ?? themes.ticketing;
                                    const Icon = t.icon;
                                    return (
                                        <article
                                            key={p.id}
                                            style={{ animationDelay: `${i * 110}ms` }}
                                            className={`sp-rise group relative flex flex-col overflow-hidden rounded-3xl border bg-gradient-to-br via-white/80 to-white/90 p-6 shadow-sm backdrop-blur transition duration-300 ease-out hover:-translate-y-1.5 hover:shadow-xl dark:via-slate-900/60 dark:to-slate-900/70 ${t.card} ${
                                                p.featured ? 'ring-4 ring-amber-100 dark:ring-amber-500/10' : ''
                                            }`}
                                        >
                                            {p.featured && (
                                                <span className="absolute right-[-40px] top-6 w-40 rotate-45 bg-amber-500 py-1 text-center text-[10px] font-extrabold tracking-[0.2em] text-white shadow">
                                                    ★ POPULER
                                                </span>
                                            )}

                                            <div className="flex items-start justify-between gap-3">
                                                <span className={`flex h-12 w-12 items-center justify-center rounded-2xl transition duration-300 group-hover:rotate-6 group-hover:scale-110 ${t.iconBox}`}>
                                                    <Icon className="h-6 w-6" />
                                                </span>
                                                <span className={`rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-[0.18em] ring-1 ${t.pill} ${p.featured ? 'mr-10' : ''}`}>
                                                    {t.badge}
                                                </span>
                                            </div>

                                            {p.tagline && (
                                                <p className={`mt-6 text-[11px] font-bold uppercase tracking-[0.3em] ${t.eyebrow}`}>{p.tagline}</p>
                                            )}
                                            <h2 className="mt-1 text-xl font-extrabold">Paket {p.name}</h2>

                                            <div className="mt-5 flex gap-3">
                                                <span className={`w-1 shrink-0 rounded-full ${t.bar}`} />
                                                <div>
                                                    <p className="flex items-baseline gap-2">
                                                        <span className="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">{p.price.main}</span>
                                                        {p.price.note && <span className="text-xs font-semibold text-slate-500 dark:text-slate-400">{p.price.note}</span>}
                                                    </p>
                                                    <p className="mt-2 text-sm text-slate-600 dark:text-slate-300">{t.desc}</p>
                                                </div>
                                            </div>

                                            <div className="my-5 h-px bg-gradient-to-r from-transparent via-slate-300/70 to-transparent dark:via-white/15" />

                                            <dl className="divide-y divide-slate-200/70 rounded-xl bg-white/60 px-3 text-xs dark:divide-white/10 dark:bg-white/5">
                                                {p.specs.map(([k, v]) => (
                                                    <div key={k} className="flex items-center justify-between gap-3 py-2">
                                                        <dt className="text-slate-500 dark:text-slate-400">{k}</dt>
                                                        <dd className="text-right font-bold text-slate-800 dark:text-slate-100">{v}</dd>
                                                    </div>
                                                ))}
                                            </dl>

                                            <ul className="mb-6 mt-5 space-y-2 text-sm text-slate-700 dark:text-slate-200">
                                                {p.extends && (
                                                    <li className="pb-0.5 text-xs font-semibold text-slate-500 dark:text-slate-400">Semua fitur {p.extends}, ditambah:</li>
                                                )}
                                                {p.features.map((f) => (
                                                    <li key={f} className="flex items-center gap-2.5">
                                                        <span className={`flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-white ${t.check}`}>
                                                            <Check className="h-3 w-3" strokeWidth={3} />
                                                        </span>
                                                        {f}
                                                    </li>
                                                ))}
                                            </ul>

                                            <Link
                                                href={p.join_url}
                                                className={`group/btn mt-auto flex items-center justify-center gap-2 rounded-xl px-4 py-3.5 text-sm font-bold text-white shadow-md transition duration-300 hover:shadow-lg active:scale-[.98] ${t.btn}`}
                                            >
                                                Mulai Sekarang
                                                <ArrowRight className="h-4 w-4 transition-transform duration-300 group-hover/btn:translate-x-1" />
                                            </Link>
                                        </article>
                                    );
                                })}
                            </div>
                        )}
                    </main>
                    <Footer />
                </div>
            </div>
        </>
    );
}
