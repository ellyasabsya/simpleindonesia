import { AlertTriangle, CheckCircle2, Keyboard, ScanLine, X, XCircle } from 'lucide-react';
import { useCallback, useEffect, useRef, useState } from 'react';

export type Result = {
    status: 'ok' | 'duplikat' | 'tidak_ditemukan' | 'belum_lunas' | 'error';
    code?: string; reg_id?: string | null; name?: string; type?: string | null; buyer?: string | null; at?: string; order_status?: string | null;
};
type Props = { eventId: number; inline?: boolean; onClose?: () => void; onCheckedIn: (r: Result) => void };

const VIEW: Record<Result['status'], { title: string; box: string; Icon: typeof CheckCircle2 }> = {
    ok: { title: 'Check-in berhasil', box: 'border-emerald-400 bg-emerald-50 text-emerald-900', Icon: CheckCircle2 },
    duplikat: { title: 'Tiket sudah pernah dipakai', box: 'border-amber-400 bg-amber-50 text-amber-900', Icon: AlertTriangle },
    tidak_ditemukan: { title: 'Kode atau ID tidak ditemukan', box: 'border-rose-400 bg-rose-50 text-rose-900', Icon: XCircle },
    belum_lunas: { title: 'Pesanan belum lunas', box: 'border-rose-400 bg-rose-50 text-rose-900', Icon: XCircle },
    error: { title: 'Terjadi kesalahan, coba lagi', box: 'border-rose-400 bg-rose-50 text-rose-900', Icon: XCircle },
};

function xsrf() {
    const m = document.cookie.match(/(?:^|; )XSRF-TOKEN=([^;]*)/);
    return m ? decodeURIComponent(m[1]) : '';
}

export default function TicketScanner({ eventId, inline = false, onClose, onCheckedIn }: Props) {
    const [result, setResult] = useState<Result | null>(null);
    const [manual, setManual] = useState('');
    const [camOn, setCamOn] = useState(false);
    const [camErr, setCamErr] = useState('');
    const [busy, setBusy] = useState(false);
    const [count, setCount] = useState(0);
    const scanner = useRef<any>(null);
    const last = useRef<{ code: string; t: number }>({ code: '', t: 0 });
    const input = useRef<HTMLInputElement>(null);

    const submit = useCallback(async (raw: string, fromCam = false) => {
        const code = raw.trim();
        if (!code) return;
        const now = Date.now();
        if (fromCam && last.current.code === code && now - last.current.t < 3000) return;
        last.current = { code, t: now };
        setBusy(true);
        try {
            const res = await fetch(`/panel/event/${eventId}/registrasi/checkin`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-XSRF-TOKEN': xsrf(), 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({ code }),
            });
            if (!res.ok) throw new Error(String(res.status));
            const data: Result = await res.json();
            setResult(data);
            if (data.status === 'ok') { setCount((c) => c + 1); onCheckedIn(data); }
        } catch {
            setResult({ status: 'error' });
        } finally {
            setBusy(false);
            setManual('');
            input.current?.focus();
        }
    }, [eventId, onCheckedIn]);

    const stopCam = useCallback(async () => {
        const s = scanner.current;
        scanner.current = null;
        if (s) { try { await s.stop(); s.clear(); } catch { /* sudah berhenti */ } }
        setCamOn(false);
    }, []);

    const startCam = async () => {
        setCamErr('');
        try {
            const { Html5Qrcode } = await import('html5-qrcode');
            const s = new Html5Qrcode('qr-reader');
            scanner.current = s;
            await s.start({ facingMode: 'environment' }, { fps: 10, qrbox: { width: 240, height: 240 } }, (text: string) => submit(text, true), () => {});
            setCamOn(true);
        } catch {
            scanner.current = null;
            setCamErr('Kamera tidak bisa dibuka. Izinkan akses kamera di browser (butuh HTTPS atau localhost), atau pakai input kode di bawah.');
        }
    };

    useEffect(() => { input.current?.focus(); return () => { stopCam(); }; }, [stopCam]);

    const v = result ? VIEW[result.status] : null;

    const body = (
        <>
            <div className="flex items-center gap-3">
                <span className="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-600 to-violet-600 text-white"><ScanLine className="h-5 w-5" /></span>
                <div className="mr-auto">
                    <h3 className="text-lg font-extrabold">Scan tiket</h3>
                    <p className="text-xs text-slate-500">{count} tiket check-in pada sesi ini</p>
                </div>
                {!inline && onClose && <button type="button" onClick={onClose} className="rounded-lg p-2 text-slate-500 hover:bg-slate-100 dark:hover:bg-white/10"><X className="h-5 w-5" /></button>}
            </div>

            <div className="mt-4 overflow-hidden rounded-2xl bg-slate-900">
                <div id="qr-reader" className={camOn ? 'w-full' : 'hidden'} />
                {!camOn && (
                    <div className="flex flex-col items-center gap-3 px-4 py-8 text-center text-slate-300">
                        <ScanLine className="h-10 w-10 opacity-60" />
                        <p className="text-sm">Arahkan kamera ke QR code tiket peserta.</p>
                        <button type="button" onClick={startCam} className="rounded-xl bg-white px-4 py-2 text-sm font-bold text-slate-900 hover:bg-slate-100">Buka kamera</button>
                    </div>
                )}
            </div>
            {camOn && <button type="button" onClick={stopCam} className="mt-2 w-full rounded-xl border border-slate-200 py-2 text-sm font-bold hover:bg-slate-50 dark:border-white/10 dark:hover:bg-white/5">Matikan kamera</button>}
            {camErr && <p className="mt-2 text-xs font-semibold text-rose-600">{camErr}</p>}

            <form onSubmit={(e) => { e.preventDefault(); submit(manual); }} className="mt-4 flex gap-2">
                <div className="relative flex-1">
                    <Keyboard className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
                    <input ref={input} value={manual} onChange={(e) => setManual(e.target.value)} placeholder="Kode tiket, ID registrasi, atau alat scan USB" autoComplete="off"
                        className="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-9 pr-3 text-sm outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30 dark:border-white/10 dark:bg-white/5" />
                </div>
                <button type="submit" disabled={busy} className="rounded-xl bg-indigo-900 px-4 py-2.5 text-sm font-bold text-white hover:bg-indigo-800 disabled:opacity-60">{busy ? '...' : 'Check-in'}</button>
            </form>

            {result && v && (
                <div className={`mt-4 rounded-2xl border-2 p-4 ${v.box}`}>
                    <div className="flex items-center gap-2 text-base font-extrabold"><v.Icon className="h-6 w-6" />{v.title}</div>
                    {result.name && (
                        <dl className="mt-3 space-y-1 text-sm">
                            <div><span className="font-semibold opacity-70">Pemegang: </span><span className="font-extrabold">{result.name}</span></div>
                            {result.type && <div><span className="font-semibold opacity-70">Jenis: </span>{result.type}</div>}
                            {result.buyer && <div><span className="font-semibold opacity-70">Pembeli: </span>{result.buyer}</div>}
                            {result.at && <div><span className="font-semibold opacity-70">{result.status === 'ok' ? 'Waktu check-in: ' : 'Check-in sebelumnya: '}</span>{result.at}</div>}
                            {result.status === 'belum_lunas' && result.order_status && <div><span className="font-semibold opacity-70">Status pesanan: </span>{result.order_status}</div>}
                            {result.reg_id && <div className="font-mono text-xs font-bold">{result.reg_id}</div>}
                            {result.code && <div className="font-mono text-xs opacity-70">{result.code}</div>}
                        </dl>
                    )}
                    {result.status === 'tidak_ditemukan' && result.code && <p className="mt-2 font-mono text-xs opacity-70">{result.code}</p>}
                </div>
            )}
        </>
    );

    if (inline) return <div>{body}</div>;

    return (
        <div className="fixed inset-0 z-50 flex items-end justify-center bg-slate-900/60 p-0 backdrop-blur-sm sm:items-center sm:p-4" onClick={(e) => e.target === e.currentTarget && onClose?.()}>
            <div className="max-h-[92vh] w-full max-w-lg overflow-y-auto rounded-t-3xl bg-white p-5 shadow-2xl dark:bg-slate-900 sm:rounded-3xl">{body}</div>
        </div>
    );
}
