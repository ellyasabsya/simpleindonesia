import { Head, Link, router, usePage } from '@inertiajs/react';
import { ArrowLeft, LogOut, Menu, Moon, Sun, X } from 'lucide-react';
import { useState, type ReactNode } from 'react';
import PageBackground from '@/components/page-background';
import { eventMenuIcons } from '@/data/event-menu-icons';
import { panelMenu, type PanelMenuGroup } from '@/data/panel-menu';
import { useTheme } from '@/hooks/use-theme';

type PageProps = {
    auth?: { user?: { name?: string } };
    institution?: { name: string };
};

function Sidebar({ onNavigate }: { onNavigate?: () => void }) {
    const { url } = usePage();
    const path = url.split('?')[0];
    const { eventNav } = usePage<{ eventNav?: { title: string; items: { key: string; label: string; href: string }[] } }>().props;
    const shared = usePage().props as any;
    const menuPerms: string[] | null = shared.panelPerms ?? null;
    const menuOwner: boolean = !!shared.panelOwner;
    const MENU_NEED: Record<string, string[]> = {
        '/panel/event': ['events', 'checkin'],
        '/panel/ajukan': ['events'],
        '/panel/peserta': ['events', 'checkin'],
        '/panel/tiket': ['events', 'checkin', 'finance'],
        '/panel/voting': ['events'],
        '/panel/penilaian': ['events'],
        '/panel/pendapatan': ['finance', 'withdraw'],
    };
    const menuVisible = (href: string) => {
        if (menuOwner || menuPerms === null) return true;
        if (href === '/panel/profil') return false;
        const need = MENU_NEED[href];
        return !need || need.some((p) => menuPerms.includes(p));
    };
    const groups: PanelMenuGroup[] = eventNav
        ? [
              {
                  title: eventNav.title,
                  items: eventNav.items.map((i) => ({ label: i.label, href: i.href, icon: eventMenuIcons[i.key] ?? eventMenuIcons.dashboard })),
              },
          ]
        : panelMenu;


    return (
        <div className="flex h-full flex-col">
            <Link href="/" onClick={onNavigate} className="flex items-center gap-3 px-6 pb-5 pt-6">
                <span className="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-blue-600 to-indigo-900 text-xl font-black text-white">
                    S
                </span>
                <span>
                    <span className="block text-lg font-extrabold leading-none tracking-[0.2em] text-indigo-900 dark:text-white">SIMPLE</span>
                    <span className="mt-1 block text-[10px] font-bold uppercase tracking-[0.25em] text-indigo-500 dark:text-indigo-300">Panel Lembaga</span>
                </span>
            </Link>

            <nav className="flex-1 space-y-5 overflow-y-auto px-4 pb-4 [scrollbar-width:none]">
                {groups.map((g0) => ({ ...g0, items: g0.items.filter((it) => menuVisible(it.href)) })).filter((g0) => g0.items.length > 0).map((group) => (
                    <div key={group.title}>
                        <p className="mb-2 px-3 text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500">{group.title}</p>
                        <div className="space-y-1">
                            {group.items.map(({ label, href, icon: Icon }) => {
                                const active = href === '/panel' || eventNav ? path === href : path.startsWith(href);
                                return (
                                    <Link
                                        key={href}
                                        href={href}
                                        onClick={onNavigate}
                                        className={`flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition ${
                                            active
                                                ? 'bg-gradient-to-r from-indigo-700 via-blue-600 to-violet-600 text-white shadow-md shadow-indigo-600/25'
                                                : 'text-slate-600 hover:bg-white/80 hover:text-indigo-800 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white'
                                        }`}
                                    >
                                        <Icon className="h-[18px] w-[18px]" />
                                        {label}
                                    </Link>
                                );
                            })}
                        </div>
                    </div>
                ))}
            </nav>

            <div className="border-t border-slate-200/70 p-4 dark:border-white/10">
                <Link
                    href="/panel"
                    onClick={onNavigate}
                    className="flex items-center justify-center gap-2 rounded-xl bg-white/80 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-white hover:text-indigo-700 dark:bg-white/10 dark:text-slate-200 dark:hover:bg-white/20"
                >
                    <ArrowLeft className="h-4 w-4" />
                    Panel Lembaga
                </Link>
            </div>
        </div>
    );
}

export default function PanelLayout({ title, children }: { title: string; children: ReactNode }) {
    const { dark, toggle } = useTheme();
    const [open, setOpen] = useState(false);
    const { auth, institution } = usePage<PageProps>().props;
    const name = auth?.user?.name ?? 'Pengguna';

    return (
        <>
            <Head title={`${title} - Panel SIMPLE`} />
            <PageBackground />

            <aside className="fixed inset-y-0 left-0 z-30 hidden w-64 border-r border-white/60 bg-white/60 backdrop-blur-xl lg:block dark:border-white/10 dark:bg-indigo-950/40">
                <Sidebar />
            </aside>

            {open && (
                <div className="fixed inset-0 z-40 lg:hidden">
                    <div className="absolute inset-0 bg-slate-900/40 backdrop-blur-sm" onClick={() => setOpen(false)} />
                    <aside className="absolute inset-y-0 left-0 w-64 bg-white/95 shadow-2xl dark:bg-indigo-950/95">
                        <button onClick={() => setOpen(false)} aria-label="Tutup menu" className="absolute right-3 top-4 rounded-lg p-1.5 text-slate-500 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-white/10">
                            <X className="h-5 w-5" />
                        </button>
                        <Sidebar onNavigate={() => setOpen(false)} />
                    </aside>
                </div>
            )}

            <div className="relative z-10 min-h-screen text-slate-900 lg:pl-64 dark:text-white">
                <header className="sticky top-0 z-20 border-b border-white/60 bg-white/60 backdrop-blur-xl dark:border-white/10 dark:bg-indigo-950/40">
                    <div className="flex h-16 items-center justify-between px-5 lg:px-8">
                        <div className="flex items-center gap-3">
                            <button onClick={() => setOpen(true)} aria-label="Buka menu" className="rounded-lg p-2 text-slate-600 hover:bg-white/80 lg:hidden dark:text-slate-200 dark:hover:bg-white/10">
                                <Menu className="h-5 w-5" />
                            </button>
                            <h1 className="text-lg font-extrabold">{title}</h1>
                        </div>

                        <div className="flex items-center gap-3">
                            <button onClick={toggle} aria-label="Ganti tema" className="flex h-10 w-10 items-center justify-center rounded-full bg-white/70 text-slate-700 shadow-sm transition hover:bg-white dark:bg-white/10 dark:text-slate-200 dark:hover:bg-white/20">
                                {dark ? <Sun className="h-[18px] w-[18px]" /> : <Moon className="h-[18px] w-[18px]" />}
                            </button>

                            <div className="flex items-center gap-2.5 rounded-full bg-white/70 py-1 pl-1 pr-4 shadow-sm dark:bg-white/10">
                                <span className="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-blue-600 to-violet-600 text-sm font-bold text-white">
                                    {name.charAt(0).toUpperCase()}
                                </span>
                                <span className="hidden leading-tight sm:block">
                                    <span className="block text-sm font-bold">{name}</span>
                                    <span className="block max-w-40 truncate text-[10px] font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                        {institution?.name ?? 'Lembaga'}
                                    </span>
                                </span>
                            </div>

                            <button onClick={() => router.post('/logout')} className="flex h-10 items-center gap-2 rounded-full bg-rose-50 px-4 text-sm font-bold text-rose-600 transition hover:bg-rose-100 dark:bg-rose-500/15 dark:text-rose-300 dark:hover:bg-rose-500/25">
                                <LogOut className="h-4 w-4" />
                                <span className="hidden sm:inline">Keluar</span>
                            </button>
                        </div>
                    </div>
                </header>

                <main className="space-y-6 p-5 lg:p-8">{children}</main>
            </div>
        </>
    );
}
