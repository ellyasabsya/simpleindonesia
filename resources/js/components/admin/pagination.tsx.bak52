import { router } from '@inertiajs/react';
import { ChevronLeft, ChevronRight } from 'lucide-react';

type PageLink = { url: string | null; label: string; active: boolean };
export type Paginated = {
    current_page: number;
    last_page: number;
    total: number;
    from?: number | null;
    to?: number | null;
    links: PageLink[];
};

export default function Pagination({ page }: { page: Paginated }) {
    if (page.last_page <= 1) return null;
    const nums = page.links.slice(1, -1);
    const prev = page.links[0]?.url;
    const next = page.links[page.links.length - 1]?.url;
    const go = (url: string | null) => url && router.get(url, {}, { preserveScroll: true, preserveState: true });

    return (
        <div className="flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 px-5 py-3 text-sm text-slate-500 dark:border-white/10">
            <span>Halaman {page.current_page} dari {page.last_page} · {page.total} data</span>
            <div className="flex items-center gap-1">
                <button type="button" disabled={!prev} onClick={() => go(prev)} aria-label="Sebelumnya" className="rounded-lg p-2 hover:bg-slate-100 disabled:opacity-40 dark:hover:bg-white/10"><ChevronLeft className="h-4 w-4" /></button>
                {nums.map((l, i) => (
                    <button key={i} type="button" disabled={!l.url || l.active} onClick={() => go(l.url)}
                        className={`min-w-9 rounded-lg px-2 py-1.5 text-sm font-semibold ${l.active ? 'bg-indigo-700 text-white' : 'hover:bg-slate-100 dark:hover:bg-white/10'} disabled:cursor-default`}>
                        {l.label}
                    </button>
                ))}
                <button type="button" disabled={!next} onClick={() => go(next)} aria-label="Berikutnya" className="rounded-lg p-2 hover:bg-slate-100 disabled:opacity-40 dark:hover:bg-white/10"><ChevronRight className="h-4 w-4" /></button>
            </div>
        </div>
    );
}
