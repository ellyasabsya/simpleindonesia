import { Link, usePage } from '@inertiajs/react';
import { ArrowRight, Check } from 'lucide-react';
import { useEffect, useRef, useState } from 'react';
import Section from './section';

type PackageCard = {
    id: number;
    name: string;
    slug: string;
    tagline: string | null;
    price: { main: string; note: string };
    specs: [string, string][];
    extends: string | null;
    features: string[];
    featured: boolean;
    join_url: string;
};

const css = `
@keyframes pkg-rise{from{opacity:0;transform:translateY(28px) scale(.97)}to{opacity:1;transform:none}}
@keyframes pkg-slide{from{opacity:0;transform:translateX(-10px)}to{opacity:1;transform:none}}
@keyframes pkg-glow{0%,100%{box-shadow:0 0 0 4px rgba(99,102,241,.12),0 10px 30px -10px rgba(99,102,241,.35)}50%{box-shadow:0 0 0 8px rgba(99,102,241,.06),0 18px 40px -10px rgba(99,102,241,.5)}}
@keyframes pkg-shine{0%{transform:translateX(-130%) skewX(-20deg)}60%,100%{transform:translateX(260%) skewX(-20deg)}}
.pkg-rise{animation:pkg-rise .7s cubic-bezier(.2,.8,.2,1) both}
.pkg-slide{animation:pkg-slide .5s ease-out both}
.pkg-glow{animation:pkg-glow 3.2s ease-in-out infinite}
.pkg-shine{animation:pkg-shine 3.5s ease-in-out infinite}
@media (prefers-reduced-motion:reduce){
.pkg-rise,.pkg-slide,.pkg-glow,.pkg-shine{animation:none!important}
.pkg-hide{opacity:1!important}
}`;

function useInView<T extends Element>() {
    const ref = useRef<T>(null);
    const [seen, setSeen] = useState(false);

    useEffect(() => {
        const el = ref.current;
        if (!el) return;
        if (typeof IntersectionObserver === 'undefined') {
            setSeen(true);
            return;
        }
        const io = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    setSeen(true);
                    io.disconnect();
                }
            },
            { threshold: 0.15 },
        );
        io.observe(el);
        return () => io.disconnect();
    }, []);

    return [ref, seen] as const;
}

// Harga "Rp499.000" menghitung naik dari 0; teks lain (misal "Gratis") tampil apa adanya.
function Price({ text, run }: { text: string; run: boolean }) {
    const m = text.match(/^Rp([\d.]+)$/);
    const target = m ? parseInt(m[1].replace(/\./g, ''), 10) : null;
    const [val, setVal] = useState(target ?? 0);

    useEffect(() => {
        if (target === null || !run) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            setVal(target);
            return;
        }
        let raf = 0;
        const start = performance.now();
        const dur = 900;
        const tick = (t: number) => {
            const k = Math.min(1, (t - start) / dur);
            setVal(Math.round(target * (1 - Math.pow(1 - k, 3))));
            if (k < 1) raf = requestAnimationFrame(tick);
        };
        setVal(0);
        raf = requestAnimationFrame(tick);
        return () => cancelAnimationFrame(raf);
    }, [run, target]);

    if (target === null) return <>{text}</>;
    return <>Rp{val.toLocaleString('id-ID')}</>;
}

export default function PackageSection() {
    const { packages = [] } = usePage<{ packages?: PackageCard[] }>().props;
    const [gridRef, seen] = useInView<HTMLDivElement>();

    return (
        <Section id="paket" title="Pilih Paket, Buat Event Anda Bersinar" description="Pilih paket sesuai kebutuhan event Anda.">
            <style>{css}</style>

            {packages.length === 0 ? (
                <p className="rounded-2xl border border-dashed border-slate-300 py-12 text-center text-sm text-slate-500 dark:border-white/15 dark:text-slate-400">
                    Paket belum tersedia.
                </p>
            ) : (
                <div ref={gridRef} className="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
                    {packages.map((p, i) => (
                        <div
                            key={p.id}
                            className={`flex ${seen ? 'pkg-rise' : 'pkg-hide opacity-0'}`}
                            style={seen ? { animationDelay: `${i * 130}ms` } : undefined}
                        >
                            <article
                                className={`flex w-full flex-col rounded-2xl border bg-white/80 p-6 backdrop-blur transition duration-300 ease-out hover:-translate-y-1.5 hover:shadow-xl hover:shadow-indigo-200/60 dark:bg-slate-900/60 dark:hover:shadow-indigo-500/20 ${
                                    p.featured
                                        ? 'pkg-glow border-indigo-400 dark:border-indigo-400/50 md:scale-[1.02]'
                                        : 'border-white/70 shadow-sm hover:border-indigo-200 dark:border-white/10'
                                }`}
                            >
                                <div className="flex min-h-7 items-center justify-between gap-2">
                                    <div>
                                        <h3 className="text-xl font-extrabold">{p.name}</h3>
                                        {p.tagline && <p className="text-xs text-slate-500 dark:text-slate-400">{p.tagline}</p>}
                                    </div>
                                    {p.featured && (
                                        <span className="rounded-full bg-indigo-100 px-2.5 py-1 text-[11px] font-bold text-indigo-800 dark:bg-indigo-500/20 dark:text-indigo-100">
                                            Paling direkomendasikan
                                        </span>
                                    )}
                                </div>

                                <p className="mt-4 flex items-baseline gap-2">
                                    <span className="text-3xl font-extrabold tabular-nums text-slate-900 dark:text-white">
                                        <Price text={p.price.main} run={seen} />
                                    </span>
                                    {p.price.note && <span className="text-xs text-slate-500 dark:text-slate-400">{p.price.note}</span>}
                                </p>

                                <dl className="mt-4 divide-y divide-slate-200/70 rounded-xl bg-slate-50/80 px-3 text-xs dark:divide-white/10 dark:bg-white/5">
                                    {p.specs.map(([k, v]) => (
                                        <div key={k} className="flex items-center justify-between gap-3 py-2">
                                            <dt className="text-slate-500 dark:text-slate-400">{k}</dt>
                                            <dd className="text-right font-bold text-slate-800 dark:text-slate-100">{v}</dd>
                                        </div>
                                    ))}
                                </dl>

                                <ul className="mt-4 space-y-1.5 text-sm text-slate-700 dark:text-slate-200">
                                    {p.extends && (
                                        <li className="pb-0.5 text-xs font-semibold text-slate-500 dark:text-slate-400">Semua fitur {p.extends}, ditambah:</li>
                                    )}
                                    {p.features.map((f, j) => (
                                        <li
                                            key={f}
                                            className={`flex items-center gap-2 ${seen ? 'pkg-slide' : 'pkg-hide opacity-0'}`}
                                            style={seen ? { animationDelay: `${i * 130 + 350 + j * 70}ms` } : undefined}
                                        >
                                            <Check className="h-4 w-4 shrink-0 text-emerald-500" />
                                            {f}
                                        </li>
                                    ))}
                                </ul>

                                <Link
                                    href={p.join_url}
                                    className={`group relative mt-auto flex items-center justify-center gap-2 overflow-hidden rounded-xl px-4 py-3 text-sm font-bold transition duration-300 active:scale-[.98] ${
                                        p.featured
                                            ? 'bg-indigo-800 text-white shadow-md hover:bg-indigo-700 hover:shadow-lg hover:shadow-indigo-400/40'
                                            : 'bg-indigo-50 text-indigo-800 hover:bg-indigo-100 dark:bg-indigo-500/20 dark:text-white'
                                    }`}
                                >
                                    {p.featured && <span className="pkg-shine pointer-events-none absolute inset-y-0 left-0 w-1/3 bg-white/25" />}
                                    <span className="relative">Pilih {p.name}</span>
                                    <ArrowRight className="relative h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
                                </Link>
                            </article>
                        </div>
                    ))}
                </div>
            )}
        </Section>
    );
}
