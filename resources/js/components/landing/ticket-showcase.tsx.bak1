import { useEffect, useState } from 'react';
import TicketCardVertical, { type TicketCardProps } from './ticket-card-vertical';

type Row = Omit<TicketCardProps, 'startsAt' | 'endsAt' | 'ticketName' | 'validUntil'> & {
    id: number; starts_at: string; ends_at: string; ticket_name: string; valid_until: string; poster: string | null;
};

export default function TicketShowcase() {
    const [rows, setRows] = useState<Row[] | null>(null);

    useEffect(() => {
        fetch('/tiket-data', { headers: { Accept: 'application/json' } })
            .then((r) => r.json())
            .then(setRows)
            .catch(() => setRows([]));
    }, []);

    if (rows === null) return <p className="py-10 text-center text-sm text-neutral-400">Memuat tiket...</p>;
    if (rows.length === 0) return <p className="py-10 text-center text-sm text-neutral-500">Belum ada event dengan tiket yang dibuka.</p>;

    return (
        <div className="grid w-full gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {rows.map((r) => (
                <TicketCardVertical
                    key={r.id}
                    href={r.href}
                    title={r.title}
                    poster={r.poster}
                    startsAt={r.starts_at}
                    endsAt={r.ends_at}
                    location={r.location}
                    ticketName={r.ticket_name}
                    price={r.price}
                    validUntil={r.valid_until}
                    available={r.available}
                    category={r.category}
                />
            ))}
        </div>
    );
}
