import { usePage } from '@inertiajs/react';
import { Check } from 'lucide-react';
import Section from './section';

type PackageCard = {
    id: number;
    name: string;
    slug: string;
    description: string | null;
    price: { main: string; note: string };
    highlights: string[];
    extends: string | null;
    features: string[];
    featured: boolean;
};

export default function PackageSection() {
    const { packages = [] } = usePage<{ packages?: PackageCard[] }>().props;

    return (
        <Section id="paket" title="Pilih Paket, Buat Event Anda Bersinar" description="Pilih paket sesuai kebutuhan event Anda.">
            {packages.length === 0 ? (
                <p className="rounded-2xl border border-dashed border-slate-300 py-12 text-center text-sm text-slate-500 dark:border-white/15 dark:text-slate-400">
                    Paket belum tersedia.
                </p>
            ) : (
                <div className="grid gap-5 md:grid-cols-3">
                    {packages.map((p) => (
                        <article
                            key={p.id}
                            className={`flex flex-col rounded-2xl border bg-white/80 p-6 shadow-sm backdrop-blur dark:bg-slate-900/60 ${
                                p.featured
                                    ? 'border-indigo-400 ring-4 ring-indigo-100 dark:border-indigo-400/50 dark:ring-indigo-500/10'
                                    : 'border-white/70 dark:border-white/10'
                            }`}
                        >
                            <div className="flex min-h-7 items-center justify-between gap-2">
                                <h3 className="text-xl font-extrabold">{p.name}</h3>
                                {p.featured && (
                                    <span className="rounded-full bg-indigo-100 px-2.5 py-1 text-[11px] font-bold text-indigo-800 dark:bg-indigo-500/20 dark:text-indigo-100">
                                        Paling direkomendasikan
                                    </span>
                                )}
                            </div>

                            <p className="mt-2 flex items-baseline gap-2">
                                <span className="title-gradient text-3xl font-extrabold">{p.price.main}</span>
                                {p.price.note && <span className="text-xs text-slate-500 dark:text-slate-400">{p.price.note}</span>}
                            </p>

                            {p.description && <p className="mt-2 text-sm text-slate-600 dark:text-slate-300">{p.description}</p>}

                            <ul className="mt-4 space-y-1 rounded-xl bg-indigo-50/70 p-3 text-xs font-semibold text-indigo-900 dark:bg-indigo-500/10 dark:text-indigo-100">
                                {p.highlights.map((h) => (
                                    <li key={h}>{h}</li>
                                ))}
                            </ul>

                            <ul className="mt-4 space-y-1.5 text-sm text-slate-700 dark:text-slate-200">
                                {p.extends && (
                                    <li className="pb-0.5 text-xs font-semibold text-slate-500 dark:text-slate-400">Semua fitur {p.extends}, ditambah:</li>
                                )}
                                {p.features.map((f) => (
                                    <li key={f} className="flex items-center gap-2">
                                        <Check className="h-4 w-4 shrink-0 text-emerald-500" />
                                        {f}
                                    </li>
                                ))}
                            </ul>
                        </article>
                    ))}
                </div>
            )}
        </Section>
    );
}
