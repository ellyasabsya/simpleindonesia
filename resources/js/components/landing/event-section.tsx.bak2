import { Link, usePage } from '@inertiajs/react';
import { CalendarDays, Dumbbell, Layers, MapPin, PartyPopper, Presentation, Store, Tag, Trophy, User } from 'lucide-react';
import type { ComponentType } from 'react';
import Section, { Placeholder } from './section';

type StatusKey = 'selesai' | 'segera' | 'berlangsung';

export type EventCard = {
    id: number;
    slug: string | null;
    title: string;
    poster: string | null;
    category: string | null;
    category_key: string | null;
    location: string | null;
    organizer: string | null;
    starts_at: string | null;
    ends_at: string | null;
    status: { key: StatusKey; label: string };
    is_series?: boolean;
    sub_count?: number;
};

// Ganti kalau rute detail event berbeda.
const eventUrl = (e: EventCard) => `/events/${e.slug ?? e.id}`;

const CATEGORY_ICON: Record<string, ComponentType<{ className?: string }>> = {
    seminar: Presentation,
    perlombaan: Trophy,
    olahraga: Dumbbell,
    festival: PartyPopper,
    pameran: Store,
};

const STATUS_STYLE: Record<StatusKey, { badge: string; dot: string }> = {
    berlangsung: { badge: 'bg-emerald-500 text-white', dot: 'bg-white' },
    segera: { badge: 'bg-blue-600 text-white', dot: 'bg-white' },
    selesai: { badge: 'bg-neutral-600 text-white', dot: 'bg-white/80' },
};

const fmt = (s: string) =>
    new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }).format(
        new Date(`${s}T00:00:00`),
    );

function dateRange(start: string | null, end: string | null): string | null {
    if (!start && !end) return null;
    if (!start || !end || start === end) return fmt((start ?? end)!);
    return `${fmt(start)} – ${fmt(end)}`;
}

function initials(title: string): string {
    return title
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map((w) => w[0]?.toUpperCase())
        .join('');
}

export function Card({ event }: { event: EventCard }) {
    const range = dateRange(event.starts_at, event.ends_at);
    const CatIcon = (event.category_key && CATEGORY_ICON[event.category_key]) || Tag;
    const st = STATUS_STYLE[event.status.key];

    const series = !!event.is_series;

    return (
        <div className={`group relative ${series ? 'pb-3' : ''}`}>
            {series && (
                <>
                    <span aria-hidden className="absolute inset-x-5 bottom-0 h-full rounded-2xl border border-violet-200/80 bg-violet-100 dark:border-white/10 dark:bg-violet-500/20" />
                    <span aria-hidden className="absolute inset-x-2.5 bottom-1.5 h-full rounded-2xl border border-violet-200/80 bg-violet-50 dark:border-white/10 dark:bg-violet-500/10" />
                </>
            )}
        <Link
            href={eventUrl(event)}
            className="relative flex h-full flex-col overflow-hidden rounded-2xl border border-neutral-200/70 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-white/10 dark:bg-neutral-900"
        >
            <div className="relative aspect-[4/5] w-full overflow-hidden bg-neutral-100 dark:bg-neutral-800">
                {event.poster ? (
                    <img
                        src={event.poster}
                        alt={event.title}
                        loading="lazy"
                        className="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                    />
                ) : (
                    <div className="flex h-full w-full items-center justify-center bg-gradient-to-br from-indigo-500 via-violet-500 to-fuchsia-500">
                        <span className="text-6xl font-bold tracking-wide text-white/90">{initials(event.title)}</span>
                    </div>
                )}

                {series && (
                    <span className="absolute top-2.5 left-2.5 inline-flex max-w-[60%] items-center gap-1 rounded-full bg-violet-700 px-2.5 py-1 text-[10px] font-bold tracking-wide text-white shadow-lg">
                        <Layers className="size-3.5 shrink-0" />
                        <span className="truncate">RANGKAIAN{event.sub_count ? ` · ${event.sub_count}` : ''}</span>
                    </span>
                )}

                {!series && event.category && (
                    <span className="absolute top-2.5 left-2.5 inline-flex max-w-[60%] items-center gap-1 rounded-full bg-blue-700 px-2.5 py-1 text-[10px] font-bold tracking-wide text-white shadow-lg">
                        <CatIcon className="size-3.5 shrink-0" />
                        <span className="truncate">{event.category}</span>
                    </span>
                )}

                <span
                    className={`absolute top-2.5 right-2.5 inline-flex shrink-0 items-center gap-1 rounded-full px-2.5 py-1 text-[10px] font-semibold whitespace-nowrap shadow-lg ${st.badge}`}
                >
                    <span className={`size-2 rounded-full ${st.dot}`} />
                    {event.status.label}
                </span>

                {range && (
                    <div className="absolute inset-x-2.5 bottom-2.5 flex items-center gap-1.5 rounded-xl bg-black/70 px-3 py-2 text-white backdrop-blur-sm">
                        <CalendarDays className="size-3.5 shrink-0" />
                        <span className="text-xs font-semibold">{range}</span>
                    </div>
                )}
            </div>

            <div className="flex flex-1 flex-col gap-1.5 p-4">
                <h3 className="line-clamp-2 text-base leading-snug font-bold text-neutral-900 transition group-hover:text-blue-800 dark:text-white">
                    {event.title}
                </h3>
                {event.location && (
                    <p className="flex items-center gap-2 text-xs text-neutral-700 dark:text-neutral-300">
                        <MapPin className="size-3.5 shrink-0 text-orange-500" />
                        <span className="line-clamp-1">{event.location}</span>
                    </p>
                )}
                {event.organizer && (
                    <p className="flex items-center gap-2 text-xs font-medium tracking-wide text-neutral-500 uppercase">
                        <User className="size-3.5 shrink-0 text-violet-500" />
                        <span className="line-clamp-1">{event.organizer}</span>
                    </p>
                )}
            </div>
        </Link>
        </div>
    );
}

export default function EventSection() {
    const { events = [] } = usePage<{ events?: EventCard[] }>().props;

    return (
        <Section
            id="event"
            title="Event Terbaru"
            description="Temukan event menarik dan daftarkan diri Anda sekarang."
            href="/events"
            linkLabel="Lihat Semua Event"
        >
            {events.length === 0 ? (
                <Placeholder label="Belum ada event" />
            ) : (
                <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                    {events.slice(0, 4).map((e) => (
                        <Card key={e.id} event={e} />
                    ))}
                </div>
            )}
        </Section>
    );
}
