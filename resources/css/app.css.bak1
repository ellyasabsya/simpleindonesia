@import 'tailwindcss';

@source '../views';
@source '../../vendor/laravel/framework/src/Illuminate/Pagination/resources/views/*.blade.php';

@theme {
    --font-sans:
        'Instrument Sans', ui-sans-serif, system-ui, sans-serif,
        'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol',
        'Noto Color Emoji';
}
@custom-variant dark (&:is(.dark *));

/* ===== Landing page SIMPLE ===== */
.bg-grid {
    background-image:
        linear-gradient(to right, rgba(30, 41, 59, 0.07) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(30, 41, 59, 0.07) 1px, transparent 1px);
    background-size: 48px 48px;
}
.dark .bg-grid {
    background-image:
        linear-gradient(to right, rgba(255, 255, 255, 0.06) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
}

@keyframes simple-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-14px) rotate(1deg); }
}
.float-a { animation: simple-float 5s ease-in-out infinite; }
.float-b { animation: simple-float 6.5s ease-in-out -2s infinite; }
.float-c { animation: simple-float 7.5s ease-in-out -4s infinite; }

@media (prefers-reduced-motion: reduce) {
    .float-a, .float-b, .float-c { animation: none; }
}
html { scroll-behavior: smooth; }

/* Sembunyikan scrollbar, halaman tetap bisa di-scroll */
html { scrollbar-width: none; -ms-overflow-style: none; }
html::-webkit-scrollbar { display: none; }

@keyframes title-shine {
    0% { background-position: 0% 50%; }
    100% { background-position: 200% 50%; }
}
.title-gradient {
    background-image: linear-gradient(90deg, #2563eb, #7c3aed, #ec4899, #f97316, #2563eb);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: title-shine 6s linear infinite;
}
@media (prefers-reduced-motion: reduce) {
    .title-gradient { animation: none; }
}

/* ===== Asap pada background (dipakai semua halaman) ===== */
.smoke {
    position: absolute;
    border-radius: 9999px;
    filter: blur(90px);
    opacity: 0.55;
    will-change: transform;
}
.dark .smoke { opacity: 0.3; }
.smoke-a {
    width: 42rem; height: 42rem; top: -12rem; left: -10rem;
    background: radial-gradient(circle, #60a5fa, transparent 70%);
    animation: smoke-a 22s ease-in-out infinite;
}
.smoke-b {
    width: 38rem; height: 38rem; bottom: -10rem; right: -8rem;
    background: radial-gradient(circle, #c084fc, transparent 70%);
    animation: smoke-b 26s ease-in-out infinite;
}
.smoke-c {
    width: 30rem; height: 30rem; top: 38%; left: 42%;
    background: radial-gradient(circle, #f9a8d4, transparent 70%);
    animation: smoke-c 30s ease-in-out infinite;
}
@keyframes smoke-a {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(9rem, 6rem) scale(1.2); }
}
@keyframes smoke-b {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-8rem, -7rem) scale(1.15); }
}
@keyframes smoke-c {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-6rem, 5rem) scale(1.25); }
}
@media (prefers-reduced-motion: reduce) {
    .smoke { animation: none; }
}
