<?php

namespace App\Support;

use Illuminate\Support\Facades\DB;

/** Data peserta, kriteria, dan hitungan nilai akhir untuk fitur Penilaian. */
class Judging
{
    public static function participants(int $eventId): array
    {
        $closed = ['ditolak', 'batal', 'dibatalkan', 'kedaluwarsa'];

        return DB::table('event_registrations')->where('event_id', $eventId)->whereNotIn('status', $closed)->orderBy('id')->get()
            ->map(fn ($r) => [
                'id' => (int) $r->id,
                'name' => $r->contact_name ?: (DB::table('users')->where('id', $r->user_id)->value('name') ?? '-'),
                'school' => $r->school,
            ])->all();
    }

    public static function criteria(int $eventId)
    {
        return DB::table('judging_criteria')->where('event_id', $eventId)->orderBy('sort')->orderBy('id')->get();
    }

    public static function settings(int $eventId): object
    {
        DB::table('judging_settings')->insertOrIgnore(['event_id' => $eventId, 'created_at' => now(), 'updated_at' => now()]);

        return DB::table('judging_settings')->where('event_id', $eventId)->first();
    }

    /** Berapa peserta yang sudah dinilai lengkap oleh satu juri. */
    public static function doneBy(int $judgeId, int $criteriaCount): int
    {
        if ($criteriaCount === 0) {
            return 0;
        }

        return DB::table('judging_scores')->where('judge_id', $judgeId)->select('registration_id')
            ->groupBy('registration_id')->havingRaw('count(*) >= ?', [$criteriaCount])->get()->count();
    }

    /** Nilai akhir 0-100: tiap kriteria dinormalkan ke skor maksimumnya, dibobotkan, lalu dirata-rata semua juri aktif. */
    public static function ranking(int $eventId): array
    {
        $crit = self::criteria($eventId);
        $activeJudges = DB::table('judges')->where('event_id', $eventId)->where('active', 1)->pluck('id')->all();
        $scores = DB::table('judging_scores')->where('event_id', $eventId)->whereIn('judge_id', $activeJudges)->get()->groupBy('judge_id');

        $out = [];
        foreach (self::participants($eventId) as $p) {
            $per = [];
            if ($crit->count() > 0) {
                foreach ($scores as $rows) {
                    $mine = $rows->where('registration_id', $p['id']);
                    $sum = 0;
                    foreach ($crit as $c) {
                        $r = $mine->firstWhere('criterion_id', $c->id);
                        if (! $r) {
                            continue 2;
                        }
                        $sum += ((float) $r->score / max(1, (int) $c->max_score)) * (int) $c->weight;
                    }
                    $per[] = $sum;
                }
            }
            $out[] = [
                'id' => $p['id'],
                'name' => $p['name'],
                'judges' => count($per),
                'final' => count($per) ? round(array_sum($per) / count($per), 2) : null,
            ];
        }
        usort($out, fn ($a, $b) => ($b['final'] ?? -1) <=> ($a['final'] ?? -1));

        return $out;
    }
}
