<?php

namespace App\Support;

use Illuminate\Support\Facades\DB;

/** Data peserta, kriteria, dan hitungan nilai akhir untuk fitur Penilaian. Semua per event dan per kategori peserta. */
class Judging
{
    /** Kategori peserta sebuah lomba. Kalau tidak punya kategori, dianggap satu paket dengan id 0. */
    public static function categories(int $eventId): array
    {
        $rows = DB::table('event_participant_categories')->where('event_id', $eventId)->orderBy('id')->get(['id', 'name']);
        if ($rows->isEmpty()) {
            return [['id' => 0, 'name' => 'Semua peserta']];
        }

        return $rows->map(fn ($c) => ['id' => (int) $c->id, 'name' => (string) $c->name])->all();
    }

    public static function categoryIds(int $eventId): array
    {
        return array_column(self::categories($eventId), 'id');
    }

    public static function participants(int $eventId, int $catId = 0): array
    {
        $closed = ['ditolak', 'batal', 'dibatalkan', 'kedaluwarsa'];
        $q = DB::table('event_registrations')->where('event_id', $eventId)->whereNotIn('status', $closed);
        if ($catId > 0) {
            $q->where('participant_category_id', $catId);
        }

        return $q->orderBy('id')->get()
            ->map(fn ($r) => [
                'id' => (int) $r->id,
                'name' => $r->contact_name ?: (DB::table('users')->where('id', $r->user_id)->value('name') ?? '-'),
                'school' => $r->school,
            ])->all();
    }

    public static function criteria(int $eventId, int $catId = 0)
    {
        return DB::table('judging_criteria')->where('event_id', $eventId)->where('category_id', $catId)->whereNull('parent_id')->orderBy('sort')->orderBy('id')->get();
    }

    /** Baris yang benar-benar dinilai juri: sub kriteria, atau kriteria yang tidak punya sub. */
    public static function leaves(int $eventId, int $catId = 0)
    {
        $kids = DB::table('judging_criteria')->where('event_id', $eventId)->where('category_id', $catId)
            ->whereNotNull('parent_id')->orderBy('sort')->orderBy('id')->get()->groupBy('parent_id');
        $out = collect();
        foreach (self::criteria($eventId, $catId) as $t) {
            $sub = $kids->get($t->id);
            if ($sub && $sub->count()) {
                foreach ($sub as $k) {
                    $k->parent_name = $t->name;
                    $k->eff_weight = $t->weight * $k->weight / 100;
                    $out->push($k);
                }
            } else {
                $t->parent_name = null;
                $t->eff_weight = $t->weight;
                $out->push($t);
            }
        }

        return $out;
    }

    public static function settings(int $eventId, int $catId = 0): object
    {
        DB::table('judging_settings')->insertOrIgnore(['event_id' => $eventId, 'category_id' => $catId, 'created_at' => now(), 'updated_at' => now()]);

        return DB::table('judging_settings')->where('event_id', $eventId)->where('category_id', $catId)->first();
    }

    /** Dipakai kartu progres dashboard: semua kategori sudah punya kriteria dengan total bobot 100%. */
    public static function criteriaReady(int $eventId): bool
    {
        foreach (self::categoryIds($eventId) as $cid) {
            $c = self::criteria($eventId, $cid);
            if ($c->count() === 0 || (int) $c->sum('weight') !== 100) {
                return false;
            }
        }

        return true;
    }

    /** Dipakai kartu progres dashboard: semua kategori sudah disahkan. */
    public static function allApproved(int $eventId): bool
    {
        foreach (self::categoryIds($eventId) as $cid) {
            if (! self::settings($eventId, $cid)->enabled) {
                return false;
            }
        }

        return true;
    }

    /** Berapa peserta yang sudah dinilai lengkap oleh satu juri. */
    public static function doneBy(int $judgeId, int $criteriaCount): int
    {
        if ($criteriaCount === 0) {
            return 0;
        }

        return DB::table('judging_scores')->where('judge_id', $judgeId)->select('registration_id')
            ->groupBy('registration_id')->havingRaw('count(*) >= ?', [$criteriaCount])->get()->count();
    }

    public static function round(float $v, int $decimals, string $mode): float
    {
        $m = 10 ** $decimals;
        $x = round($v * $m, 6);

        return match ($mode) {
            'up' => ceil($x) / $m,
            'down' => floor($x) / $m,
            default => round($v, $decimals),
        };
    }

    /** Nilai juri sudah berupa poin berbobot (maks = skala). Nilai akhir = rata-rata juri aktif di kategori itu yang sudah menilai lengkap. */
    public static function ranking(int $eventId, int $catId = 0): array
    {
        $crit = self::leaves($eventId, $catId);
        $s = self::settings($eventId, $catId);
        $activeJudges = DB::table('judges')->where('event_id', $eventId)->where('category_id', $catId)->where('active', 1)->pluck('id')->all();
        $scores = DB::table('judging_scores')->where('event_id', $eventId)->whereIn('judge_id', $activeJudges)->get()->groupBy('judge_id');

        $out = [];
        foreach (self::participants($eventId, $catId) as $p) {
            $per = [];
            if ($crit->count() > 0) {
                foreach ($scores as $rows) {
                    $mine = $rows->where('registration_id', $p['id']);
                    $sum = 0.0;
                    foreach ($crit as $c) {
                        $r = $mine->firstWhere('criterion_id', $c->id);
                        if (! $r) {
                            continue 2;
                        }
                        $sum += (float) $r->score;
                    }
                    $per[] = $sum;
                }
            }
            $out[] = [
                'id' => $p['id'],
                'name' => $p['name'],
                'judges' => count($per),
                'final' => count($per) ? self::round(array_sum($per) / count($per), (int) $s->avg_decimals, (string) $s->rounding) : null,
            ];
        }
        usort($out, fn ($a, $b) => ($b['final'] ?? -1) <=> ($a['final'] ?? -1));

        return $out;
    }
}
