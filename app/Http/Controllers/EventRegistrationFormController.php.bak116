<?php

namespace App\Http\Controllers;

use App\Models\Event;
use App\Support\RegistrationForm;
use Illuminate\Database\UniqueConstraintViolationException;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Carbon;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Storage;
use Illuminate\Support\Str;
use Illuminate\Validation\Rule;
use Illuminate\Validation\ValidationException;
use Inertia\Inertia;
use Inertia\Response;

class EventRegistrationFormController extends Controller
{
    public function show(Request $request, Event $event): Response
    {
        $this->guard($event);
        $done = $request->boolean('selesai');

        return Inertia::render('event-daftar', [
            'event' => ['id' => $event->id, 'title' => $event->title, 'location' => $event->location, 'starts_at' => $event->starts_at],
            'fields' => $this->active($event),
            'closed' => $done ? null : $this->closedReason($event),
            'done' => $done,
            'message' => $done ? (DB::table('events')->where('id', $event->id)->value('registration_message') ?: null) : null,
            'backUrl' => '/events/'.($event->slug ?: $event->id),
        ]);
    }

    public function store(Request $request, Event $event): RedirectResponse
    {
        $this->guard($event);
        $done = redirect('/events/'.$event->id.'/daftar?selesai=1');

        // Honeypot: bot mengisi kolom tersembunyi ini.
        if (filled($request->input('website'))) {
            return $done;
        }
        if ($reason = $this->closedReason($event)) {
            throw ValidationException::withMessages(['form' => $reason]);
        }

        $fields = $this->active($event);
        $rules = [
            'name' => ['required', 'string', 'max:120'],
            'email' => ['required', 'email', 'max:150'],
            'whatsapp' => ['nullable', 'string', 'max:25', 'regex:/^[0-9+\-\s]+$/'],
            'consent' => ['accepted'],
        ];
        $names = ['name' => 'Nama', 'email' => 'Email', 'whatsapp' => 'WhatsApp'];
        $msgs = ['consent.accepted' => 'Centang persetujuan penggunaan data untuk melanjutkan.'];

        foreach ($fields as $f) {
            $k = 'answers.'.$f['key'];
            $req = $f['required'] ? 'required' : 'nullable';
            $rules[$k] = match ($f['type']) {
                'number' => [$req, 'numeric'],
                'date' => [$req, 'date'],
                'textarea' => [$req, 'string', 'max:3000'],
                'select' => [$req, 'string', Rule::in($f['options'])],
                'checkbox' => [$req, 'array', 'max:50'],
                'file' => [$req, 'file', 'mimes:'.RegistrationForm::FILE_MIMES, 'max:'.RegistrationForm::FILE_MAX_KB],
                default => [$req, 'string', 'max:255'],
            };
            if ($f['type'] === 'checkbox') {
                $rules[$k.'.*'] = ['string', Rule::in($f['options'])];
            }
            $names[$k] = $f['label'];
            if ($f['type'] === 'file') {
                $msgs[$k.'.mimes'] = $f['label'].' harus berupa JPG, PNG, WEBP, atau PDF.';
                $msgs[$k.'.max'] = $f['label'].' maksimal 5 MB.';
                $msgs[$k.'.uploaded'] = 'Unggahan '.$f['label'].' gagal. Ukuran berkas mungkin terlalu besar.';
            }
        }

        $v = $request->validate($rules, $msgs, $names);

        $answers = [];
        foreach ($fields as $f) {
            $val = data_get($v, 'answers.'.$f['key']);
            if ($f['type'] === 'file') {
                continue;
            }
            if ($val === null || $val === '' || $val === []) {
                continue;
            }
            $answers[$f['key']] = $f['type'] === 'number' ? $val + 0 : (is_array($val) ? array_values($val) : $val);
        }

        $email = mb_strtolower(trim($v['email']));
        $dup = ValidationException::withMessages(['email' => 'Email ini sudah terdaftar di event ini.']);

        $stored = [];
        try {
            DB::transaction(function () use ($event, $v, $email, &$answers, $dup, $fields, &$stored) {
                if (DB::table('form_registrations')->where('event_id', $event->id)->whereRaw('LOWER(email) = ?', [$email])->exists()) {
                    throw $dup;
                }
                $quota = (int) $event->participant_quota;
                if ($quota > 0 && DB::table('form_registrations')->where('event_id', $event->id)->count() >= $quota) {
                    throw ValidationException::withMessages(['form' => 'Kuota pendaftaran sudah penuh.']);
                }
                foreach ($fields as $f) {
                    $file = $f['type'] === 'file' ? data_get($v, 'answers.'.$f['key']) : null;
                    if (! $file instanceof \Illuminate\Http\UploadedFile) {
                        continue;
                    }
                    $ext = strtolower((string) ($file->guessExtension() ?: $file->getClientOriginalExtension()));
                    $ext = $ext === 'jpeg' ? 'jpg' : $ext;
                    abort_unless(in_array($ext, ['jpg', 'png', 'webp', 'pdf'], true), 422);
                    $size = $file->getSize();
                    $orig = Str::limit((string) preg_replace('/[^\w.\- ]+/u', '_', $file->getClientOriginalName()), 100, '');
                    $path = $file->storeAs('form-registrations/'.$event->id, Str::random(40).'.'.$ext, 'local');
                    $stored[] = $path;
                    $answers[$f['key']] = ['path' => $path, 'name' => $orig, 'size' => $size];
                }

                DB::table('form_registrations')->insert([
                    'event_id' => $event->id,
                    'name' => trim($v['name']),
                    'email' => $email,
                    'whatsapp' => $v['whatsapp'] ?? null,
                    'answers' => json_encode($answers, JSON_UNESCAPED_UNICODE),
                    'created_at' => now(),
                    'updated_at' => now(),
                ]);
            });
        } catch (\Throwable $e) {
            Storage::disk('local')->delete($stored);
            throw $e instanceof UniqueConstraintViolationException ? $dup : $e;
        }

        return $done;
    }

    private function guard(Event $event): void
    {
        abort_unless($event->status === Event::PUBLISHED && $event->registration_method !== 'ticket', 404);
    }

    private function active(Event $event): array
    {
        return array_values(array_map(
            fn ($f) => [
                'key' => $f['key'],
                'label' => $f['label'],
                'type' => $f['type'],
                'required' => (bool) ($f['required'] ?? false),
                'options' => $f['options'] ?? [],
            ],
            array_filter(RegistrationForm::fields($event), fn ($f) => empty($f['archived']))
        ));
    }

    private function closedReason(Event $event): ?string
    {
        if ($event->registration_start && now()->lt(Carbon::parse($event->registration_start))) {
            return 'Pendaftaran belum dibuka.';
        }
        if ($event->registration_end) {
            $end = Carbon::parse($event->registration_end);
            if ($end->format('H:i:s') === '00:00:00') {
                $end = $end->endOfDay();
            }
            if (now()->gt($end)) {
                return 'Pendaftaran sudah ditutup.';
            }
        }
        $quota = (int) $event->participant_quota;
        if ($quota > 0 && DB::table('form_registrations')->where('event_id', $event->id)->count() >= $quota) {
            return 'Kuota pendaftaran sudah penuh.';
        }

        return null;
    }
}
