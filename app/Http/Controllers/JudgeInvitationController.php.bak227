<?php

namespace App\Http\Controllers;

use App\Models\Event;
use App\Models\Institution;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Str;

class JudgeInvitationController extends Controller
{
    private function pending(Request $request, int $id): object
    {
        $inv = DB::table('judge_invitations')->where('id', $id)->first();
        abort_unless($inv && (int) $inv->user_id === $request->user()->id, 403);
        abort_unless($inv->status === 'menunggu', 404);

        return $inv;
    }

    private function tellOwner(int $eventId, string $title, string $message): void
    {
        try {
            $event = Event::find($eventId);
            Institution::find($event?->institution_id)?->user?->notify(new \App\Notifications\AdminAlert($title, $message, "/panel/event/{$eventId}/penilaian"));
        } catch (\Throwable $e) {
            report($e);
        }
    }

    public function accept(Request $request, int $invitation): RedirectResponse
    {
        $inv = $this->pending($request, $invitation);
        $user = $request->user();
        $event = Event::findOrFail($inv->event_id);

        DB::transaction(function () use ($inv, $user) {
            $judgeId = DB::table('judges')->insertGetId([
                'event_id' => $inv->event_id, 'category_id' => $inv->category_id, 'user_id' => $user->id,
                'name' => $user->name, 'contact' => $user->email, 'active' => true,
                'token' => Str::random(32), 'created_at' => now(), 'updated_at' => now(),
            ]);
            DB::table('judge_invitations')->where('id', $inv->id)->update(['status' => 'diterima', 'judge_id' => $judgeId, 'updated_at' => now()]);
        });
        $this->tellOwner($inv->event_id, 'Undangan juri diterima', "{$user->name} menerima undangan menjadi juri {$event->title}.");

        return back()->with('success', "Anda menjadi juri {$event->title}.");
    }

    public function decline(Request $request, int $invitation): RedirectResponse
    {
        $inv = $this->pending($request, $invitation);
        $event = Event::find($inv->event_id);
        DB::table('judge_invitations')->where('id', $inv->id)->delete();
        $this->tellOwner($inv->event_id, 'Undangan juri ditolak', "{$request->user()->name} menolak undangan menjadi juri ".($event?->title ?? '').'.');

        return back()->with('success', 'Undangan ditolak.');
    }
}
