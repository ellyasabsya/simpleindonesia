<?php

namespace App\Http\Middleware;

use App\Http\Controllers\Panel\MemberController;
use App\Models\Institution;
use App\Models\InstitutionMember;
use Closure;
use Illuminate\Http\Request;
use Symfony\Component\HttpFoundation\Response;

class EnsureUserHasApprovedInstitution
{
    /**
     * Hak akses yang dibutuhkan anggota (salah satu cukup) per nama rute.
     * 'any' = semua anggota aktif. Rute yang tidak terdaftar = hanya pemilik.
     */
    private const ACCESS = [
        'panel.dashboard' => 'any',
        'panel.event' => ['events', 'checkin'],
        'panel.event.show' => ['events', 'checkin'],
        'panel.event.menu' => ['events', 'checkin'],
        'panel.ajukan' => ['events'],
        'panel.ajukan.store' => ['events'],
        'panel.peserta' => ['events', 'checkin'],
        'panel.tiket' => ['events', 'checkin', 'finance'],
        'panel.voting' => ['events'],
        'panel.penilaian' => ['events'],
        'panel.pendapatan' => ['finance', 'withdraw'],
        'panel.penarikan.bukti' => ['finance', 'withdraw'],
        'panel.penarikan.store' => ['withdraw'],
        'panel.pin.kode' => ['withdraw'],
        'panel.pin.simpan' => ['withdraw'],
        'panel.rekening.simpan' => ['withdraw'],
    ];

    public function handle(Request $request, Closure $next): Response
    {
        $user = $request->user();

        if ($user->isAdmin()) {
            return redirect('/admin');
        }

        $institution = Institution::where('user_id', $user->id)
            ->where('status', Institution::APPROVED)
            ->latest()
            ->first();

        if ($institution) {
            $request->attributes->set('institution', $institution);
            $request->attributes->set('is_owner', true);
            $request->attributes->set('panel_perms', ['events', 'checkin', 'finance', 'withdraw', 'members']);

            return $next($request);
        }

        $member = InstitutionMember::where('user_id', $user->id)
            ->where('status', 'aktif')
            ->whereIn('institution_id', Institution::where('status', Institution::APPROVED)->select('id'))
            ->latest('id')
            ->first();

        if (! $member) {
            return redirect()->route('lembaga.daftar');
        }

        $name = $request->route()?->getName();
        $need = self::ACCESS[$name] ?? null;
        $perms = MemberController::permissionsFor($member);

        $allowed = $need === 'any' || (is_array($need) && array_intersect($need, $perms));

        if (! $allowed) {
            if ($name === 'panel.dashboard') {
                return redirect('/dashboard');
            }

            return redirect('/panel')->with('error', 'Anda tidak punya akses ke halaman itu.');
        }

        $request->attributes->set('institution', Institution::findOrFail($member->institution_id));
        $request->attributes->set('is_owner', false);
        $request->attributes->set('panel_perms', array_values($perms));

        return $next($request);
    }
}
